{% comment %} Variables  {% endcomment %}
{% assign settings = section.settings %}
<style>
    {% comment %}
    Render heading & body font family
{% endcomment %}
{%- if settings.override_font != blank -%}
    {%- capture font_settings_list -%}
        {{ settings.heading_font | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
        {{ settings.body_font | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
    {%- endcapture -%}
    {%- assign font_array = font_settings_list | split: ';;' -%}
{% endif %}
{%- if settings.override_font != blank -%}
    {%- for font in font_array -%}
        {%- unless font contains 'error' -%}
            {{ font }}{%- endunless -%}
    {%- endfor -%}
    #sp-{{ section.id }} {
    --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
    --sp-heading-font-weight: {{ settings.heading_font.weight }};
    --sp-heading-font-style: {{ settings.heading_font.style }};
    --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
    --sp-body-font-weight: {{ settings.body_font.weight }};
    --sp-body-font-style: {{ settings.body_font.style }};
    --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
    --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
    --sp-highlight-font-style: {{ settings.highlight_font.style }};
    }
    {% if custom_selector != blank %}
        {{ custom_selector }} {
        --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
        --sp-heading-font-weight: {{ settings.heading_font.weight }};
        --sp-heading-font-style: {{ settings.heading_font.style }};
        --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
        --sp-body-font-weight: {{ settings.body_font.weight }};
        --sp-body-font-style: {{ settings.body_font.style }};
        --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
        --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
        --sp-highlight-font-style: {{ settings.highlight_font.style }};
        }
    {% endif %}
{% endif %}
    {% comment %}
    Render padding section, heading content max width
{% endcomment %}

    #sp-{{ section.id }} .sp-section {
    {% if settings.section_top_padding_mobile and  settings.section_bottom_padding_mobile %}
        --sp-section-top-padding: {{ settings.section_top_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
    {% else %}
        --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
    {% endif %}
        }

    @media (min-width: 768px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
        }
    }

    @media (min-width: 1260px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | round: 0 }}rem;
        }
    }


    #sp-{{ section.id }} {
        --sp-shop-the-look-image-border-radius: {{ settings.image_border_radius }}px;
        --sp-shop-the-look-image-overlay-color: {{ settings.image_overlay_color | default: null }};
    }

    .sp-modal-{{ section.id }} {
        --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
        --sp-heading-font-weight: {{ settings.heading_font.weight }};
        --sp-heading-font-style: {{ settings.heading_font.style }};
        --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
        --sp-body-font-weight: {{ settings.body_font.weight }};
        --sp-body-font-style: {{ settings.body_font.style }};
    }

    #sp-{{ section.id }} .sp-section {
        --sp-section-background-color: {{ settings.section_background_color | default: "transparent" }};
        --sp-section-background-gradient-color: {{ settings.section_background_gradient_color | default : null }};
        --sp-section-text-color: {{ settings.section_text_color | default:"#1e1e1e" }};
    }

    #sp-{{ section.id }} .sp-heading-wrapper {
        --sp-section-heading-width: 0rem;
        max-width: var(--sp-section-heading-width);
    }

    #sp-{{ section.id }} .sp-shop-the-look-image-inner{
        --sp-shop-the-look-image-border-width: {{ settings.image_border_size }}px;
        --sp-shop-the-look-image-border-color: {{ settings.image_border_color | default:"transparent" }};
        --sp-image-aspect-ratio: {{ settings.image_ratio}};
    }

    .sp-modal-{{ section.id }} .sp-shop-the-look-content {
        --sp-section-background-color: {{ settings.section_background_color | default: "transparent" }};
        --sp-section-background-gradient-color: {{ settings.section_background_gradient_color | default : null }};
    }

    #sp-{{ section.id }} .sp-shop-the-look-item .sp-shop-the-look-image-wrapper .sp-shop-the-look-hotspots .sp-shop-the-look-hotspot-item {
        --sp-shop-the-look-hotspot-color: {{ settings.hotspot_color | default: "#FFF" }}
    }

    #sp-{{ section.id }} .sp-product-card{
--sp-image-aspect-ratio: {{ settings.product_card_image_ratio}};
--sp-card-border-radius: {{ settings.product_card_border_radius }}px;
--sp-product-card-badge-border-radius: {{ settings.product_card_badge_border_radius }}px;
--sp-card-border-width: {{ settings.product_card_border_size }}px;

--sp-card-background-color: {{ settings.product_card_background_color | default: "#FFF" }};
--sp-card-background-gradient-color: {{ settings.product_card_background_gradient_color | default: null }};
--sp-card-shadow-color: {{ settings.product_card_shadow_color | default: "transparent" }};
--sp-card-border-color: {{ settings.product_card_border_color | default: 'none' }};
--sp-card-heading-color: {{ settings.product_card_text_color | default: "#1e1e1e" }};
--sp-product-card-price-color: {{ settings.product_card_price_color | default: "#1e1e1e" }};
}

#sp-{{ section.id }} .sp-product-card .sp-product-card-rating .sp-rating-star {
--sp-product-card-rating-color: {{ settings.product_card_price_rating_color | default: "#1e1e1e" }};
}

#sp-{{ section.id }} .sp-product-card .sp-product-card-badge .sp-badge.sp-badge--on-sale {
--sp-product-card-badge-background-color: {{ settings.product_card_discount_badge_background_color | default: "#FFF" }};
--sp-product-card-badge-text-color: {{ settings.product_card_discount_badge_text_color | default: "#1e1e1e" }};
}

#sp-{{ section.id }} .sp-product-card .sp-product-card-badge .sp-badge.sp-badge--sold-out {
--sp-product-card-badge-background-color: {{ settings.product_card_sold_badge_background_color | default: "#FFF" }};
--sp-product-card-badge-text-color: {{ settings.product_card_sold_badge_text_color | default: "#1e1e1e" }};
}

    .sp-modal-{{ section.id }} .sp-product-card {
        --sp-card-border-radius: {{ settings.product_card_border_radius }}px;
        --sp-product-card-badge-border-radius: {{ settings.product_card_badge_border_radius }}px;
        --sp-card-border-width: {{ settings.product_card_border_size }}px;

        --sp-card-background-color: {{ settings.product_card_background_color | default: "#FFF" }};
        --sp-card-background-gradient-color: {{ settings.product_card_background_gradient_color | default: null }};
        --sp-card-shadow-color: {{ settings.product_card_shadow_color | default: "transparent" }};
        --sp-card-border-color: {{ settings.product_card_border_color | default: 'none' }};
        --sp-card-heading-color: {{ settings.product_card_text_color | default: "#1e1e1e" }};
        --sp-product-card-price-color: {{ settings.product_card_price_color | default: "#1e1e1e" }};
    }

    .sp-modal-{{ section.id }} .sp-product-card .sp-product-card-rating .sp-rating-star{
        --sp-product-card-rating-color: {{ settings.product_card_price_rating_color | default: "#1e1e1e" }};
    }

    .sp-modal-{{ section.id }} .sp-product-card .sp-product-card-badge .sp-badge.sp-badge--on-sale {
        --sp-product-card-badge-background-color: {{ settings.product_card_discount_badge_background_color | default: "#FFF" }};
        --sp-product-card-badge-text-color: {{ settings.product_card_discount_badge_text_color | default: "#1e1e1e" }};
    }

    .sp-modal-{{ section.id }} .sp-product-card .sp-product-card-badge .sp-badge.sp-badge--sold-out {
        --sp-product-card-badge-background-color: {{ settings.product_card_sold_badge_background_color | default: "#FFF" }};
        --sp-product-card-badge-text-color: {{ settings.product_card_sold_badge_text_color | default: "#1e1e1e" }};
    }

    #sp-{{ section.id }} [data-plugin="sp-carousel"],
    .sp-modal-{{ section.id }}[data-plugin="sp-carousel"]{
        --sp-slideshow-pagination-background-color: {{ settings.pagination_background | default: "transparent" }};
        --sp-slideshow-pagination-color: {{ settings.pagination_highlight | default: "transparent" }};
        --sp-slideshow-navigation-background-color: {{ settings.navigation_background | default: "transparent" }};
        --sp-slideshow-navigation-background-gradient-color: {{ settings.navigation_background_gradient | default: null }};
        --sp-slideshow-navigation-background-color: {{ settings.navigation_background | default: "transparent" }};
        --sp-slideshow-navigation-icon-color: {{ settings.navigation_icon | default: "transparent" }};
        --sp-navigation-border-width: {{ settings.navigation_button_border_width }}px;
        --sp-navigation-scale: {{ settings.navigation_button_scale | divided_by: 100.0 }};
        --sp-slideshow-navigarion-boxshadow-color: {{ settings.navigation_background_shadow }};
        --sp-slideshow-navigarion-border-radius: {% if settings.navigation_button_radius == 60 %}50%{% else %}{{ settings.navigation_button_radius }}px{% endif %};
    }

    .sp-modal-{{ section.id }} .sp-button-close {
        color: {{ settings.product_card_text_color | default:"#1e1e1e" }}
    }

</style>
<div id="sp-{{ section.id }}" class="sp-{{ section.id }} sp-section-shop-the-look-1" data-section="shop-the-look-2"
     data-variant="variant-2">
    <div class="sp-section sp-section-overflow" data-border="{{ settings.section_border }}">
        <div class="{% case settings.section_width %}{% when 'boxed' %}sp-container{% when 'full_width' %}sp-container-fluid{% else %}sp-container-fluid sp-container-no-gap{% endcase %}">
            <div class="sp-section-inner" data-lazy="sp-{% if settings.lazy_load %}lazy-section{% endif %}" data-cascade>

                <div class="sp-content-shop-look">
                    {% assign product_card_content_alignment = settings.product_card_content_alignment %}
                    {% assign product_card_style = settings.product_card_style %}
                    {% assign product_card_box_shadow = settings.product_card_box_shadow %}
                    {% assign product_card_show_second_image = settings.product_card_show_second_image %}
                    {% assign product_card_show_vendor = settings.product_card_show_vendor %}
                    {% assign product_card_show_price = settings.product_card_show_price %}
                    {% assign product_card_show_discount_badge = settings.product_card_show_discount_badge %}
                    {% assign product_card_show_sold_out_badge = settings.product_card_show_sold_out_badge %}
                    {% assign product_card_discount_badge_type = settings.product_card_discount_badge_type %}
                    {% assign product_card_show_currency_code = settings.product_card_show_currency_code %}
                    {% assign product_card_show_rating = settings.product_card_show_rating %}
                    {% assign product_card_show_color_swatches = settings.product_card_show_color_swatches %}
                    {% assign product_card_color_swatch_style = settings.product_card_color_swatch_style %}

                    {% assign use_first_variant_product = true %}
                    {% assign show_compare_at_price = true %}

                    {% assign show_tooltip_color_swatch = true %}
                    {% assign max_color_swatches = 5 %}

                    {% assign currency_code_enabled = true %}
                    {% assign placeholder_product = false %}

                    <div class="sp-shop-the-look-item"
                        data-image-position="{{ settings.image_position }}"
                        data-modal-id="sp-modal-shop-the-look-{{ block.id }}"
                        data-section-id="{{ section.id }}"
                        data-box-shadow="{{ settings.box_shadow }}"
                    >
                        <div class="sp-shop-the-look-image-wrapper {{ settings.section_content_size }}">
                            {% assign heading_block = section.blocks | where: 'type', 'shop_the_look_item' %}
                            <div class="sp-shop-the-look-image-inner">
                                {% if settings.shop_the_look_image != null %}
                                    <img class="sp-image" src="{{ settings.shop_the_look_image | image_url: width: 1920 }}" alt="{{ settings.shop_the_look_image.alt | default: "" }}">
                                {% else %}
                                    {{ 'image' | placeholder_svg_tag: "sp-placeholder-image-gray-100" }}
                                {% endif %}
                            </div>
                            <div class="sp-shop-the-look-hotspots">
                            {% for block in heading_block %}
                                {% assign setting = block.settings %}
                                    {% if setting.product != null %}
                                        <div class="sp-shop-the-look-hotspot-item"
                                            onclick="spChangeHotSpot(this)"
                                            data-hotspot-id="sp-shop-the-look-product-item-1-{{ setting.product.id }}-{{ block.id }}"
                                            data-modal-id="sp-modal-shop-the-look-{{ block.id }}"
                                            style="--sp-shop-the-look-hotspot-top: {{ setting.vertical_position }}%; --sp-shop-the-look-hotspot-left: {{ setting.horizontal_position }}%;"
                                        >
                                            <div class="sp-card sp-product-card" data-style="{{ product_card_style | default: "style-1" }}">
                                                <div class="sp-card-inner">
                                                    <div class="sp-card-information sp-product-card-information">
                                                        <h2 class="sp-product-card-heading">
                                                            <a class="sp-link body-font" href="{{ setting.product.url }}">{{ setting.product.title }}</a>
                                                        </h2>
                                                        <div class="sp-product-card-price">
                                                            <span class="price-item price-item--sale price-item--last">
                                                                {{ setting.product.price | money }}
                                                            </span>
                                                        </div>
                                                    </div>
                                                    {% if setting.product.featured_media != null %}
                                                        <div class="sp-card-media sp-product-card-media {% if setting.product.media[1] != null %}has-second-image{% endif %}">
                                                            <a class="sp-link" href="{{ setting.product.url }}">
                                                                <img src="{{- setting.product.featured_media | image_url: width: 550 -}}" sizes="(min-width: 1200px) 1200px, (min-width: 990px) 990px, (min-width: 750px) 750px, 650px)" alt="{{ setting.product.featured_media.alt | escape }}" width="{{ setting.product.featured_media.width }}" height="{{ setting.product.featured_media.height }}">
                                                                {%- if setting.product.media[1] != null -%}
                                                                    <img src="{{ setting.product.media[1] | image_url: width: 1080 }}" sizes="(min-width: 1200px) 1200px, (min-width: 990px) 990px, (min-width: 750px) 750px, 650px)" alt="{{ setting.product.media[1].alt | escape }}" width="{{ setting.product.media[1].width }}" height="{{ setting.product.media[1].height }}" >
                                                                {%- endif -%}
                                                            </a>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="sp-shop-the-look-hotspot-item"
                                            onclick="spChangeHotSpot(this)"
                                            data-hotspot-id="sp-shop-the-look-product-item-1-{{ setting.product.id }}-{{ block.id }}"
                                            data-modal-id="sp-modal-shop-the-look-{{ block.id }}"
                                            style="--sp-shop-the-look-hotspot-top: {{ setting.vertical_position }}%; --sp-shop-the-look-hotspot-left: {{ setting.horizontal_position }}%;"
                                        >
                                            <div class="sp-card sp-product-card" data-style="{{ product_card_style | default: "style-1" }}">
                                                <div class="sp-card-inner">
                                                    <div class="sp-card-information sp-product-card-information">
                                                        <h2 class="sp-product-card-heading">
                                                            <a class="sp-link body-font" href="#">The Product</a>
                                                        </h2>
                                                        <div class="sp-product-card-price">
                                                            <span class="price-item price-item--sale price-item--last">
                                                                {{ 20 | money }}
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="sp-card-media sp-product-card-media {% if setting.product.media[1] != null %}has-second-image{% endif %}">
                                                        <a class="sp-link" href="{{ setting.product.url }}">
                                                            {{ 'image' | placeholder_svg_tag: 'sp-placeholder-image-gray' }}
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>          
                        <div class="sp-shop-the-look-content-wrapper {{ settings.section_content_size }}">
                            <div class="sp-shop-the-look-content" data-alignment="{{ settings.section_content_alignment }}">
                                {% assign heading_block = section.blocks | where: 'type', 'heading_item' %}
                                {% for block in heading_block %}
                                    {% assign setting = block.settings %}
                                    <style>
                                        #sp-{{ section.id }} .sp-shop-the-look-content{
                                            --sp-heading-font: {{ setting.heading_size_desktop }}px;
                                            --sp-heading-text-style: {{ setting.heading_text_style }};
                                            --sp-heading-text-color: {{ settings.section_heading_color }};

                                            --sp-description-text-color: {{ settings.section_text_color }};
                                            --sp-button-border-width: {{ setting.button_border_width }}px;
                                            --sp-button-border-radius: {{ setting.button_radius }}px;
                                            --sp-button-border-color: {{ settings.section_border_color }};
                                            --sp-button-background-color: {{ settings.section_button_background }};
                                        }

                                        @media (max-width: 767px) {
                                            #sp-{{ section.id }} .sp-shop-the-look-content{
                                                --sp-heading-font: {{ setting.heading_size_mobile }}px;
                                            }
                                        }
                                    </style>
                                    <div class="sp-shop-the-look-content-heading heading-font">
                                        {{ setting.heading }}
                                    </div>
                                    <div class="sp-shop-the-look-content-description body-font">
                                        {{ setting.description }}
                                    </div>
                                    <div class="sp-shop-the-look-content-button body-font">
                                        <a href="{{ setting.button_link }}" class="{{ setting.button_style | default: "sp-button-link" }}">
                                            {{ setting.button_text }}
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>                      
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>  
{% schema %}
{
	"name": "🧩 Shop the look 2.2",
	"tag": "section",
	"class": "sp-section-shop-the-look-2",
	"settings": [
		{
			"type": "header",
			"content": "Shop the look setting"
		},
		{
			"type": "image_picker",
			"id": "shop_the_look_image",
			"label": "Image"
		},
		{
			"type": "select",
			"id": "image_position",
			"label": "Image position",
			"options": [
				{
					"label": "Left",
					"value": "left"
				},
				{
					"label": "Right",
					"value": "right"
				}
			],
			"default": "right"
		},
		{
			"type": "select",
			"id": "section_content_alignment",
			"label": "Content alignment",
			"default": "center",
			"options": [
				{
					"label": "Left",
					"value": "left"
				},
				{
					"label": "Center",
					"value": "center"
				},
				{
					"label": "Right",
					"value": "right"
				}
			]
		},
		{
			"type": "select",
			"id": "section_content_size",
			"label": "Content size",
			"default": "",
			"options": [
				{
					"label": "Default",
					"value": ""
				},
				{
					"label": "Small",
					"value": "sp-small"
				},
				{
					"label": "Medium",
					"value": "sp-medium"
				},
				{
					"label": "Large",
					"value": "sp-large"
				},
				{
					"label": "Extra Large",
					"value": "sp-extra-large"
				}
			]
		},
		{
			"type": "range",
			"id": "image_border_radius",
			"min": 0,
			"max": 60,
			"step": 1,
			"unit": "px",
			"label": "Image border radius",
			"default": 0
		},
		{
			"type": "range",
			"id": "image_border_size",
			"min": 0,
			"max": 10,
			"step": 1,
			"unit": "px",
			"label": "Image border size",
			"default": 0
		},
		{
			"type": "range",
			"id": "image_ratio",
			"min": 0.7,
			"max": 1.3,
			"step": 0.1,
			"default": 1,
			"unit": ":1",
			"label": "Image ratio"
		},
		{
			"type": "checkbox",
			"id": "box_shadow",
			"label": "Box shadow",
			"default": false
		},
		{
			"type": "header",
			"content": "Product card"
		},
		{
			"type": "range",
			"id": "product_card_border_radius",
			"min": 0,
			"max": 60,
			"step": 1,
			"unit": "px",
			"label": "Card border radius",
			"default": 8
		},
		{
			"type": "checkbox",
			"id": "product_card_box_shadow",
			"label": "Box shadow",
			"info": "Apply only card style",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "product_card_show_second_image",
			"label": "Show second image on hover",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "product_card_show_price",
			"label": "Show price",
			"default": true
