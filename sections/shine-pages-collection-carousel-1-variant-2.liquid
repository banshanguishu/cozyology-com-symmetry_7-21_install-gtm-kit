      "label": "Heading font size (mobile)",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_text_spacing",
      "min": -10,
      "max": 10,
      "step": 0.2,
      "unit": "px",
      "label": "Heading letter spacing",
