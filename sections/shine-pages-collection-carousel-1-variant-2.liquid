      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "navigation_background_hover_color",
      "label": "Background hover color",
      "default": "#1e1e1e"
    },
    {
      "type": "color",
      "id": "navigation_icon_color",
      "label": "Icon color",
      "default": "#1e1e1e"
    },
    {
      "type": "color",
      "id": "navigation_icon_hover_color",
      "label": "Icon hover color",
