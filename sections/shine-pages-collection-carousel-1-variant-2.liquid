      "default": 0.8
    },
    {
      "type": "select",
      "id": "image_cover_position",
      "label": "Image cover position",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "box_shadow_image",
      "label": "Shadow image",
      "default": true
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_border_size",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "px",
      "label": "Image border size",
