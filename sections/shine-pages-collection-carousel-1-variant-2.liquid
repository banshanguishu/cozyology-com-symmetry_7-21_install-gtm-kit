<script>
  !(function () {
    function t() {
      var e = document.getElementById('sp-{{ section.id }}');
      e &&
        ((e = e.querySelector('.sp-collection-carousel-wrapper')),
        new Swiper(e, {
          effect: 'coverflow',
          centeredSlides: !0,
          navigation: {
            nextEl: e.querySelector('.sp-navigation-button[data-arrow="right"]'),
            prevEl: e.querySelector('.sp-navigation-button[data-arrow="left"]'),
          },
          speed: 600,
          loopAdditionalSlides: 4,
          loopedSlides: 4,
          loop: !0,
          autoplay: 'true' === e.dataset.autoPlay,
          slidesPerView: 'auto',
          coverflowEffect: { rotate: 0, stretch: 0, depth: 200, modifier: 1, slideShadows: !1 },
          initialSlide: 1,
          breakpoints: { 320: { slidesPerView: 1.5 }, 768: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } },
        }));
    }
    window.addEventListener('DOMContentLoaded', (e) => {
      t();
    }),
      Shopify && Shopify?.designMode && t();
  })(document);
</script>
