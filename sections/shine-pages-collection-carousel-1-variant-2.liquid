    {
      "type": "range",
      "id": "button_font_size_mobile",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Button font size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_text_spacing",
      "min": -10,
      "max": 10,
      "step": 0.2,
      "unit": "px",
