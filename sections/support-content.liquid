<style>
    .support-container {
      padding: 80px 300px;
      display: flex;
      flex-direction: column;
      row-gap: 20px;
    }
    .support-container .contact {
      padding: 47px 96px;
      background-color: #f9f5f3;
      display: flex;
      justify-content: space-between;
    }
    .support-container .contact-item {
      display: flex;
      align-items: center;
      column-gap: 20px;
      position: relative;
      cursor: pointer;
    }
    .support-container .contact-divider {
      width: 1px;
      background-color: #bbb3ab;
    }
    .contact .image {
      width: 46px;
      height: 46px;
    }
    .contact-item .text {
      color: #171717 !important;
    }
    .contact-item .text .title {
      font-size: 24px;
      position: relative;
      margin: 0;
    }
    .content-title {
      font-size: 24px;
      color: #171717;
      margin-bottom: 8px;
      font-family: American_bt, Arial, sans-serif;
    }
    .help-image-mobile {
      display: none;
    }
    .content-items {
      display: flex;
      column-gap: 32px;
      row-gap: 30px;
      flex-wrap: wrap;
    }
    .content-item {
      flex: 0 0 calc(25% - 24px);
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: all 0.3s ease;
    }
    .content-item:hover {
      border-bottom: 2px solid #000;
    }

    /* 3. 平板横屏 + 小屏桌面（可选，灵活调整） */
    @media (min-width: 992px) and (max-width: 1300px) {
      /* 平板横屏 + 13寸笔记本小窗口样式 */
      .support-container {
         padding: 40px;
      }
      .support-container .contact {
        padding: 16px 47px !important;
      }
      .support-container .contact-item {
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        row-gap: 8px;
      }
      .contact-item .text .title {
        font-size: 20px;
      }
    }

    @media (min-width: 769px) and (max-width: 991px) {
      /* 平板竖屏样式 */
      .support-container {
         padding: 40px;
      }
      .support-container .contact {
        padding: 16px 47px !important;
      }
      .support-container .contact-item {
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        row-gap: 8px;
      }
      .contact-item .text .title {
        font-size: 20px;
      }
    }

    @media (max-width: 768px) {
      .support-container {
        padding: 28px 12px;
      }
      .contact {
        padding: 24px !important;
        flex-direction: column;
      }
      .support-container .contact-item {
        align-items: center;
        column-gap: 12px;
      }
      .contact-divider {
        width: 100% !important;
        height: 1px !important;
        margin: 16px 0;
      }
      .contact .image {
        width: 26px;
        height: 26px;
      }
      .contact-item .text {
        display: flex;
        align-items: center;
      }
      .contact-item .text .title,
      .contact-item .text .desc {
        font-size: 14px;
      }
      .text-divider {
        width: 1px;
        height: 14px;
        background-color: #bbb3ab;
        margin: 0 8px;
      }
      .content-title {
        font-weight: bold;
        font-size: 18px;
        color: #171717;
      }
      .help-image-mobile {
        display: block;
      }
      .help-image-web {
        display: none;
      }
      .content-items {
          gap: 16px;
      }
      .content-item {
        flex: 0 0 calc(50% - 13px);
      }
    }

</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const message_box_list = document.getElementsByClassName('contact-item message-item')
    if (message_box_list[0]) {
      const message_box = message_box_list[0]
      message_box.addEventListener("click", () => {
        const target_btns = document.getElementsByClassName('bcontact-trigger-button bcontact-trigger-button-has-icon')
        if (target_btns && target_btns.length) {
            Array.from(target_btns).forEach((btn) => {
                btn?.click?.()
            })
        }
      })
    }
  })
</script>

