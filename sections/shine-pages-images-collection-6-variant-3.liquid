{% comment %} Variables  {% endcomment %}
{% assign settings = section.settings %}
<style>
    {% comment %}
    Render heading & body font family
{% endcomment %}
{%- if settings.override_font != blank -%}
    {%- capture font_settings_list -%}
        {{ settings.heading_font | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
        {{ settings.body_font | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
    {%- endcapture -%}
    {%- assign font_array = font_settings_list | split: ';;' -%}
{% endif %}
{%- if settings.override_font != blank -%}
    {%- for font in font_array -%}
        {%- unless font contains 'error' -%}
            {{ font }}{%- endunless -%}
    {%- endfor -%}
    #sp-{{ section.id }} {
    --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
    --sp-heading-font-weight: {{ settings.heading_font.weight }};
    --sp-heading-font-style: {{ settings.heading_font.style }};
    --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
    --sp-body-font-weight: {{ settings.body_font.weight }};
    --sp-body-font-style: {{ settings.body_font.style }};
    --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
    --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
    --sp-highlight-font-style: {{ settings.highlight_font.style }};
    }
    {% if custom_selector != blank %}
        {{ custom_selector }} {
        --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
        --sp-heading-font-weight: {{ settings.heading_font.weight }};
        --sp-heading-font-style: {{ settings.heading_font.style }};
        --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
        --sp-body-font-weight: {{ settings.body_font.weight }};
        --sp-body-font-style: {{ settings.body_font.style }};
        --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
        --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
        --sp-highlight-font-style: {{ settings.highlight_font.style }};
        }
    {% endif %}
{% endif %}
    {% comment %}
    Render padding section, heading content max width
{% endcomment %}

    #sp-{{ section.id }} .sp-section {
    {% if settings.section_top_padding_mobile and  settings.section_bottom_padding_mobile %}
        --sp-section-top-padding: {{ settings.section_top_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
    {% else %}
        --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
    {% endif %}
        }

    @media (min-width: 768px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
        }
    }

    @media (min-width: 1260px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | round: 0 }}rem;
        }
    }

    #sp-{{ section.id }} .sp-section {
        --sp-section-background-color: {{ settings.section_background_color | default: "transparent" }};
        --sp-section-background-gradient-color: {{ settings.section_background_gradient_color | default : null }};
        
        --sp-section-gap-content: {{ settings.section_content_gap }}px;
        
        --sp-section-collection-heading-size: {{ settings.section_heading_font }}px;
        --sp-section-collection-button-size: {{ settings.section_button_font }}px;

        --sp-section-product-heading: {{ settings.section_heading_product_size }}px;
        --sp-section-product-info: {{ settings.section_info_product_size }}px;

        --sp-section-icon-button-size: {{ settings.section_button_icon }}px;

        --sp-gallery-gap-images: {{ settings.section_collection_gap }}px;
        --sp-gallery-border-images: {{ settings.section_collection_radius }}px;

        --sp-color-background-content: {{ settings.content_background_color }};
        --sp-content-background-radius: {{ settings.section_content_radius }}px;
        
        --sp-color-heading-text: {{ settings.heading_color }};
        --sp-color-heading-button-border: {{ settings.button_border }};
        --sp-color-heading-button-text: {{ settings.heading_link }};
        --sp-color-heading-button-background-icon: {{ settings.background_icon }};
        --sp-color-heading-button-icon: {{ settings.fill_icon }};

        --sp-color-product-background: {{ settings.collection_item_background }};
        --sp-color-product-heading: {{ settings.collection_item_heading }};
        --sp-color-product-info: {{ settings.collection_item_info }};
        --sp-color-product-image-border: {{ settings.collection_item_border }};
    }
    
    @media (max-width:768px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-collection-heading-size: {{ settings.section_heading_font_mobile }}px;
            --sp-section-collection-button-size: {{ settings.section_button_font_mobile }}px;

            --sp-section-product-heading: {{ settings.section_heading_product_mobile }}px;
            --sp-section-product-info: {{ settings.section_info_product_mobile }}px;
        }
    }
</style>
<div id="sp-{{ section.id }}" class="sp-{{ section.id }} sp-section-images-collection-6" data-section="images-collection-6" data-variant="variant-3">
    <div class="sp-section">
        <div class="sp-section-content {% case settings.section_width %}{% when 'boxed' %}sp-container{% when 'full_width' %}sp-container-fluid{% else %}sp-container-fluid sp-container-no-gap{% endcase %}">
            <div class="sp-images-collection-items {{ settings.sp_image_position }}" data-lazy="sp-{% if settings.lazy_load %}lazy-section{% endif %}">
                
                {% assign collection_heading = section.blocks | where: 'type', 'collection_heading' %}
                {%  if collection_heading != blank %}
                    <div class="sp-section-heading-collection">
                        {% for block in collection_heading %} 
                            {% assign setting = block.settings %}
                            {% if setting.heading != empty %}
                                <h2 class="sp-image-collection-heading heading-font"> {{ setting.heading }} </h2>
                            {% endif %}

                            {% if setting.heading_button != empty %}
                                <div class="sp-button-link">
                                    <a href="{{ setting.heading_button_url }}" class="heading-font sp-link">
                                        {{ setting.heading_button }}
                                        <div class="sp-icon-button">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13.5 4.5L21 12M21 12L13.5 19.5M21 12L3 12" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </div>
                                    </a>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                {% assign colleciton_item = section.blocks | where: 'type', 'collection_item' %}
                {%  if colleciton_item != blank %}
                    <div class="sp-collection-item-wrapper grid-wrapper">
                        {% for block in colleciton_item %}
                            {% assign setting = block.settings %}
                            {% assign image = setting.collection_image %}
                                
                            <div data-image-hover="{{ settings.image_hover }}" class="sp-product-item {{ setting.collection_style }}">
                                {% if image != nil %}
                                    <div class="sp-background-product">
                                        {{ setting.collection_image | image_url: width: 2040 | image_tag: class: 'sp-image' }}
                                    </div>
                                {% else %}
                                    <div class="sp-background-product background-gray">
                                        {{ 'image' | placeholder_svg_tag: "sp-placeholder-image-gray-100" }}
                                    </div>
                                {% endif %}
                                <div class="sp-content-product">
                                    <div class="sp-heading-product">
                                        {% if setting.product_image != nil %}
                                            <div class="sp-thumbnail">
                                                {{ setting.product_image | image_url: width: 240 | image_tag: class: 'sp-image' }}
                                            </div>
                                        {% else %}
                                            <div class="sp-thumbnail">
                                                {{ 'image' | placeholder_svg_tag: "sp-placeholder-image-gray-100" }}
                                            </div>
                                        {% endif %}
                                        {% if setting.product_heading != nil %}
                                            <div class="sp-heading-text">
                                                <a class="body-font" href="{{ setting.product_link }}">{{ setting.product_heading }}</a>
                                            </div>
                                        {% endif %}
                                    </div>
                                    {% if setting.product_info != nil %}
                                        <div class="sp-info-product">
                                            <div class="sp-info-text">
                                                <span class="body-font">{{ setting.product_info }}</span>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {%  endif %}
            </div>
        </div>
    </div>
</div>  
