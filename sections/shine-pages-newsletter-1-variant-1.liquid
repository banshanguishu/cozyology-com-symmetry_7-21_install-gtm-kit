{% style %}
	#sp-{{section.id}}{--sp-section-background-color: {{settings.section_background_color}};--sp-section-background-gradient-color: {{settings.section_overlay_color}};--sp-section-text-color: {{settings.content_text_color}};--content-max-width: {{settings.content_max_width}}px;--sp-content-background-color: {{settings.content_background_gradient_color}};--sp-content-background-radius: {{settings.content_background_radius}}px;--sp-content-border-width: {{settings.content_border_width}}px;--sp-content-border-color: {{settings.content_border_color}};--sp-content-shadow: {{settings.content_shadow}};--sp-subimage-radius: {{settings.subimage_radius}}px;position:relative}#sp-{{section.id}} .sp-section{background:var(--sp-section-background-color)}#sp-{{section.id}} .sp-overlay{background:var(--sp-section-background-gradient-color)}#sp-{{section.id}} .sp-newsletter-wrapper{position:relative}#sp-{{section.id}} .sp-content-wrapper{width:var(--content-max-width);border-radius:var(--sp-content-background-radius)}#sp-{{section.id}} .sp-content-wrapper.show-background{background:var(--sp-content-background-color)}#sp-{{section.id}} .sp-content-wrapper.show-border{border:var(--sp-content-border-width) solid var(--sp-content-border-color)}#sp-{{section.id}} .sp-content-wrapper.has-box-shadow{box-shadow:0 8px 30px 0 var(--sp-content-shadow)}#sp-{{section.id}} .sp-email-container .sp-subcribe-container .sp-field:has(input:focus) .sp-email-input{padding:calc(var(--sp-button-padding-top)*var(--sp-button-scale) + 5px) 20px calc(var(--sp-button-padding-top)*var(--sp-button-scale) - 5px) 20px}#sp-{{section.id}} .sp-email-container .sp-subcribe-container .sp-email-input{--sp-button-padding-top: 1.4rem;padding:calc(var(--sp-button-padding-top)*var(--sp-button-scale)) 20px;font-family:var(--sp-body-font-family);font-weight:var(--sp-body-font-weight);font-style:var(--sp-body-font-style);font-size:calc(var(--sp-button-font-size)*var(--sp-button-font-scale))}#sp-{{section.id}} .sp-email-container .sp-button-wrapper{--sp-button-background-color: {{settings.button_subscribe_background}};--sp-button-background-gradient-color: {{settings.button_subscribe_background_gradient}};--sp-button-text-color: {{settings.button_subscribe_text}}}#sp-{{section.id}} .sp-newsletter-social .sp-sub-text{color:var(--sp-section-text-color);font-size:14px;font-family:var(--sp-body-font-family)}#sp-{{section.id}} .sp-newsletter-social .sp-sub-text a{color:var(--sp-section-text-color)}#sp-{{section.id}} .sp-newsletter-social .sp-list-social{display:inline-flex;flex-wrap:wrap;column-gap:20px;row-gap:20px}#sp-{{section.id}} .sp-newsletter-social .sp-list-social .sp-social-item{display:inline-flex;transition:all .3s ease-in-out}#sp-{{section.id}} .sp-newsletter-social .sp-list-social .sp-social-item:hover{transform:scale(1.1)}#sp-{{section.id}} .sp-image-icon-wrapper{margin-top:5rem}#sp-{{section.id}} .sp-image-icon-wrapper .sp-image-icon{border-radius:var(--sp-subimage-radius)}#sp-{{section.id}} .sp-button-wrapper{--sp-button-margin-top: 5rem}#sp-{{section.id}} .sp-button-wrapper .sp-button.sp-button-fill{border:none}
