{% comment %} Variables  {% endcomment %}
{% assign settings = section.settings %}
<style>
    {% comment %}
    Render heading & body font family
{% endcomment %}
{%- if settings.override_font != blank -%}
    {%- capture font_settings_list -%}
        {{ settings.heading_font | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
        {{ settings.body_font | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
    {%- endcapture -%}
    {%- assign font_array = font_settings_list | split: ';;' -%}
{% endif %}
{%- if settings.override_font != blank -%}
    {%- for font in font_array -%}
        {%- unless font contains 'error' -%}
            {{ font }}{%- endunless -%}
    {%- endfor -%}
    #sp-{{ section.id }} {
    --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
    --sp-heading-font-weight: {{ settings.heading_font.weight }};
    --sp-heading-font-style: {{ settings.heading_font.style }};
    --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
    --sp-body-font-weight: {{ settings.body_font.weight }};
    --sp-body-font-style: {{ settings.body_font.style }};
    --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
    --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
    --sp-highlight-font-style: {{ settings.highlight_font.style }};
    }
    {% if custom_selector != blank %}
        {{ custom_selector }} {
        --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
        --sp-heading-font-weight: {{ settings.heading_font.weight }};
        --sp-heading-font-style: {{ settings.heading_font.style }};
        --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
        --sp-body-font-weight: {{ settings.body_font.weight }};
        --sp-body-font-style: {{ settings.body_font.style }};
        --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
        --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
        --sp-highlight-font-style: {{ settings.highlight_font.style }};
        }
    {% endif %}
{% endif %}
    {% comment %}
    Render padding section, heading content max width
{% endcomment %}

    #sp-{{ section.id }} .sp-section {
    {% if settings.section_top_padding_mobile and  settings.section_bottom_padding_mobile %}
        --sp-section-top-padding: {{ settings.section_top_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
    {% else %}
        --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
    {% endif %}
        }

    @media (min-width: 768px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
        }
    }

    @media (min-width: 1260px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | round: 0 }}rem;
        }
    }


    #sp-{{ section.id }} {
        --sp-section-background-color: {{ settings.section_background_color }};
        --sp-section-background-gradient-color: {{ settings.section_background_gradient_color | default: "null" }};
        background-color: var(--sp-section-background-color);
        background-image: var(--sp-section-background-gradient-color);
    }

    #sp-{{ section.id }} .sp-images-card-outer {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    #sp-{{ section.id }} .sp-images-card-heading {
        --sp-heading-font-size: {{ settings.heading_size }}px;
        --sp-heading-text-color: {{ settings.section_heading_color }};
        --sp-pagination-color: {{ settings.section_pagination_color }};

        margin-bottom: 50px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    #sp-{{ section.id }} .sp-images-card-heading .sp-heading {
        color: var(--sp-heading-text-color);
        font-size: var(--sp-heading-font-size);
    }

    #sp-{{ section.id }} .sp-pagination-text {
        color: var(--sp-pagination-color);
        font-size: 18px;
    }

    #sp-{{ section.id }} .sp-images-card-wrapper {
        display: none;
        overflow-x: hidden;
    }

    #sp-{{ section.id }} .sp-images-card-wrapper.swiper-initialized {
        display: block;
    }

    #sp-{{ section.id }} .sp-carousel-item {
        --sp-image-ratio: {{ settings.item_ratio }};
        --sp-item-border-radius: {{ settings.border_radius }}px;
        --sp-item-overlay-opacity: {{ settings.image_overlay_opacity }};

        position: relative;
        border-radius: var(--sp-item-border-radius);
        aspect-ratio: var(--sp-image-ratio)/ 1;
        overflow: hidden;
    }

    #sp-{{ section.id }} .sp-carousel-item:after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 9;
        opacity: var(--sp-item-overlay-opacity);
        pointer-events: none;
        transition: all .25s;
    }

    #sp-{{ section.id }} .sp-carousel-item.on-shadow-hover:after {
        opacity: 1;
    }

    #sp-{{ section.id }} .sp-carousel-item img,
    #sp-{{ section.id }} .sp-carousel-item svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: {{ settings.image_cover_position }};
    }

    #sp-{{ section.id }} .sp-images-card-contents {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        margin-top: 50px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 2;
        transition: all .25s ease;
        pointer-events: none;
    }

    #sp-{{ section.id }} .sp-images-card-contents .sp-image-card-content-item {
        --sp-heading-font-size: {{ settings.card_heading_size_desktop }}px;
        --sp-sub-heading-font-size: {{ settings.card_sub_heading_size_desktop }}px;
        --sp-heading-text-color: {{ settings.card_heading_color }};
        --sp-sub-heading-text-color: {{ settings.card_sub_heading_color }};

        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: {{ settings.card_text_gap }}px;
    }


    #sp-{{ section.id }} .sp-images-card-contents .sp-image-card-content-item .sp-heading {
        opacity: 0;
        transform: translateY(15px);
        font-size: var(--sp-heading-font-size);
        color: var(--sp-heading-text-color);
        text-align: center;
        transition: all .25s ease-in-out 0s;
    }

    #sp-{{ section.id }} .sp-images-card-contents .sp-image-card-content-item .sp-sub-heading {
        font-size: var(--sp-sub-heading-font-size);
        color: var(--sp-sub-heading-text-color);
        text-align: center;
        opacity: 0;
        transform: translateY(15px);
        transition: all .35s ease-in-out 0s;
    }

    #sp-{{ section.id }} .sp-images-card-contents .sp-image-card-content-item.active .sp-heading,
    #sp-{{ section.id }} .sp-images-card-contents .sp-image-card-content-item.active .sp-sub-heading {
        opacity: 1;
        transform: translateY(0);
    }

    #sp-{{ section.id }} .sp-images-card-contents .sp-image-card-content-item.active .sp-heading {
        transition-delay: 0.15s
    }

    @media (max-width: 991px) {

        #sp-{{ section.id }} .sp-images-card-heading {
            --sp-heading-font-size: {{ settings.heading_size_mobile }}px;
            margin-bottom: 35px;
        }

        #sp-{{ section.id }} .sp-images-card-wrapper .swiper-wrapper .swiper-slide.swiper-slide-active .sp-carousel-item:after {
            opacity: 0 !important;
        }

        #sp-{{ section.id }} .sp-images-card-wrapper .swiper-wrapper .swiper-slide:not(.swiper-slide-active) .sp-carousel-item:after {
            opacity: 1 !important;
        }

        #sp-{{ section.id }} .sp-images-card-contents {
            margin-top: 30px;
        }

        #sp-{{ section.id }} .sp-images-card-contents .sp-image-card-content-item {
            --sp-heading-font-size: {{ settings.card_heading_size_mobile }}px;
            --sp-sub-heading-font-size: {{ settings.card_sub_heading_size_mobile }}px;
        }

        #sp-{{ section.id }} .sp-images-card-contents {
            position: static;
        }
    }

</style>
<link rel="stylesheet" href="{{ 'sp-swiper-bundle.min.css' | asset_url }}">
<script data-id="swiper-bundle" src="{{ 'sp-swiper-bundle.min.js' | asset_url }}"></script>

<div id="sp-{{ section.id }}" class="sp-{{ section.id }} sp-section-images-card-1"
     data-section="images-card-1"
     data-variant="variant-1" data-lazy="sp-{% if settings.lazy_load %}lazy-section{% endif %}">
    <div class="sp-section sp-section-overflow sp-section-no-heading" data-border="{{ settings.section_border }}">
        <div class="{% case settings.section_width %}{% when 'boxed' %}sp-container{% when 'full_width' %}sp-container-fluid{% else %}sp-container-fluid sp-container-no-gap{% endcase %}">
            {% assign carousel_items = section.blocks | where: 'type', 'card_item' %}
            <div class="sp-images-card-outer">
                {% if settings.section_heading != empty or settings.show_pagination == true %}
                    <div class="sp-images-card-heading">
                        {% if settings.section_heading != empty %}
                            <h2 class="sp-heading heading-font"
                                data-text-style="{{ settings.heading_text_style }}">{{ settings.section_heading }}</h2>
                        {% endif %}
                        {% if settings.show_pagination == true %}
                            <div class="sp-pagination-text body-font"><span
                                        class="current">01</span>
                                / {{ carousel_items.size | prepend: '00' | slice: -2, 2 }}
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
                <div class="sp-images-card-wrapper" data-plugin="swiper" data-gap="{{ settings.item_gap }}"
                     data-gap-mobile="{{ settings.item_gap_mobile }}"
                     data-items="{{ settings.item_per_row_desktop }}"
                     data-items-tablet="{{ settings.item_per_row_tablet }}"
                     data-items-mobile="{{ settings.item_per_row_mobile }}">
                    <div class="swiper-wrapper">
                        {% if carousel_items.size > 0 %}
                            {% for block in carousel_items %}
                                {% assign setting = block.settings %}
                                <div id="sp-{{ block.id }}"
                                     class="swiper-slide" {{ block.shopify_attributes }}>
                                    <div class="sp-carousel-item" data-target="sp-{{ block.id }}-content">
                                    {% if setting.url != blank %}
                                        <a href="{{ setting.url }}" target="_blank">
                                            {% endif %}
                                            {% if setting.image != null %}
                                                {{ setting.image | image_url: width: 1024 | image_tag }}
                                            {% else %}
                                                {{ 'image' | placeholder_svg_tag: 'sp-placeholder-image-gray' }}
                                            {% endif %}
                                            {% if setting.url != blank %}
                                        </a>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            {% for i in (1..5) %}
                                <div id="sp-image-card-{{ i }}"
                                     class="swiper-slide">
                                    <div class="sp-carousel-item" data-target="sp-image-card-{{ i }}-content">
                                        {{ 'image' | placeholder_svg_tag: 'sp-placeholder-image-gray' }}
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
                <div class="sp-images-card-contents">
                    {% if carousel_items.size > 0 %}
                        {% for block in carousel_items %}
                            {% assign setting = block.settings %}
                            {% if setting.heading != empty or setting.sub_heading != empty %}
                                <div id="sp-{{ block.id }}-content" class="sp-image-card-content-item">
                                    {% if setting.sub_heading != empty %}
                                        <h5 class="sp-sub-heading body-font"
                                            data-text-style="{{ settings.card_sub_heading_text_style }}">{{ setting.sub_heading }}</h5>
                                    {% endif %}
                                    {% if setting.heading != empty %}
                                        <h4 class="sp-heading heading-font"
                                            data-text-style="{{ settings.card_heading_text_style }}">{{ setting.heading }}</h4>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        {% for i in (1..5) %}
                            <div id="sp-image-card-{{ i }}-content" class="sp-image-card-content-item">
                                <h5 class="sp-sub-heading body-font"
                                    data-text-style="{{ setting.card_sub_heading_text_style }}">Sub heading</h5>
                                <h4 class="sp-heading heading-font"
                                    data-text-style="{{ setting.card_heading_text_style }}">Heading text example</h4>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
