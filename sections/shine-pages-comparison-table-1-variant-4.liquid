{% comment %} Variables  {% endcomment %}
{% assign settings = section.settings %}
<style>
    {% comment %}
    Render heading & body font family
{% endcomment %}
{%- if settings.override_font != blank -%}
    {%- capture font_settings_list -%}
        {{ settings.heading_font | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
        {{ settings.body_font | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
    {%- endcapture -%}
    {%- assign font_array = font_settings_list | split: ';;' -%}
{% endif %}
{%- if settings.override_font != blank -%}
    {%- for font in font_array -%}
        {%- unless font contains 'error' -%}
            {{ font }}{%- endunless -%}
    {%- endfor -%}
    #sp-{{ section.id }} {
    --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
    --sp-heading-font-weight: {{ settings.heading_font.weight }};
    --sp-heading-font-style: {{ settings.heading_font.style }};
    --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
    --sp-body-font-weight: {{ settings.body_font.weight }};
    --sp-body-font-style: {{ settings.body_font.style }};
    --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
    --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
    --sp-highlight-font-style: {{ settings.highlight_font.style }};
    }
    {% if custom_selector != blank %}
        {{ custom_selector }} {
        --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
        --sp-heading-font-weight: {{ settings.heading_font.weight }};
        --sp-heading-font-style: {{ settings.heading_font.style }};
        --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
        --sp-body-font-weight: {{ settings.body_font.weight }};
        --sp-body-font-style: {{ settings.body_font.style }};
        --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
        --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
        --sp-highlight-font-style: {{ settings.highlight_font.style }};
        }
    {% endif %}
{% endif %}
    {% comment %}
    Render padding section, heading content max width
{% endcomment %}

    #sp-{{ section.id }} .sp-section {
    {% if settings.section_top_padding_mobile and  settings.section_bottom_padding_mobile %}
        --sp-section-top-padding: {{ settings.section_top_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
    {% else %}
        --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
    {% endif %}
        }

    @media (min-width: 768px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
        }
    }

    @media (min-width: 1260px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | round: 0 }}rem;
        }
    }


    #sp-{{ section.id }} .sp-heading-wrapper {
        --sp-section-heading-width: 0rem;
        max-width: var(--sp-section-heading-width);
    }
 
    #sp-{{ section.id }} .sp-section {
        --sp-section-background-color: {{ settings.section_background_color | default: "transparent" }};
        --sp-section-background-gradient-color: {{ settings.section_background_gradient_color | default : null }};
        --sp-section-text-color: {{ settings.section_text_color | default:"#1e1e1e" }};
    }

    #sp-{{ section.id }} .sp-comparison-table {
        --sp-content-max-width: 100%;
        --sp-comparison-item-spacing-scale: 0.55;
        --sp-compatison-font-scale: 0.8;
        --sp-comparison-border-radius: {{ settings.border_radius | default: 0 }}px;
        --sp-comparison-border-width: {{ settings.border_size }}px;
        --sp-comparison-icon-max-width: {{ settings.icon_size | default: 35 }}px;
        --sp-comparison-icon-max-width-mobile: {{ settings.icon_size_mobile | default: 24 }}px;
        --sp-comparison-heading-size: {{ settings.heading_size }}px;
        --sp-comparison-body-size: {{ settings.body_size }}px;

        --sp-comparison-heading-row-color: {{ settings.heading_row_color | default: "tranpsparent" }};
        --sp-comparison-value-row-color: {{ settings.value_row_color | default: "tranpsparent" }};
        --sp-comparison-text-color: {{ settings.content_text_color | default: "transparent" }};
        --sp-comparison-border-color: {{ settings.content_border_color | default: "transparent" }};
        --sp-comparison-highlight-column-color: {{ settings.highlight_column_color | default: "transparent" }};
        --sp-comparison-highlight-column-text-color: {{ settings.text_highlight_column_color | default: "transparent" }};
    }

    @media (min-width: 1200px) {
        #sp-{{ section.id }} .sp-comparison-table {
            --sp-comparison-item-spacing-scale: 1;
            --sp-content-max-width: {{ settings.content_max_width }}%;
            --sp-compatison-font-scale: 1;
        }
    }

</style>
<div id="sp-{{ section.id }}" class="sp-{{ section.id }} sp-section-comparison-table-1"
     data-section="comparison-table-1"
     data-variant="variant-4">
    <div class="sp-section "
         data-border="{{ settings.section_border }}">
        <div class="{% case settings.section_width %}{% when 'boxed' %}sp-container {% when 'full_width' %}sp-container-fluid{% else %}sp-container-fluid sp-container-no-gap{% endcase %}">
            <div class="sp-section-inner" data-lazy="sp-{% if settings.lazy_load %}lazy-section{% endif %}"
                 data-cascade>
                {% assign heading_block = section.blocks | where: 'type', 'heading_item' %}
                {% for block in heading_block %}
                    {% assign setting = block.settings %}
                    <style>
                        {% assign heading_settings = block.settings %}
                        {% assign heading_selector = section.id | prepend:"#sp-" | append:" .sp-heading-wrapper" %}
                        
    {{ heading_selector }} {
        --sp-section-heading-size: {{ heading_settings.heading_size_mobile }}px;
        --sp-section-description-size: {{ heading_settings.description_size_mobile }}px;
        --sp-heading-letter-spacing: {{ heading_settings.text_heading_spacing | default: 0 }}px;
        --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 | times: 0.6 }};

    }
    @media (min-width: 768px) {
        {{ heading_selector }} {
            --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 | times: 0.8 }};
            --sp-section-heading-size: {{ heading_settings.heading_size_desktop | times: 0.8 }}px;
            --sp-section-description-size: max({{ heading_settings.description_size_desktop | times: 0.8 }}px, {{ heading_settings.description_size_mobile }}px);
        }
    }

    @media (min-width: 1200px) {
        {{ heading_selector }} {
            --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 }};
            --sp-section-heading-size: {{ heading_settings.heading_size_desktop }}px;
            --sp-section-description-size: {{ heading_settings.description_size_desktop }}px;
        }
    }

                    </style>
                    <div class="sp-heading-outer {{ setting.heading_position }}" {{ block.shopify_attributes }}>
                        <div class="sp-heading-wrapper"
                             style="--sp-section-heading-width: {{ setting.heading_max_width | divided_by: 10.0 }}rem">
                            {% if setting.sub_heading != blank %}
                                <h5 class="sp-sub-heading {{ setting.sub_heading_size | default: "sp-sub-heading-size-medium" }}">{{ setting.sub_heading }}</h5>
                            {% endif %}
                            {% if setting.heading != blank %}
                                <h2 class="sp-heading">{{ setting.heading }}</h2>
                            {% endif %}
                            {% if setting.description != blank and setting.description != '<p></p>' %}
                                <div class="sp-description">{{ setting.description }}</div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
                <div class="sp-comparison-table-outer">
                    <div class="sp-comparison-table" data-border-style="{{ settings.border_style }}"
                         data-highlight-column="{{ settings.highlighted_column }}"
                         data-content-style="{{ settings.content_style }}"
                         data-content-alignment="{{ settings.content_alignment }}">
                        {% for block in section.blocks %}
                            {% assign setting = block.settings %}
                            {% if block.type == 'heading_row' %}
                                <div class="sp-comparison-table-row sp-table-row-heading">
                                    <div class="sp-table-row-column" data-column="0"></div>
                                    <div class="sp-table-row-column" data-column="1">
                                        <div class="sp-item">
                                            {% if setting.image_1 != null %}
                                                {% if setting.link_1 != null %}<a href="{{ setting.link_1 }}">{% endif %}
                                                <img class="sp-image"
                                                     src="{{ setting.image_1 | image_url: width: 768 }}"
                                                     alt="{{ setting.image_1.alt | default: "" }}">
                                                {% if setting.link_1 != null %}</a>{% endif %}
                                            {% endif %}
                                            {% if setting.text_1 != blank %}
                                                {% if setting.link_1 != null %}<a href="{{ setting.link_1 }}">{% endif %}
                                                <h4 class="sp-title">{{ setting.text_1 }}</h4>
                                                {% if setting.link_1 != null %}</a>{% endif %}
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="sp-table-row-column" data-column="2">
                                        <div class="sp-item">
                                            {% if setting.image_2 != null %}
                                                {% if setting.link_2 != null %}<a href="{{ setting.link_2 }}">{% endif %}
                                                <img class="sp-image"
                                                     src="{{ setting.image_2 | image_url: width: 768 }}"
                                                     alt="{{ setting.image_2.alt | default: "" }}">
                                                {% if setting.link_2 != null %}</a>{% endif %}
                                            {% endif %}
                                            {% if setting.text_2 != blank %}
                                                {% if setting.link_2 != null %}<a href="{{ setting.link_2 }}">{% endif %}
                                                <h4 class="sp-title">{{ setting.text_2 }}</h4>
                                                {% if setting.link_2 != null %}</a>{% endif %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                        {% for block in section.blocks %}
                            {% assign setting = block.settings %}
                            {% if block.type == 'column_row' %}
                                <div class="sp-comparison-table-row sp-table-row-value">
                                    <div class="sp-table-row-column sp-column-heading">
                                        <div class="sp-item">
                                            {% if setting.heading_image != null %}
                                                <img class="sp-image"
                                                     src="{{ setting.heading_image | image_url: width: 768 }}"
                                                     alt="{{ setting.heading_image.alt | default: "" }}">
                                            {% endif %}
                                            {% if setting.heading_text != blank %}
                                                <h4 class="sp-title">{{ setting.heading_text }}</h4>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="sp-table-row-column sp-column-value" data-column="1">
                                        <div class="sp-item">
                                            {% if setting.value_image_1 != null %}
                                                <img class="sp-image"
                                                     src="{{ setting.value_image_1 | image_url: width: 768 }}"
                                                     alt="{{ setting.value_image_1.alt | default: "" }}">
                                            {% endif %}
                                            {% if setting.value_text_1 != blank %}
                                                <h4 class="sp-title">{{ setting.value_text_1 }}</h4>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="sp-table-row-column sp-column-value" data-column="2">
                                        <div class="sp-item">
                                            {% if setting.value_image_2 != null %}
                                                <img class="sp-image"
                                                     src="{{ setting.value_image_2 | image_url: width: 768 }}"
                                                     alt="{{ setting.value_image_2.alt | default: "" }}">
                                            {% endif %}
                                            {% if setting.value_text_2 != blank %}
                                                <h4 class="sp-title">{{ setting.value_text_2 }}</h4>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
{
	"name": "🧩 Comparison table 1.4",
	"tag": "section",
	"class": "sp-comparison-table-1",
	"settings": [
		{
			"type": "header",
			"content": "Comparison settings"
		},
		{
			"type": "range",
			"id": "border_radius",
			"min": 0,
			"max": 60,
			"step": 1,
			"default": 16,
			"unit": "px",
			"label": "Border radius"
		},
		{
			"type": "range",
			"id": "border_size",
			"min": 0,
			"max": 10,
			"step": 1,
			"unit": "px",
			"label": "Border size",
			"default": 1
		},
		{
			"type": "select",
			"id": "border_style",
			"label": "Border style",
			"options": [
				{
					"label": "All Border",
					"value": "all"
				},
				{
					"label": "Inside horizontal",
					"value": "inside"
				}
			],
			"default": "inside"
		},
		{
			"type": "select",
			"id": "highlighted_column",
			"label": "Highlighted column",
			"options": [
				{
					"label": "None",
					"value": ""
				},
				{
					"label": "Column 1",
					"value": "column_1"
				},
				{
					"label": "Column 2",
					"value": "column_2"
				}
			],
			"default": ""
		},
		{
			"type": "select",
			"id": "content_style",
			"label": "Content value style",
			"info": "Applies in case there are both icons and text",
			"options": [
				{
					"label": "Vertical",
					"value": "vertical"
				},
				{
					"label": "Horizontal",
					"value": "horizontal"
				}
			],
			"default": "horizontal"
		},
		{
			"type": "range",
			"id": "heading_size",
			"min": 16,
			"max": 32,
			"step": 1,
			"unit": "px",
			"label": "Heading size",
			"default": 24
		},
		{
			"type": "range",
			"id": "body_size",
			"min": 14,
			"max": 32,
			"step": 1,
			"unit": "px",
			"label": "Body size",
			"default": 16
		},
		{
			"type": "select",
			"id": "content_alignment",
			"label": "Content alignment",
			"options": [
				{
					"label": "Left",
					"value": "left"
				},
				{
					"label": "Center",
					"value": "center"
				},
				{
					"label": "Right",
					"value": "right"
				}
			],
			"default": "left"
		},
		{
			"type": "header",
			"content": "Icon size"
		},
		{
			"type": "range",
			"id": "icon_size",
			"min": 18,
			"max": 64,
			"step": 1,
			"unit": "px",
			"label": "Icon max-width",
			"default": 45
		},
		{
			"type": "range",
			"id": "icon_size_mobile",
			"min": 18,
			"max": 64,
			"step": 1,
			"unit": "px",
			"label": "Icon max-width (Mobile)",
			"default": 24
		},
		{
			"type": "header",
			"content": "Section padding"
		},
		{
			"type": "select",
			"id": "section_width",
			"label": "Content section width",
			"options": [
				{
					"label": "Boxed",
					"value": "boxed"
				},
				{
					"label": "Full width",
					"value": "full_width"
				},
				{
					"label": "Full width no gap",
					"value": "full_width_no_gap"
				}
			],
			"default": "boxed"
		},
		{
			"type": "range",
			"id": "section_top_padding",
			"min": 0,
			"max": 150,
			"step": 10,
			"unit": "px",
			"label": "Top padding",
			"default": 100
		},
		{
			"type": "range",
			"id": "section_bottom_padding",
			"min": 0,
			"max": 150,
			"step": 10,
			"unit": "px",
			"label": "Bottom padding",
			"default": 100
		},
		{
			"type": "checkbox",
			"id": "section_border",
			"label": "Separate section with border",
			"default": false
		},
		{
			"type": "header",
			"content": "Content settings"
		},
		{
			"type": "range",
			"id": "content_max_width",
			"min": 30,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "Content max-width",
			"default": 100
		},
		{
			"type": "header",
			"content": "Effects"
		},
		{
			"type": "checkbox",
			"id": "lazy_load",
			"label": "Lazy load",
			"default": false
		},
		{
			"type": "header",
			"content": "Section color"
		},
		{
			"type": "color",
			"id": "section_background_color",
			"label": "Background",
			"default": "#FFF"
		},
		{
			"type": "color_background",
			"id": "section_background_gradient_color",
			"label": "Background gradient"
		},
		{
			"type": "color",
			"id": "section_text_color",
			"label": "Text",
			"default": "#1e1e1e"
		},
		{
			"type": "header",
			"content": "Comparison color"
		},
		{
			"type": "color",
			"id": "heading_row_color",
			"label": "Heading row background",
			"default": "#A3E9FF"
		},
		{
			"type": "color",
			"id": "value_row_color",
			"label": "Value row background",
			"default": "#FFF6ED"
		},
		{
			"type": "color",
			"id": "content_text_color",
			"label": "Text",
			"default": "#1e1e1e"
		},
		{
			"type": "color",
			"id": "content_border_color",
			"label": "Border",
			"default": "#EAEAEA"
		},
		{
			"type": "color",
			"id": "highlight_column_color",
			"label": "Highlight column",
			"default": "#FCDCFF"
		},
		{
			"type": "color",
			"id": "text_highlight_column_color",
			"label": "Text highlight column",
			"default": "#1e1e1e"
		},
		{
			"type": "header",
			"content": "Typography"
		},
		{
			"type": "checkbox",
			"id": "override_font",
			"label": "Override fonts of the theme",
			"default": true,
			"info": "If you check this option, the fonts of the section will work"
		},
		{
			"type": "font_picker",
			"id": "heading_font",
			"label": "Heading font",
			"default": "futura_n7"
		},
		{
			"type": "font_picker",
			"id": "body_font",
			"label": "Body font",
			"default": "futura_n4"
		}
	],
	"blocks": [
		{
			"name": "Heading",
			"type": "heading_item",
			"limit": 1,
			"settings": [
				{
					"type": "paragraph",
					"content": "This block will always show the priority at the top"
				},
				{
					"type": "header",
					"content": "Section heading"
				},
				{
					"type": "inline_richtext",
					"id": "sub_heading",
					"label": "Subheading",
					"default": "COMPARISON"
				},
				{
					"type": "inline_richtext",
					"id": "heading",
					"label": "Heading",
					"default": "COMPARISON TABLE"
				},
				{
					"type": "richtext",
					"id": "description",
					"label": "Description",
					"default": "<p></p>"
				},
				{
					"type": "select",
					"id": "heading_position",
					"label": "Heading alignment",
					"options": [
						{
							"label": "Left",
							"value": "sp-heading-alignment-left"
						},
						{
							"label": "Center",
							"value": "sp-heading-alignment-center"
						},
						{
							"label": "Right",
							"value": "sp-heading-alignment-right"
						}
					],
					"default": "sp-heading-alignment-center"
				},
				{
					"type": "select",
					"id": "sub_heading_size",
					"label": "Sub heading size",
					"options": [
						{
							"label": "Small",
							"value": "sp-sub-heading-size-small"
						},
						{
							"label": "Medium",
							"value": "sp-sub-heading-size-medium"
						},
						{
							"label": "Large",
							"value": "sp-sub-heading-size-large"
						}
					],
					"default": "sp-sub-heading-size-medium"
				},
				{
					"type": "range",
					"id": "heading_size_desktop",
					"min": 18,
					"max": 86,
					"step": 1,
					"unit": "px",
					"label": "Heading size (Desktop)",
					"default": 48
				},
				{
					"type": "range",
					"id": "heading_size_mobile",
					"min": 18,
					"max": 86,
					"step": 1,
					"unit": "px",
					"label": "Heading size (Mobile)",
					"default": 36
				},
				{
					"type": "range",
					"id": "description_size_desktop",
