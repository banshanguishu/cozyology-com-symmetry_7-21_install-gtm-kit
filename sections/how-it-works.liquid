{% schema %}
{
  "name": "How It Works Tabs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "How It Works"
    },
    {
      "type": "checkbox",
      "id": "image_on_left",
      "label": "左图右字布局",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "Tab Title"
        },
        {
          "type": "image_picker",
          "id": "tab_icon",
          "label": "Tab Icon (Optional)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Content Heading",
          "default": "Content Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Content Subheading",
          "default": "Content Subheading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab Content",
          "default": "<p>Tab content goes here</p>"
        },
        {
          "type": "image_picker",
          "id": "featured_image",
          "label": "Tab Featured Image"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works Tabs",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}

<div id="section-id-{{ section.id }}">
  <div class="how-it-works-section">
    <div class="container">
      <div class="how-it-works-content {% if section.settings.image_on_left %}image-on-left{% endif %}">
        <h2 class="section-title">{{ section.settings.title }}</h2>
        <div class="tabs-container">
          <div class="tabs-navigation">
            {% for block in section.blocks %}
              {% if block.type == 'tab' %}
                <button class="tab-button {% if forloop.first %}active{% endif %}" data-tab="{{ forloop.index }}">
                  <span class="tab-number">{{ forloop.index }}</span>
                  <span class="tab-title">{{ block.settings.tab_title }}</span>
                </button>
              {% endif %}
            {% endfor %}
          </div>

          <div class="tabs-content">
            {% for block in section.blocks %}
              {% if block.type == 'tab' %}
                <div class="tab-content {% if forloop.first %}active{% endif %}" id="tab-{{ forloop.index }}">
                  <div class="tab-content-left">
                    {% if block.settings.tab_icon %}
                      <div class="tab-icon">
                        <img src="{{ block.settings.tab_icon | img_url: '100x' }}" alt="{{ block.settings.tab_title }}">
                      </div>
                    {% endif %}

                    <h3 class="tab-content-heading">{{ block.settings.heading }}</h3>
                    <h4 class="tab-content-subheading">{{ block.settings.subheading }}</h4>

                    <div class="tab-content-text">
                      {{ block.settings.content }}
                    </div>

                    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
                      <a href="{{ block.settings.button_link }}" class="tab-button-link">
                        {{ block.settings.button_text }}
                      </a>
                    {% endif %}
                  </div>
                  <div class="tab-content-right">
                    {% if block.settings.featured_image %}
                      <div class="tab-featured-image">
                        <img
                          src="{{ block.settings.featured_image | img_url: '500x' }}"
                          alt="{{ block.settings.heading }}"
                        >
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
    #section-id-{{ section.id }} {

    .how-it-works-section {
      padding: 60px 0;
      min-height: 605px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .section-title {
      font-size: 34px;
      margin-bottom: 80px;
      text-align: left;
    }

    .how-it-works-content {
      position: relative;
      margin-right: 600px;
    }

    .tabs-navigation {
      display: flex;
      margin-bottom: 60px;
    }

    .tab-button {
      flex: 1;
      background: none;
      border: none;
      padding: 0 20px 20px 0;
      cursor: pointer;
      display: flex;
      transition: opacity 0.3s;
      border-bottom: 1px solid #DDDDDD;
      color: #999999;
      text-align: left;
    }

    .tab-button:hover {
      color: #bcb3ac;
      .tab-number {
        background-color: #bcb3ac;
      }
    }

    .tab-button.active {
      color: #000;
      border-bottom: 1px solid #000;
      .tab-number {
        background-color: #000;
      }
    }

    .tab-number {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      background-color: #BBB3AB;
      color: #fff;
      border-radius: 50%;
      margin-right: 10px;
      font-size: 14px;
    }

    .tab-title {
      flex: 1;
      font-size: 16px;
      font-weight: 500;
    }

    .tabs-content {

    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: flex;
    }

    .tab-content-left {
      flex: 1;
    }

    .tab-content-right {
      position: absolute;
      right: -600px;
      top: 10px;
      bottom: 0;
      width: 500px;
      display: flex;
    }

    .image-on-left {
      margin-left: 600px;
      margin-right: 0;
    }

    .image-on-left .tab-content-right {
      right: auto;
      left: -600px;
    }

    .tab-icon {
      margin-bottom: 20px;
      width: 60px;
      height: 60px;
      img {
        width: 100%;
        height: 100%;
      }
    }

    .tab-content-heading {
      font-size: 32px;
      margin-bottom: 20px;
    }

    .tab-content-subheading {
      font-size: 16px;
      margin-bottom: 34px;
      color: #555;
    }

    .tab-content-text {
      font-size: 16px;
      margin-bottom: 30px;
      color: #999999;
    }

    .tab-featured-image {
      width: 100%;
    }

    .tab-featured-image img {
      max-width: 100%;
      height: auto;
    }

    .tab-button-link {
      display: inline-block;
      background: #232323;
      border-radius: 4px 4px 4px 4px;
      color: #fff;
      padding: 20px 40px;
      text-decoration: none;
      text-transform: uppercase;
      font-weight: 600;
      letter-spacing: 1px;
      transition: background-color 0.3s;
      font-size: var(--button-text-size);
      line-height: 1;
    }

    .tab-button-link:hover {
      background-color: #bcb3ac;
    }

    @media (max-width: 768px) {
      .tabs-navigation {
        border-bottom: none;
        margin-bottom: 30px;
      }

      .tab-button {
        border-bottom: 1px solid #e0e0e0;
      }

      .tab-button.active {
        border-bottom: 1px solid #000;
      }

      .tab-content {
        flex-direction: column;
      }

      .tabs-container {
        margin-right: 0;
      }

      .how-it-works-content {
        margin-right: 0;
      }

      .tab-content-right {
        width: 100%;
        position: relative;
        top: 0;
        margin-top: 20px;
        right: 0;
        left: 0;
      }

      .section-title {
        font-size: 27px;
        margin-bottom: 30px;
      }
      .tab-button {
        flex-direction: column;
        gap: 3px;
        padding-bottom: 12px
      }
      .tab-number {
        width: 15px;
        height: 15px;
        font-size: 8px;
      }
      .tab-title {
        font-size: 12px;
        line-height: 1;
      }
      .tab-icon {
        margin-bottom: 12px;
        width: 30px;
        height: 30px;
      }
      .tab-content-heading {
        font-size: 20px;
        margin-bottom: 10px;
      }
      .tab-content-subheading {
        font-size: 12px;
        margin-bottom: 15px;
      }
      .tab-content-text {
        font-size: 12px;
        margin-bottom: 20px;
      }
      .tab-button-link {
        padding: 16px 36px;
        font-size: 14px;
      }
    }
  }
</style>

<script>
  (function () {
    const section = document.getElementById('section-id-{{ section.id }}');
    const tabButtons = section.querySelectorAll('.tab-button');
    const tabContents = section.querySelectorAll('.tab-content');

    tabButtons.forEach((button) => {
      button.addEventListener('click', function () {
        const tabIndex = this.getAttribute('data-tab');

        tabButtons.forEach((btn) => btn.classList.remove('active'));
        tabContents.forEach((content) => content.classList.remove('active'));

        this.classList.add('active');
        document.getElementById('tab-' + tabIndex).classList.add('active');
      });
    });
  })();
</script>
