{% comment %} Variables  {% endcomment %}
{% assign settings = section.settings %}
<style>
    {% comment %}
    Render heading & body font family
{% endcomment %}
{%- if settings.override_font != blank -%}
    {%- capture font_settings_list -%}
        {{ settings.heading_font | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
        {{ settings.body_font | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
    {%- endcapture -%}
    {%- assign font_array = font_settings_list | split: ';;' -%}
{% endif %}
{%- if settings.override_font != blank -%}
    {%- for font in font_array -%}
        {%- unless font contains 'error' -%}
            {{ font }}{%- endunless -%}
    {%- endfor -%}
    #sp-{{ section.id }} {
    --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
    --sp-heading-font-weight: {{ settings.heading_font.weight }};
    --sp-heading-font-style: {{ settings.heading_font.style }};
    --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
    --sp-body-font-weight: {{ settings.body_font.weight }};
    --sp-body-font-style: {{ settings.body_font.style }};
    --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
    --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
    --sp-highlight-font-style: {{ settings.highlight_font.style }};
    }
    {% if custom_selector != blank %}
        {{ custom_selector }} {
        --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
        --sp-heading-font-weight: {{ settings.heading_font.weight }};
        --sp-heading-font-style: {{ settings.heading_font.style }};
        --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
        --sp-body-font-weight: {{ settings.body_font.weight }};
        --sp-body-font-style: {{ settings.body_font.style }};
        --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
        --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
        --sp-highlight-font-style: {{ settings.highlight_font.style }};
        }
    {% endif %}
{% endif %}
    {% comment %}
    Render padding section, heading content max width
{% endcomment %}

    #sp-{{ section.id }} .sp-section {
    {% if settings.section_top_padding_mobile and  settings.section_bottom_padding_mobile %}
        --sp-section-top-padding: {{ settings.section_top_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
    {% else %}
        --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
    {% endif %}
        }

    @media (min-width: 768px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
        }
    }

    @media (min-width: 1260px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | round: 0 }}rem;
        }
    }


    #sp-{{ section.id }} {
        --sp-background-feature-item-active-color: {{ settings.feature_item_title_background_color }};
        --sp-background-feature-item-hover-color: {{ settings.feature_item_title_background_hover_color }};
        --sp-list-feature-title-color-border: {{ settings.feature_item_border_color }};
        --sp-feature-title-border-radius: {{ settings.feature_title_border_radius }}px;
        --sp-feature-title-border-size: {{ settings.feature_title_border_size }}px;
        --sp-feature-image-ratio: {{ settings.feature_image_ratio }};
        --sp-feature-image-border: {{ settings.feature_image_border }}px;
        --sp-feature-heading-font-size: {{ settings.heading_font_size }}px;
        --sp-feature-sub-heading-font-size: {{ settings.sub_heading_font_size }}px;
        --sp-feature-description-font-size: {{ settings.description_font_size }}px;
        --sp-feature-tab-text-color: {{ settings.feature_item_title_text_color }};
        --sp-feature-tab-text-active-color: {{ settings.feature_item_title_text_active_color }};
        --sp-section-background-gradient-color: {{ settings.section_background_gradient_color | default: null }};
    }

    #sp-{{ section.id }} .sp-section{
        background: {{ settings.section_background_color }} var(--sp-section-background-gradient-color);
    }

    @media (max-width: 767px) {
        #sp-{{ section.id }} {
            --sp-feature-heading-font-size: {{ settings.heading_font_size_mobile }}px;
            --sp-feature-sub-heading-font-size: {{ settings.sub_heading_font_size_mobile }}px;
            --sp-feature-description-font-size: {{ settings.description_font_size_mobile }}px;
        }
    }

</style>
<div id="sp-{{ section.id }}" class="sp-{{ section.id }} sp-section-image-with-text-12" data-section="image-with-text-12" data-variant="variant-1" data-image-position="{{ settings.image_position }}">
    <div class="sp-section-outer">
        <div class="sp-section" data-border="{{ settings.section_border }}">
            <div class="sp-container-fluid sp-container-no-gap">
                <div class="sp-section-inner" data-lazy="sp-{% if settings.lazy_load %}lazy-section{% endif %}" data-cascade>
                    <div class="sp-content-outer" data-content-position="{{ settings.content_position }}" data-item-alignment="{{ settings.item_alignment }}" data-item-alignment-mobile="{{ settings.item_alignment_mobile }}" >
                        <div class="sp-content-inner sp-container">
                            {% assign feature_block = section.blocks | where: 'type', 'feature_item' %}
                            <div class="sp-title-feature-content">
                                <style>
                                    #sp-{{ section.id }} .sp-section .sp-title-feature-content .sp-title-feature-item{
                                        width: calc(100%/{{ feature_block | size }} )
                                    }
                                </style>
                                {% for block in feature_block %}
                                    {% assign setting = block.settings %}
                                    <div class="sp-title-feature-item">
                                        {% if setting.icon_title != nil %}
                                            <div class="sp-feature-icon">
                                                {{ setting.icon_title | image_url: width: 120 | image_tag: class: 'sp-image' }}
                                            </div>
                                        {% endif %}
                                        {% if setting.sub_heading != nil %}
                                            <div class="sp-feature-title body-font">{{ setting.sub_heading }}</div>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="sp-content-feature-items">
                                <div class="sp-carousel-wrapper" data-plugin="sp-carousel"
                                    data-show-navigation-desktop="{{ settings.feature_navigation_hide }}"
                                    data-show-navigation-mobile="false"
                                    data-navigation-box-shadow="{{ settings.navigation_box_shadow }}"
                                    data-navigation-style="{{ settings.navigation_style | default: "fill" }}"
                                >
                                    <div class="sp-carousel sp-carousel-column"
                                        data-column="1"
                                        data-column-mobile="1"
                                        data-column-tablet="1"
                                    >
                                        {% assign slideIndex = 0 %}
                                        {% for block in feature_block %}
                                            {% assign setting = block.settings %}
                                            <div id="sp-{{ block.id }}" class="sp-column sp-carousel-item" data-type="{{ block.type }}"
                                                data-slider-index="{{ slideIndex }}" {{ block.shopify_attributes }}
                                                data-show-background="{{ settings.show_background }}"
                                            >
                                                <div class="feature-item-content">
                                                    <div class="sp-feature-right-content">
                                                        {% if setting.heading != nil %}
                                                            <div class="sp-heading heading-font">{{ setting.heading }}</div>
                                                        {% endif %}
                                                        {% if setting.sub_heading != nil %}
                                                            <div class="sp-sub-heading body-font">{{ setting.sub_heading }}</div>
                                                        {% endif %}
                                                        {% if setting.description != nil %}
                                                            <div class="sp-description body-font">{{ setting.description }}</div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="sp-feature-left-content">
                                                        {% if setting.image != nil %}
                                                            <div class="sp-image-thumb">
                                                                {{ setting.image | image_url: width: 1080 | image_tag: class: 'sp-image' }}
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
