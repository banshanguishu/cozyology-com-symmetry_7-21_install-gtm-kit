{% comment %} Variables  {% endcomment %}
{% assign settings = section.settings %}
<style>
    {% comment %}
    Render heading & body font family
{% endcomment %}
{%- if settings.override_font != blank -%}
    {%- capture font_settings_list -%}
        {{ settings.heading_font | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
        {{ settings.body_font | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
    {%- endcapture -%}
    {%- assign font_array = font_settings_list | split: ';;' -%}
{% endif %}
{%- if settings.override_font != blank -%}
    {%- for font in font_array -%}
        {%- unless font contains 'error' -%}
            {{ font }}{%- endunless -%}
    {%- endfor -%}
    #sp-{{ section.id }} {
    --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
    --sp-heading-font-weight: {{ settings.heading_font.weight }};
    --sp-heading-font-style: {{ settings.heading_font.style }};
    --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
    --sp-body-font-weight: {{ settings.body_font.weight }};
    --sp-body-font-style: {{ settings.body_font.style }};
    --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
    --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
    --sp-highlight-font-style: {{ settings.highlight_font.style }};
    }
    {% if custom_selector != blank %}
        {{ custom_selector }} {
        --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
        --sp-heading-font-weight: {{ settings.heading_font.weight }};
        --sp-heading-font-style: {{ settings.heading_font.style }};
        --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
        --sp-body-font-weight: {{ settings.body_font.weight }};
        --sp-body-font-style: {{ settings.body_font.style }};
        --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
        --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
        --sp-highlight-font-style: {{ settings.highlight_font.style }};
        }
    {% endif %}
{% endif %}
    {% comment %}
    Render padding section, heading content max width
{% endcomment %}

    #sp-{{ section.id }} .sp-section {
    {% if settings.section_top_padding_mobile and  settings.section_bottom_padding_mobile %}
        --sp-section-top-padding: {{ settings.section_top_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
    {% else %}
        --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
    {% endif %}
        }

    @media (min-width: 768px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
        }
    }

    @media (min-width: 1260px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | round: 0 }}rem;
        }
    }


    #sp-{{ section.id }} {
        --sp-section-background-color: {{ settings.section_background_color | default: "transparent" }};
        --sp-section-background-gradient-color: {{ settings.section_background_gradient_color | default: null }};
        --sp-section-text-color: {{ settings.section_text_color | default: "transparent" }};
    }

    #sp-{{ section.id }} .sp-heading-wrapper {
        --sp-section-heading-width: 0rem;
        max-width: var(--sp-section-heading-width);
    }

    #sp-{{ section.id }} [data-plugin="sp-tabs"] {
        --sp-navigarion-gap: 10px;
        --sp-tab-navigarion-text-size-desktop: {{ settings.tab_text_size_desktop }}px;
        --sp-tab-navigarion-text-size-mobile: {{ settings.tab_text_size_mobile }}px;
        --sp-tab-navigation-border-size: {{ settings.border_size }}px;
        --sp-tab-navigation-border-radius: {{ settings.border_radius }}px;
        --sp-tab-navigation-icon-size-desktop: {{ settings.icon_size_desktop }}px;
        --sp-tab-navigation-icon-size-mobile: {{ settings.icon_size_mobile }}px;


        --sp-tab-naviation-text-color: {{ settings.tab_text_color | default:"transparent" }};
        --sp-tab-naviation-background-color: {{ settings.tab_background_color | default:"transparent" }};
        --sp-tab-naviation-border-color: {{ settings.tab_border_color | default:"transparent" }};
        --sp-tab-naviation-text-active-color: {{ settings.tab_text_active_color | default:"transparent" }};
        --sp-tab-naviation-background-active-color: {{ settings.tab_background_active_color | default:"transparent" }};
        --sp-tab-naviation-border-active-color: {{ settings.tab_border_active_color | default:"transparent" }};
    }

    #sp-{{ section.id }} .sp-product-card{
--sp-image-aspect-ratio: {{ settings.product_card_image_ratio}};
--sp-card-border-radius: {{ settings.product_card_border_radius }}px;
--sp-product-card-badge-border-radius: {{ settings.product_card_badge_border_radius }}px;
--sp-card-border-width: {{ settings.product_card_border_size }}px;

--sp-card-background-color: {{ settings.product_card_background_color | default: "#FFF" }};
--sp-card-background-gradient-color: {{ settings.product_card_background_gradient_color | default: null }};
--sp-card-shadow-color: {{ settings.product_card_shadow_color | default: "transparent" }};
--sp-card-border-color: {{ settings.product_card_border_color | default: 'none' }};
--sp-card-heading-color: {{ settings.product_card_text_color | default: "#1e1e1e" }};
--sp-product-card-price-color: {{ settings.product_card_price_color | default: "#1e1e1e" }};
}

#sp-{{ section.id }} .sp-product-card .sp-product-card-rating .sp-rating-star {
--sp-product-card-rating-color: {{ settings.product_card_price_rating_color | default: "#1e1e1e" }};
}

#sp-{{ section.id }} .sp-product-card .sp-product-card-badge .sp-badge.sp-badge--on-sale {
--sp-product-card-badge-background-color: {{ settings.product_card_discount_badge_background_color | default: "#FFF" }};
--sp-product-card-badge-text-color: {{ settings.product_card_discount_badge_text_color | default: "#1e1e1e" }};
}

#sp-{{ section.id }} .sp-product-card .sp-product-card-badge .sp-badge.sp-badge--sold-out {
--sp-product-card-badge-background-color: {{ settings.product_card_sold_badge_background_color | default: "#FFF" }};
--sp-product-card-badge-text-color: {{ settings.product_card_sold_badge_text_color | default: "#1e1e1e" }};
}

    #sp-{{ section.id }} .sp-button-wrapper {
        --sp-button-background-color: {{ settings.button_collection_background_color | default: "transparent" }};
        --sp-button-background-gradient-color: {{ settings.button_collection_background_gradient_color | default: null }};
        --sp-button-text-color: {{ settings.button_collection_text_color | default: "transparent" }};
    }

</style>
<div id="sp-{{ section.id }}" class="sp-{{ section.id }} sp-section-featured-collection-1"
     data-section="featured-collection-1"
     data-variant="variant-1">
    <div class="sp-section-outer">
        <div class="sp-section"
             data-border="{{ settings.section_border }}">
            <div class="{% case settings.section_width %}{% when 'boxed' %}sp-container{% when 'full_width' %}sp-container-fluid{% else %}sp-container-fluid sp-container-no-gap{% endcase %}">
                <div class="sp-section-inner" data-lazy="sp-{% if settings.lazy_load %}lazy-section{% endif %}"
                     data-cascade>
                    {% assign max_products = settings.row_number_desktop | plus: 0 | times: settings.product_per_row_desktop %}
                    {% assign heading_block = section.blocks | where: 'type', 'heading_item' %}
                    {% for block in heading_block %}
                        {% assign setting = block.settings %}
                        <style>
                            {% assign heading_settings = block.settings %}
                            {% assign heading_selector = section.id | prepend:"#sp-" | append:" .sp-heading-wrapper" %}
                            
    {{ heading_selector }} {
        --sp-section-heading-size: {{ heading_settings.heading_size_mobile }}px;
        --sp-section-description-size: {{ heading_settings.description_size_mobile }}px;
        --sp-heading-letter-spacing: {{ heading_settings.text_heading_spacing | default: 0 }}px;
        --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 | times: 0.6 }};

    }
    @media (min-width: 768px) {
        {{ heading_selector }} {
            --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 | times: 0.8 }};
            --sp-section-heading-size: {{ heading_settings.heading_size_desktop | times: 0.8 }}px;
            --sp-section-description-size: max({{ heading_settings.description_size_desktop | times: 0.8 }}px, {{ heading_settings.description_size_mobile }}px);
        }
    }

    @media (min-width: 1200px) {
        {{ heading_selector }} {
            --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 }};
            --sp-section-heading-size: {{ heading_settings.heading_size_desktop }}px;
            --sp-section-description-size: {{ heading_settings.description_size_desktop }}px;
        }
    }

                        </style>
                        <div class="sp-heading-outer {{ setting.heading_position }}" {{ block.shopify_attributes }}>
                            <div class="sp-heading-wrapper"
                                 style="--sp-section-heading-width: {{ setting.heading_max_width | divided_by: 10.0 }}rem">
                                {% if setting.sub_heading != blank %}
                                    <h5 class="sp-sub-heading {{ setting.sub_heading_size | default: "sp-sub-heading-size-medium" }}">{{ setting.sub_heading }}</h5>
                                {% endif %}
                                {% if setting.heading != blank %}
                                    <h2 class="sp-heading">{{ setting.heading }}</h2>
                                {% endif %}
                                {% if setting.description != blank and setting.description != '<p></p>' %}
                                    <div class="sp-description">{{ setting.description }}</div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                    <div class="sp-featured-collection-wrapper">
                        <div class="sp-tabs" data-plugin="sp-tabs" data-lazy="{{ settings.lazy_load }}"
                             data-alignment="{{ settings.tab_position }}"
                             data-alignment-origin="{{ settings.tab_position }}">
                            <ul class="sp-tab-navigation" data-plugin="sp-horizontal-scroll" data-navigation-gap="10">
                                {% for block in section.blocks %}
                                    {% if block.type == 'collection_item' %}
                                        {% assign setting = block.settings %}
                                        <li class="sp-tab-navigation-item" data-horizontal-item
                                            data-tab="{{ forloop.index }}">
                                            <a href="#." class="sp-tab-navigation-item-link"
                                               onclick="SP.initTab(event, {{ forloop.index }})" {{ block.shopify_attributes }}>
                                                {% if setting.tab_icon != null %}
                                                    {{ setting.tab_icon | image_url: width: 64 | image_tag: class: 'sp-icon-tab' }}
                                                {% endif %}
                                                <span class="sp-tab-name">{{ setting.collection_name | default: setting.collection.title }}</span>
                                            </a>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                            <div class="sp-tab-content">
                                {% assign product_card_content_alignment = settings.product_card_content_alignment %}
                                {% assign product_card_style = settings.product_card_style %}
                                {% assign product_card_box_shadow = settings.product_card_box_shadow %}
                                {% assign product_card_show_second_image = settings.product_card_show_second_image %}
                                {% assign product_card_show_vendor = settings.product_card_show_vendor %}
                                {% assign product_card_show_price = settings.product_card_show_price %}
                                {% assign product_card_show_discount_badge = settings.product_card_show_discount_badge %}
                                {% assign product_card_show_sold_out_badge = settings.product_card_show_sold_out_badge %}
                                {% assign product_card_discount_badge_type = settings.product_card_discount_badge_type %}
                                {% assign product_card_show_currency_code = settings.product_card_show_currency_code %}
                                {% assign product_card_show_rating = settings.product_card_show_rating %}
                                {% assign product_card_show_color_swatches = settings.product_card_show_color_swatches %}
                                {% assign product_card_color_swatch_style = settings.product_card_color_swatch_style %}

                                {% assign use_first_variant_product = true %}
                                {% assign show_compare_at_price = true %}

                                {% assign show_tooltip_color_swatch = true %}
                                {% assign max_color_swatches = 5 %}

                                {% assign currency_code_enabled = true %}
                                {% assign placeholder_product = false %}
                                {% for block in section.blocks %}
                                    {% if block.type == 'collection_item' %}
                                        {% assign setting = block.settings %}
                                        <div class="sp-tab-content-item" id="sp-tab-content-item-{{ block.id }}"
                                             data-tab="{{ forloop.index }}" {{ block.shopify_attributes }}>
                                            <div class="sp-product-list sp-column-wrapper"
                                                 data-column="{{ settings.product_per_row_desktop }}"
                                                 data-column-tablet="{{ settings.product_per_row_tablet }}"
                                                 data-column-mobile="{{ settings.product_per_row_mobile }}"
                                                 data-column-size="{{ settings.grid_spacing }}">
                                                {%- for product in setting.collection.products limit: max_products -%}
                                                    <div class="sp-column" data-cascade>
                                                        {% if product and product != empty %}
    {% capture productData %}
        {% assign onSale = false %}
        {% assign inventory = 0 %}
        {
        "id":{{- product.id -}},
        "available":{{- product.available | default: false -}},
        "title":{{- product.title | json -}},
        "handle":{{- product.handle | json -}},
        "url":"{{- product.url -}}",
        "type":{{- product.type | json -}},
        "price":{{- product.price | default: 0 -}},
        "price_max":{{- product.price_max | default: 0 -}},
        "price_min":{{- product.price_min | default: 0 -}},
        "compare_at_price":{{- product.compare_at_price | default: 0 -}},
        "compare_at_price_max": {{- product.compare_at_price_max | default: 0 -}},
        "compare_at_price_min": {{- product.compare_at_price_min | default: 0 -}},
        "price_varies": {{- product.price_varies | default: false -}},
        "compare_at_price_varies": {{- product.compare_at_price_varies | default: false -}},
        "created_at":"{{- product.created_at | date: "%s%L" -}}",
        "published_at":"{{- product.published_at | date: "%s%L" -}}",
        "tags": [{% for tag in product.tags %}{%- unless forloop.first -%},{%- endunless -%}{{- tag | json -}}{% endfor %}],
        "vendor": {{- product.vendor | json -}},
        "featured_image":"{{- product.featured_image -}}",
        "featured_media":"{% if product.featured_media %}{{- product.featured_media | image_url: width: 450 -}}{% endif %}",
        "images":[
        {%- for image in product.images -%}{%- unless forloop.first -%},
        {%- endunless -%}{"id":{{- image.id -}},
            "src":{{- image.src | json -}}}
        {%- endfor -%}],
        "collections":{{- product.collections | map: 'id' | json -}},
        {%- assign selectedVariant = product.selected_or_first_available_variant -%}
        {% assign sale_amount = 0 %}
        {% assign sale_percent = 0 %}
        {% if selectedVariant.price and selectedVariant.compare_at_price %}
            {% assign sale_amount = selectedVariant.compare_at_price | minus: selectedVariant.price %}
            {% if sale_amount > 0 %}
                {% assign divisor = selectedVariant.compare_at_price | times: 1.0 %}
                {% assign sale_percent = selectedVariant.compare_at_price | minus: selectedVariant.price | divided_by: divisor | times: 100.0 | round %}
            {% endif %}
        {% endif %}
        "variant": {
        "id": "{{ selectedVariant.id }}",
        "title": {{- selectedVariant.title | json -}},
        "available": {{- selectedVariant.available | default: false -}},
        "inventory_management": "{{- selectedVariant.inventory_management -}}",
        "inventory_policy": "{{- selectedVariant.inventory_policy -}}",
        "inventory_quantity": {{- selectedVariant.inventory_quantity | default: 0 -}},
        "price": {{- selectedVariant.price | default: 0 -}},
        "compare_at_price": {{- selectedVariant.compare_at_price | default: 0 -}},
        "unit_price": "{{- selectedVariant.unit_price -}}",
        "weight": "{{- selectedVariant.weight -}}",
        "weight_in_unit": "{{- selectedVariant.weight_in_unit -}}",
        "weight_unit": "{{- selectedVariant.weight_unit -}}",
        "sale_amount": {{- sale_amount | money | json -}},
        "sale_percent": {{- sale_percent | json -}}
        },
        "variants":{
        {%- for variant in product.variants -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {% if variant.compare_at_price > variant.price %}
                {% assign onSale = true %}
            {% endif %}
            {% if variant.available and variant.inventory_management != null and variant.inventory_management != '' %}
                {% if variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 %}
                    {% assign inventory = inventory | plus: variant.inventory_quantity %}
                {% elsif variant.inventory_policy == 'continue' %}
                    {% assign inventory = -1 %}
                {% endif %}
            {% elsif variant.available and variant.inventory_management == null %}
                {% assign inventory = -1 %}
            {% endif %}
            {% assign sale_amount = 0 %}
            {% assign sale_percent = 0 %}
            {% if variant.price and variant.compare_at_price %}
                {% assign sale_amount = variant.compare_at_price | minus: variant.price %}
                {% if sale_amount > 0 %}
                    {% assign divisor = variant.compare_at_price | times: 1.0 %}
                    {% assign sale_percent = variant.compare_at_price | minus: variant.price | divided_by: divisor | times: 100.0 | round %}
                {% endif %}
            {% endif %}
            "{{- variant.id -}}": {
            "id":{{- variant.id -}},
            "title":{{- variant.title | json }},
            "name":{{- variant.name | json }},
            "price":{{- variant.price | default: 0 -}},
            "compare_at_price":{{- variant.compare_at_price | default: 0 -}},
            "available":{{- variant.available | default: false -}},
            "sku":{{- variant.sku | json -}},
            "weight":"{{- variant.weight -}}",
            "weight_unit": "{{- variant.weight_unit -}}",
            "inventory_management": "{{- variant.inventory_management -}}",
            "inventory_policy": "{{- variant.inventory_policy -}}",
            "inventory_quantity": {{- variant.inventory_quantity | default: 0 -}},
            "selected": {%- if variant.selected -%}  {{- variant.selected -}} {%- elsif product.selected_or_first_available_variant.id == variant.id -%} true  {%- else -%} false {%- endif -%},
            "sale_amount": {{- sale_amount | money | json -}},
            "sale_percent": {{- sale_percent | json -}}
            }
        {%- endfor -%}
        },
        "on_sale":{{- onSale -}},
        "inventory":{{- inventory -}},
        "options":{{- product.options_with_values | json -}},
        "has_only_default_variant": {{ product.has_only_default_variant | default: false }}
        }
    {% endcapture %}
    <div class="sp-card sp-product-card"
         data-style="{{ product_card_style | default: "style-1" }}"
         data-content-alignment="{{ product_card_content_alignment }}"
         data-box-shadow="{{ product_card_box_shadow }}"
    >
        <div data-app="shine-trust-app" data-product="{{- productData | base64_encode -}}"></div>
        <div class="sp-card-inner">
            <div class="sp-card-media sp-product-card-media {% if product.media[1] != null and product_card_show_second_image %}has-second-image{% endif %}">
                <div class="sp-product-card-badge" data-alignment="vertical">
                    {% if product_card_show_discount_badge and product.compare_at_price > product.price %}
                        {% assign save = product.compare_at_price | minus: product.price | money %}
                        {% if product_card_show_currency_code %}
                            {% assign save = product.compare_at_price | minus: product.price | money_with_currency %}
                        {% endif %}
                        {% if product_card_discount_badge_type == 'percent' %}
                            {% assign save = product.compare_at_price | minus: product.price | times: 1.0 | divided_by: product.compare_at_price | times: 100 | round: 0 | append: "%" %}
                        {% endif %}
                        <span class="sp-badge sp-badge--on-sale">{{ 'shinepages.product.sale_html' | t: price: save }}</span>
                    {% endif %}
                    {% if product_card_show_sold_out_badge and product.available == false %}
                        <span class="sp-badge sp-badge--sold-out">{{ 'shinepages.product.sold_out' | t }}</span>
                    {% endif %}
                </div>
                <a class="sp-link" href="{{ product.url }}">
                    <img srcset="
                  {%- if product.featured_media.width >= 165 -%}{{ product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                  {%- if product.featured_media.width >= 360 -%}{{ product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                  {%- if product.featured_media.width >= 533 -%}{{ product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                  {%- if product.featured_media.width >= 720 -%}{{ product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                  {%- if product.featured_media.width >= 940 -%}{{ product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                  {%- if product.featured_media.width >= 1066 -%}{{ product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                  {{ product.featured_media | image_url }} {{ product.featured_media.width }}w
                "
                         src="{{ product.featured_media | image_url: width: 550 }}"
                         sizes="(min-width: 1200px) 1200px, (min-width: 990px) 990px, (min-width: 750px) 750px, 650px)"
                         alt="{{ product.featured_media.alt | escape }}"
                         width="{{ product.featured_media.width }}"
                         height="{{ product.featured_media.height }}"
                         data-change-variant-image="{{ product.featured_media | image_url: width: 550 }}"
                         data-change-variant-image-set="
                  {%- if product.featured_media.width >= 165 -%}{{ product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                  {%- if product.featured_media.width >= 360 -%}{{ product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                  {%- if product.featured_media.width >= 533 -%}{{ product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                  {%- if product.featured_media.width >= 720 -%}{{ product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                  {%- if product.featured_media.width >= 940 -%}{{ product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                  {%- if product.featured_media.width >= 1066 -%}{{ product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                  {{ product.featured_media | image_url }} {{ product.featured_media.width }}w
                "
                    >
                    {%- if product.media[1] != null and product_card_show_second_image -%}
                        <img
                                srcset="
                    {%- if product.media[1].width >= 165 -%}{{ product.media[1] | image_url: width: 165 }} 165w,{%- endif -%}
