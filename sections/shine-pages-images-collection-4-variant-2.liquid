<script>
!function(){function e(){const i=document.querySelectorAll("#sp-{{ section.id }} .sp-images-collection-item .sp-images-collection-heading-items"),c=document.querySelectorAll("#sp-{{ section.id }} .sp-images-collection-item .sp-collection-background-image");0<i.length&&0<c.length&&(i[0].classList.add("active"),c[0].classList.add("active")),i.forEach((e,t)=>{e.addEventListener("mouseenter",()=>{i.forEach(e=>e.classList.remove("active")),c.forEach(e=>e.classList.remove("active")),e.classList.add("active"),c[t].classList.add("active")})})}window.addEventListener("DOMContentLoaded",function(){e()}),Shopify&&Shopify?.designMode&&e()}(document);
</script>