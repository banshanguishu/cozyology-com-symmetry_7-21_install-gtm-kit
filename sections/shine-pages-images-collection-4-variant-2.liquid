-index:1;pointer-events:none;width:100%;height:100%;left:0;right:0;bottom:0;top:0}#sp-{{section.id}} .sp-section .sp-images-collection-items .sp-images-collection-item .sp-images-collection-background .sp-collection-background-image{position:absolute;width:100%;height:100%;left:0;right:0;bottom:0;top:0}#sp-{{section.id}} .sp-section .sp-images-collection-items .sp-images-collection-item .sp-images-collection-background .sp-collection-background-image .sp-image{display:block;width:100%;height:var(--sp-section-content-height);object-position:center;object-fit:cover;opacity:0;transform:scale(1.1);transition:opacity .5s cubic-bezier(0.215, 0.61, 0.355, 1),transform .5s cubic-bezier(0.215, 0.61, 0.355, 1)}#sp-{{section.id}} .sp-section .sp-images-collection-items .sp-images-collection-item .sp-images-collection-background .sp-collection-background-image.active .sp-image{transform:scale(1);transition:opacity .5s cubic-bezier(0.215, 0.61, 0.355, 1),transform .5s cubic-bezier(0.215, 0.61, 0.355, 1);opacity:1}@media(max-width: 768px){#sp-{{section.id}} .sp-section .sp-content{padding:0 20px}#sp-{{section.id}} .sp-section .sp-content-images-collection .sp-images-collection-item{column-gap:0}#sp-{{section.id}} .sp-section .sp-content-images-collection .sp-images-collection-item .sp-wrapper-title-collection{width:100%}#sp-{{section.id}} .sp-section .sp-content-images-collection .sp-images-collection-item .sp-wrapper-image-collection{display:none}}
