                          fill="currentColor"></path>
                </g>
            </g>
        </svg>
    </button>
    <button class="sp-button-video sp-button-video-unmute">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
             xmlns="http://www.w3.org/2000/svg">
            <g id="volumn-up">
                <g id="Vector">
