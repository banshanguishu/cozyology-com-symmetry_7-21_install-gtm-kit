<div data-section-id="{{ section.id }}" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
{% paginate collection.products by section.settings.coll_num_per_page_int %}
  
{%- liquid
  if section.settings.show_image_behind_heading and collection.image
    assign header_image_enabled = true
  else
    assign header_image_enabled = false
  endif
  assign current_sort = collection.sort_by | default: collection.default_sort_by

  assign show_filters = section.settings.enable_filtering
  if collection.filters == empty
    assign show_filters = false
  endif
-%}

{%- liquid
  assign related_collections_count = 0
  if section.settings.related_collections != empty
    for loop_collection in section.settings.related_collections
      unless loop_collection.handle == collection.handle
        assign related_collections_count = related_collections_count | plus: 1
      endunless
    endfor
  endif
-%}

{%- if related_collections_count > 0 -%}
  {% capture related_collection_html %}
    {% if section.settings.related_collections_style == 'buttons' %}
      <div class="container{% if header_image_enabled %} container--not-mobile{% endif %} lightish-spaced-row-above">
        <related-collection-link-buttons class="related-collection-links related-collection-links--buttons align-center{% if header_image_enabled %} image-overlay__over{% endif %}" data-expander-btn-text="{{ 'sections.collection.view_all_related_collections' | t }}">
          {%- for loop_collection in section.settings.related_collections -%}
            {%- unless loop_collection.handle == collection.handle -%}
              <a class="btn btn--tertiary" href="{{ loop_collection.url }}">{{ loop_collection.title | escape }}</a>
            {%- endunless -%}
          {%- endfor -%}
        </related-collection-link-buttons>
      </div>
    {% else %}
      {% unless section.settings.rel_coll_gall_full_width %}
        <div class="container container--not-mobile lightish-spaced-row-above lightish-spaced-row-above--not-mobile{% if section.settings.rel_coll_grid_mobile == 'hide' %} desktop-only{% endif %}">
      {% endunless %}
      <div class="
        gallery
        gallery--height-adapt
        gallery--grid-desktop-{{ related_collections_count | at_most: 4 }}
        gallery--grid-mobile-{{ section.settings.rel_coll_grid_mobile }}
        {%- if section.settings.rel_coll_grid_mobile != 'hide' -%}
          {%- assign rel_coll_grid_mobile_int = section.settings.rel_coll_grid_mobile | plus: 0 -%}
          {%- if related_collections_count > rel_coll_grid_mobile_int %} gallery--mobile-carousel{% endif %}
        {%- endif -%}
        {%- if section.settings.rel_coll_gall_enable_margin %} gallery--with-margins{% endif %}
        related-collection-links
        related-collection-links--gallery
        {%- if section.settings.rel_coll_gall_full_width %} related-collection-links--is-full-width{% endif %}
        {%- if header_image_enabled %} related-collection-links--under-image-header{% endif %}
        {%- if section.settings.rel_coll_grid_mobile == 'hide' %} desktop-only{% endif %}">
        <carousel-slider class="carousel{% if section.settings.rel_coll_gall_mobile_layout == 'hide' %} desktop-only{% endif %}" inactive>
          <div class="slider slider--no-scrollbar" id="slider-{{ section.id }}">
            <div class="slider__grid">
              {%- for loop_collection in section.settings.related_collections -%}
                {%- unless loop_collection.handle == collection.handle -%}
                  <div class="slider__item
                      gallery__item
                      image-overlay
                      image-overlay--bg-{{ section.settings.rel_coll_gall_overlay_style }}
                      image-overlay--edge-boxes
                      {% unless section.settings.rel_coll_gall_full_width and section.settings.rel_coll_gall_enable_margin == false %}image-overlay--edge-boxes--pad-to-corner{% endunless %}
                      ">
                    <a class="image-overlay__image-link" href="{{ loop_collection.url }}">
                      <div class="image-overlay__image gallery__image img-stretch">
                        {%- liquid
                          if loop_collection.featured_image
                            assign rel_coll_image = loop_collection.featured_image
                          else
                            assign rel_coll_image = false
                          endif
                          assign custom_aspect_ratio = section.settings.rel_coll_gall_aspect_ratio | times: 1.0
                        -%}
                        {%- if rel_coll_image -%}
                          {%- liquid
                            assign desktop_image_cols = section.settings.grid | at_most: section.blocks.size
                          -%}
                          {%- render 'image' with rel_coll_image, custom_aspect_ratio: custom_aspect_ratio, custom_crop: section.settings.image_position, size_cols_mobile: section.settings.rel_coll_grid_mobile, size_cols_desktop: desktop_image_cols -%}
                        {%- else -%}
                          <div class="placeholder-image dark">
                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>
                        {%- endif -%}
                      </div>

                      <div class="text-overlay text-overlay--v-{{ section.settings.rel_coll_gall_text_alignment | split: ' ' | first }} text-overlay--h-{{ section.settings.rel_coll_gall_text_alignment | split: ' ' | last }} image-overlay__over">
                        <div class="text-overlay__inner">
                          <div class="text-overlay__text">
                            <h2 class="text-overlay__title h4">{{ loop_collection.title | escape }}</h2>
                          </div>
                        </div>
                      </div>
                    </a>
                  </div>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="slider-nav slider-nav--floating desktop-only no-js-hidden">
            <button type="button" class="slider-nav__btn has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
              <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
              {%- render 'icon-chevron-left', stroke_width: 1.3 -%}
            </button>
            <button type="button" class="slider-nav__btn has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
              <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
              {%- render 'icon-chevron-right', stroke_width: 1.3 -%}
            </button>
          </div>
        </carousel-slider>
      </div>
      {% unless section.settings.rel_coll_gall_full_width %}
        </div>
      {% endunless %}
    {% endif %}
  {% endcapture %}
{%- endif -%}

{% if header_image_enabled %}
  {%- liquid
    assign show_header = false
    if section.settings.show_title
      assign show_header = true
    endif
    if collection.description != blank and section.settings.coll_desc_pos == 'above'
      assign show_header = true
    endif
    if related_collections_count > 0 and section.settings.related_collections_style == 'buttons'
      assign show_header = true
    endif
  -%}
  {%- if show_header -%}
    <div class="page-header page-header--with-background img-fill image-overlay image-overlay--bg-{{ section.settings.overlay_style }} page-header--padded-{{ section.settings.heading_image_height }}">
      <div class="image-overlay__image">
        {%- render 'image' with collection.image, loading: 'eager', fetchpriority: 'high' -%}
      </div>
      <div class="text-overlay text-overlay--inline text-overlay--v-center text-overlay--h-center image-overlay__over" {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.2s"' -%}>
        <div class="text-overlay__inner">
          <div class="text-overlay__text">
            {%- if section.settings.show_title -%}
              <h1 class="text-overlay__title super-large-text">{{ collection.title | escape }}</h1>
            {%- endif -%}

            {% if collection.description != blank and section.settings.coll_desc_pos == 'above' %}
              <div class="text-overlay__rte rte cf align-center reading-width large-text">{{ collection.description }}</div>
            {% endif %}

            {%- if related_collections_count > 0 and section.settings.related_collections_style == 'buttons' -%}
              {{ related_collection_html }}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
{% else %}
  {{ related_collection_html }}
  {%- liquid
    assign show_header = false
    if section.settings.show_title
      assign show_header = true
    endif
    if collection.description != blank and section.settings.coll_desc_pos == 'above'
      assign show_header = true
    endif
  -%}
  {%- if show_header -%}
    <div class="page-header page-header--with-upper-spacing">
      <div class="container">
        {%- if section.settings.show_title -%}
          <h1 class="pagetitle h3">{{ collection.title | escape }}</h1>
        {%- endif -%}

        {% if collection.description != blank and section.settings.coll_desc_pos == 'above' %}
          <div class="rte cf align-center reading-width">{{ collection.description }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endif %}

  {%- if related_collections_count > 0 and header_image_enabled and section.settings.related_collections_style != 'buttons' -%}
    {{ related_collection_html }}
  {%- endif -%}

  <div class="emily-box container{% if settings.use_fullwidth_layout %} container--no-max{% endif %}{% if show_header == false %} lightly-spaced-row-above{% endif %}">
    <div class="utility-bar" data-ajax-container data-ajax-scroll-to>
      <div class="utility-bar__left">
        {% if section.settings.show_sort or show_filters %}
          <a href="#" class="toggle-btn utility-bar__item{% if section.settings.collapse_tag_sidebar_by_default == false %} toggle-btn--revealed-desktop{% endif %}{% if show_filters == false %} mobile-only{% endif %}" data-toggle-filters>
            <span class="btn-icon">{% render 'icon-filter' %}</span>
            <span>{{ 'products.filtering.filter' | t }}</span>
            {% liquid
              assign filter_count = 0
              for filter in collection.filters
                assign filter_count = filter_count | plus: filter.active_values.size
                if filter.type == 'price_range'
                  if filter.min_value.value != nil or filter.max_value.value != nil
                    assign filter_count = filter_count | plus: 1
                  endif
                endif
              endfor
            %}
            {% if filter_count > 0 %}
              <span class="toggle-btn__count">({{ filter_count }})</span>
            {% endif %}
            <span class="toggle-btn__chevron has-motion has-ltr-icon">{% render 'icon-chevron-right', stroke_width: 1.3 %}</span>
          </a>
        {% endif %}
      </div>

      {% if section.settings.show_total and paginate.items > 0 %}
        <div class="utility-bar__centre">
          <div class="utility-bar__item">{{ 'sections.collection.product_count' | t: count: paginate.items }}</div>
        </div>
      {% endif %} 

      <div class="utility-bar__right">
        {% if section.settings.show_sort %}
          <span class="utility-bar__item desktop-only">
            <link-dropdown class="link-dropdown link-dropdown--right-aligned">
              <div class="visually-hidden" id="sort-dropdown-heading">{{ 'products.sorting.sort_by_label' | t | escape }}</div>
              <button class="link-dropdown__button has-motion" aria-expanded="false" aria-controls="sort-dropdown-options" aria-describedby="sort-dropdown-heading">
                <span class="link-dropdown__button-text">
                  {%- for option in collection.sort_options -%}
                    {%- if current_sort == option.value -%}
                      {{ option.name | escape }}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                </span>
                <span class="link-dropdown__button-icon has-motion">{% render 'icon-chevron-down', stroke_width: 1.3 %}</span>
              </button>
              <div class="link-dropdown__options" id="sort-dropdown-options">
                {%- for option in collection.sort_options -%}
                  {%- liquid
                    if section.settings.sort_show_featured == false and option.value == 'manual' and collection.default_sort_by != 'manual'
                      continue
                    endif
                    if section.settings.sort_show_best == false and option.value == 'best-selling' and collection.default_sort_by != 'best-selling'
                      continue
                    endif
                    if section.settings.sort_show_alpha == false and option.value == 'title-ascending' and collection.default_sort_by != 'title-ascending'
                      continue
                    endif
                    if section.settings.sort_show_alpha == false and option.value == 'title-descending' and collection.default_sort_by != 'title-descending'
                      continue
                    endif
                    if section.settings.sort_show_price == false and option.value == 'price-ascending' and collection.default_sort_by != 'price-ascending'
                      continue
                    endif
                    if section.settings.sort_show_price == false and option.value == 'price-descending' and collection.default_sort_by != 'price-descending'
                      continue
                    endif
                    if section.settings.sort_show_date == false and option.value == 'created-ascending' and collection.default_sort_by != 'created-ascending'
                      continue
                    endif
                    if section.settings.sort_show_date == false and option.value == 'created-descending' and collection.default_sort_by != 'created-descending'
                      continue
                    endif
                  -%}
                  <a href="{{ request.path | sort_by: option.value | escape }}" class="link-dropdown__link{% if current_sort == option.value %} link-dropdown__link--active{% endif %}">{{ option.name | escape }}</a>
                {%- endfor -%}
              </div>
            </link-dropdown>
          </span>
        {% endif %}
        <span class="utility-bar__item mobile-only">
          <div class="layout-switchers">
            <a class="layout-switch layout-switch--two-columns{% if settings.prod_thumb_mob_per_row == '2' %} layout-switch--active{% endif %}" href="#" aria-label="{{ 'sections.collection.grid_layout' | t }}">{%- render 'icon-grid', stroke_width: 1.3 -%}</a>
            <a class="layout-switch layout-switch--one-column{% if settings.prod_thumb_mob_per_row == '1' %} layout-switch--active{% endif %}" href="#" aria-label="{{ 'sections.collection.list_layout' | t }}">{%- render 'icon-box', stroke_width: 1.3 -%}</a>
          </div>
        </span>
      </div>
    </div>

    <!-- 把产品按照类型分组-->
    {%- assign product_types = collection.products | map: 'type' | uniq -%}
    {%- assign cart_variant_ids = cart.items | map: 'variant_id' -%}
    {%- comment -%} mini-cart 过滤用：必须在 paginate 内算，外面 collection.products 被 Shopify 截断到 50 条 {%- endcomment -%}
    {%- assign mini_cart_product_ids = collection.products | map: 'id' -%}

    {%- comment -%} 20 件上限：达到上限后，section 内未加购的产品禁用 Add 按钮（Remove 不受限） {%- endcomment -%}
    {%- assign visible_items_count = 0 -%}
    {%- for item in cart.items -%}
      {%- if mini_cart_product_ids contains item.product_id -%}
        {%- assign visible_items_count = visible_items_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign cart_full = false -%}
    {%- if visible_items_count >= 20 -%}
      {%- assign cart_full = true -%}
    {%- endif -%}
  
    <filter-container class="filter-container filter-container--side{% if section.settings.collapse_tag_sidebar_by_default == false %} filter-container--show-filters-desktop{% endif %}" data-ajax-filtering="{{ settings.ajax_products }}" data-filter-section-id="{{ section.id }}">
      {% if section.settings.show_sort or show_filters %}
        {% render 'faceted-filters', filter_context: collection, clear_url: collection.url, current_sort: current_sort %}
      {% endif %}
  
      <div class="filters-adjacent collection-listing collection-listing-emily" data-ajax-container>
        {% if collection.products.size == 0 %}
          <h5 class="align-centre fully-spaced-row">{{ 'sections.collection.empty' | t }}</h5>
        {% else %}
          <a ></a>
            {% comment %} <img src="{{ 'product_img.webp' |  asset_url  }}" width="100%" height="auto" /> {% endcomment %}
          
            {% assign group_idx = 0 %}
           {% for type in product_types %}
              {% assign group_idx = group_idx | plus: 1 %}
              {%- assign type_products = collection.products | where: 'type', type -%}
              {% comment %} ===== 首组顶部配置图 ===== {% endcomment %}
              {% comment %}在第 6 次迭代后插入图片 {% endcomment %}
              {%- if group_idx == 7 and section.settings.show_first_group_image -%}
                <div class="first-group-banner">
                  <a href="{{ section.settings.first_group_image_link }}">
                    <picture>
                      <source media="(max-width: 767px)"
                              srcset="{{ section.settings.first_group_image_mobile | image_url: width: 768 }}">
                      <img width="100%" height="auto" src="{{ section.settings.first_group_image_pc | image_url: width: 1500 }}"
                          alt="{{ section.settings.first_group_image_pc.alt | escape }}"
                          loading="lazy">
                    </picture>
                  </a>
                </div>
              {%- endif -%}

              <div style="border-bottom:1px solid #ccc;margin:20px 0;padding-bottom:20px">
                <h2 class="text-center" >{{ type }}</h2>
                {% comment %} 
                  至少为每个类型的一个产品设置元字段
                  - 遍历该类型的所有产品
                  - 只要找到第一个有metafield值的产品，就会使用该值
                  
                {% endcomment %}
                {% assign type_intro = '' %}
                {% for p in type_products %}
                  {% if p.metafields.custom.product_attributes != blank %}
                    {% assign type_intro = p.metafields.custom.product_attributes %}
                    {% break %}
                  {% endif %}
                {% endfor %}
          
                <!-- 显示元字段内容 -->
                {% if type_intro != blank %}
                  <section class="text-center">
                    <div class="product-list-intro">
                      {{ type_intro | metafield_tag }}
                    </div>
                  </section>
                {% endif %}              
              </div>
               <!-- 计算当前类型的产品总数 -->
              {% assign type_product_count = type_products.size %}

              <!-- 生成唯一的ID用于JavaScript -->
              {% assign type_id = type | handleize %}

              <div class="product-grid product-grid--per-row-{{ section.settings.grid }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }}" id="product-grid-{{ type_id }}">
                {% for product in type_products %}
                    {% assign prioritised_loading = false %}
                    {% if forloop.index <= section.settings.grid %}
                        {% assign prioritised_loading = true %}
                    {% endif %}

                    {%- assign in_cart = false -%}
                    {%- if cart_variant_ids contains product.variants.first.id -%}
                        {%- assign in_cart = true -%}
                    {%- endif -%}

                    <!-- 前12个产品默认显示，其余隐藏 -->
                    <div class="product-item{% if forloop.index > 12 %} product-item--hidden{% endif %}" data-type="{{ type_id }}">
                        {% render 'custom-product-block', product: product, animate: true, prioritised_loading: prioritised_loading, in_cart: in_cart, cart_full: cart_full %}
                    </div>
                {% endfor %}
              </div>
              
              <!-- 只有当产品数量超过12个时才显示加载更多按钮 -->
              {% if type_product_count > 12 %}
              <div class="load-more-container" id="load-more-{{ type_id }}" style="text-align: center; margin: 20px 0; cursor: pointer;" onclick="loadMoreProducts('{{ type_id }}', {{ type_product_count }})">
                  <img src="{{ 'Load More.svg' |  asset_url  }}" alt="加载更多" width="18px" height="18px" />
                  <div class="load-btn">Load More</div>
              </div>
              {% endif %}

              {% comment %} <div class="product-grid product-grid--per-row-{{ section.settings.grid }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }}">
                {% for product in collection.products %}
                    {% assign prioritised_loading = false %}
                     {% if forloop.index0 < section.settings.grid %}
                       {% assign prioritised_loading = true %}
                      {% endif %}
                      {% if product.type == type %}
                        {% render 'custom-product-block', product: product, animate: true, prioritised_loading: prioritised_loading %}
                      {% endif %}
                    {% endfor %}
              </div> {% endcomment %}

              {% endfor %}
        {% endif %}
      </div>
    </filter-container>



  </div>

  <div class="container pagination-row" data-ajax-container>{% render 'pagination-control', paginate: paginate %}</div>

  {%- render 'mini-cart', section_product_ids: mini_cart_product_ids -%}

  {% endpaginate %}

  {% if collection.description != blank and section.settings.coll_desc_pos == 'below' %}
    <div class="container container--reading-width fully-spaced-row" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
      <div class="rte cf">{{ collection.description }}</div>
    </div>
  {% endif %}
</div>

<script>

  function btnLoading(button){
      button.classList.remove('loading');
      button.disabled = false; // 恢复按钮状态
  }
  
  // 切换按钮在「已加入购物车」状态下的文案 + class
  function setButtonInCart(button, inCart) {
    if (inCart) {
      button.classList.add('add-to-cart-test--in-cart');
      button.textContent = 'Remove';
    } else {
      button.classList.remove('add-to-cart-test--in-cart');
      button.textContent = 'Add to Cart';
    }
  }

  // 拼出 sections 参数：cart-drawer 的实例 id + mini-cart（按文件名）
  function buildSectionsParam() {
    const cartDrawer = document.querySelector('cart-drawer');
    const ids = [];
    if (cartDrawer && cartDrawer.dataset.sectionId) ids.push(cartDrawer.dataset.sectionId);
    ids.push('mini-cart');
    return ids.join(',');
  }

  // mini-cart 折叠态（模块级状态，仅当前页面会话内保留，刷新重置回展开）
  let miniCartCollapsed = false;

  // 用 Section Rendering API 返回的 HTML 替换 mini-cart 的整段 DOM
  function updateMiniCart(html) {
    const oldEl = document.querySelector('[data-mini-cart]');
    if (!oldEl) return;
    const tpl = document.createElement('template');
    tpl.innerHTML = html.trim();
    const newEl = tpl.content.querySelector('[data-mini-cart]');
    if (!newEl) return;
    oldEl.replaceWith(newEl);
    // 替换后 DOM 回到 Liquid 的默认（展开），把记住的折叠态再 apply 一次
    applyMiniCartState();
  }

  // 把购物车变更接口返回的 sections 全部应用到页面
  function applyCartChangeSections(data) {
    if (!data || !data.sections) return;
    const cartDrawer = document.querySelector('cart-drawer');
    if (cartDrawer && data.sections[cartDrawer.dataset.sectionId]) {
      cartDrawer.updateFromCartChange(data.sections[cartDrawer.dataset.sectionId]);
    }
    if (data.sections['mini-cart']) {
      updateMiniCart(data.sections['mini-cart']);
    }
  }

  // 用 Section Rendering API 单独拉 mini-cart 的最新 HTML（响应外部购物车变化，比如抽屉里删商品）
  // 我们自己派发的 on:cart:change 带 source 标记，会被跳过 —— applyCartChangeSections 已经从 POST 响应里同步更新过 mini-cart 了
  async function refreshMiniCartFromServer(event) {
    if (event && event.detail && event.detail.source === 'mini-cart-internal') {
      return;
    }
    try {
      const url = `${window.location.pathname}?sections=mini-cart`;
      const res = await fetch(url);
      if (!res.ok) return;
      const data = await res.json();
      if (data['mini-cart']) {
        updateMiniCart(data['mini-cart']);
      }
    } catch (err) {
      console.error('Error refreshing mini-cart from server:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelector('.collection-listing-emily').addEventListener('click', function (event) {
      if (!event.target.classList.contains('add-to-cart-test')) return;
      if (isCartFlying) return; // 防御：上一个 cart 写请求还在飞，不接受新点击

      const button = event.target;
      const variantId = button.getAttribute('data-product-id');
      if (!variantId) {
        console.error('未找到产品 ID');
        return;
      }
      isCartFlying = true;
      button.classList.add('loading');
      button.disabled = true;
      refreshAddBtnDisabled(); // 立刻锁住其它未加购的 Add 按钮

      if (button.classList.contains('add-to-cart-test--in-cart')) {
        removeFromCart(variantId, button);
      } else {
        addToCart(variantId, button);
      }
    });

    // 监听外部购物车变更（如用户在抽屉里手动删除商品），同步本页面所有按钮态
    document.addEventListener('on:cart:change', syncButtonsWithCart);
    // 同样的事件触发 mini-cart 也拉一次最新 HTML（自己 ADD/REMOVE 会冗余一次，可接受）
    document.addEventListener('on:cart:change', refreshMiniCartFromServer);

    // mini-cart 的交互（委托到 document，因为 DOM 会被 section refresh 整段替换）
    document.addEventListener('click', handleMiniCartClick);
  });

  // 加购：用主题原生路径 + Section Rendering API，一次请求拿到抽屉 + mini-cart 的最新 HTML
  async function addToCart(variantId, button) {
    const formData = new FormData();
    formData.append('items[][id]', variantId);
    formData.append('items[][quantity]', 1);
    formData.append('sections_url', window.location.pathname);
    formData.append('sections', buildSectionsParam());

    try {
      const res = await fetch(theme.routes.cartAdd, {
        method: 'POST',
        headers: {
          Accept: 'application/javascript',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: formData
      });
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.description || data.message || 'Add to cart failed');
      }

      applyCartChangeSections(data);
      setButtonInCart(button, true);

      // 派发主题事件，让 header 计数等其它组件自动同步
      document.dispatchEvent(new CustomEvent('on:cart:change', {
        bubbles: true,
        cancelable: false,
        detail: { source: 'mini-cart-internal' }
      }));
    } catch (err) {
      console.error('Error adding product to cart:', err);
    } finally {
      btnLoading(button);
      isCartFlying = false;
      refreshAddBtnDisabled();
    }
  }

  // 移除：用 /cart/change.js + quantity:0 把整个 line 删掉
  async function removeFromCart(variantId, button) {
    const formData = new FormData();
    formData.append('id', variantId);
    formData.append('quantity', 0);
    formData.append('sections_url', window.location.pathname);
    formData.append('sections', buildSectionsParam());

    try {
      const res = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          Accept: 'application/javascript',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: formData
      });
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.description || data.message || 'Remove from cart failed');
      }

      applyCartChangeSections(data);
      setButtonInCart(button, false);

      document.dispatchEvent(new CustomEvent('on:cart:change', {
        bubbles: true,
        cancelable: false,
        detail: { source: 'mini-cart-internal' }
      }));
    } catch (err) {
      console.error('Error removing product from cart:', err);
    } finally {
      btnLoading(button);
      isCartFlying = false;
      refreshAddBtnDisabled();
    }
  }

  // mini-cart ⊖ 移除：和 removeFromCart 类似，但触发源是 mini-cart 自身的 ⊖ 按钮（会被 section 刷新替换掉），
  // 不需要 setButtonInCart——产品列表中的 Add/Remove 按钮通过 on:cart:change → syncButtonsWithCart 同步。
  async function removeFromMiniCart(variantId) {
    const formData = new FormData();
    formData.append('id', variantId);
    formData.append('quantity', 0);
    formData.append('sections_url', window.location.pathname);
    formData.append('sections', buildSectionsParam());

    try {
      const res = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          Accept: 'application/javascript',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: formData
      });
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.description || data.message || 'Remove from cart failed');
      }

      applyCartChangeSections(data);

      document.dispatchEvent(new CustomEvent('on:cart:change', {
        bubbles: true,
        cancelable: false,
        detail: { source: 'mini-cart-internal' }
      }));
    } catch (err) {
      console.error('Error removing product from mini-cart:', err);
    } finally {
      isCartFlying = false;
      refreshAddBtnDisabled();
    }
  }

  // mini-cart 的所有交互（×收起 / <展开 / ⊖移除 / Cart 打开抽屉 / </> 滚动）
  // 用 document 委托，因为 mini-cart 的 DOM 会被 section 刷新整段替换
  function handleMiniCartClick(event) {
    const target = event.target;

    if (target.closest('[data-mini-cart-collapse]')) {
      toggleMiniCart(true);
      return;
    }
    if (target.closest('[data-mini-cart-expand]')) {
      toggleMiniCart(false);
      return;
    }
    if (target.closest('[data-mini-cart-open-drawer]')) {
      document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:open', {
        bubbles: true,
        cancelable: false
      }));
      return;
    }
    if (target.closest('[data-mini-cart-prev]')) {
      scrollMiniCartList(-72);
      return;
    }
    if (target.closest('[data-mini-cart-next]')) {
      scrollMiniCartList(72);
      return;
    }
    const removeBtn = target.closest('[data-mini-cart-remove]');
    if (removeBtn) {
      if (isCartFlying) return;
      const item = removeBtn.closest('[data-mini-cart-item]');
      if (!item) return;
      const variantId = item.getAttribute('data-variant-id');
      if (!variantId) return;
      isCartFlying = true;
      removeBtn.classList.add('loading');
      removeBtn.disabled = true;
      refreshAddBtnDisabled();
      removeFromMiniCart(variantId);
      return;
    }
  }

  function toggleMiniCart(collapsed) {
    miniCartCollapsed = collapsed;
    applyMiniCartState();
  }

  // 把当前 miniCartCollapsed 落到 DOM 的 hidden 属性上
  function applyMiniCartState() {
    const collapsed = miniCartCollapsed;
    const expanded = document.querySelector('[data-mini-cart-expanded]');
    const collapsedEl = document.querySelector('[data-mini-cart-collapsed]');
    if (expanded) expanded.hidden = collapsed;
    if (collapsedEl) collapsedEl.hidden = !collapsed;

    // cart-action 也有两套内容（展开 logo+Cart / 收起 计数+首个色卡）
    const cartExpanded = document.querySelector('[data-mini-cart-cart-expanded]');
    const cartCollapsed = document.querySelector('[data-mini-cart-cart-collapsed]');
    if (cartExpanded) cartExpanded.hidden = collapsed;
    if (cartCollapsed) cartCollapsed.hidden = !collapsed;
  }

  function scrollMiniCartList(delta) {
    const list = document.querySelector('[data-mini-cart-list]');
    if (list) list.scrollBy({ left: delta, behavior: 'smooth' });
  }

  // 切换 Add 按钮的「上限禁用」态（class + disabled 属性，Remove 按钮不受影响）
  function setAddBtnDisabled(button, disabled) {
    if (disabled) {
      button.classList.add('add-to-cart-test--disabled');
      button.disabled = true;
    } else {
      button.classList.remove('add-to-cart-test--disabled');
      button.disabled = false;
    }
  }

  // in-flight 锁：同一时刻只允许 1 个 cart 写请求飞行（防 race + 防 Shopify 429）
  let isCartFlying = false;

  // 统一刷新所有 .add-to-cart-test 按钮的 disable 态。
  // 规则：(isCartFlying || cartFull) && !inCart。loading 中的按钮自己管自己，跳过。
  // cartFull 直接从 DOM 数（有 --in-cart class 的按钮 >= 20），不再单独维护变量。
  function refreshAddBtnDisabled() {
    const cartFull = document.querySelectorAll('.add-to-cart-test--in-cart').length >= 20;
    document.querySelectorAll('.add-to-cart-test').forEach(btn => {
      if (btn.classList.contains('loading')) return;
      const inCart = btn.classList.contains('add-to-cart-test--in-cart');
      setAddBtnDisabled(btn, (isCartFlying || cartFull) && !inCart);
    });
  }

  // 拉一次最新购物车 JSON，把页面上所有 .add-to-cart-test 按钮 in-cart 态对齐
  // disable 态由 refreshAddBtnDisabled 统一管理（flying + cartFull 两个维度）
  async function syncButtonsWithCart() {
    try {
      const res = await fetch('/cart.js');
      const cart = await res.json();
      const variantIds = new Set(cart.items.map(item => item.variant_id));

      document.querySelectorAll('.add-to-cart-test').forEach(btn => {
        const id = parseInt(btn.getAttribute('data-product-id'), 10);
        setButtonInCart(btn, variantIds.has(id));
      });
      refreshAddBtnDisabled();
    } catch (err) {
      console.error('Error syncing buttons with cart:', err);
    }
  }
  //加载更多功能
  function loadMoreProducts(typeId, totalCount) {
      // 获取当前类型的所有隐藏产品
      const hiddenProducts = document.querySelectorAll(`[data-type="${typeId}"].product-item--hidden`);
      const loadMoreBtn = document.getElementById(`load-more-${typeId}`);

      // 每次显示12个产品
      const showCount = Math.min(12, hiddenProducts.length);

      for (let i = 0; i < showCount; i++) {
          hiddenProducts[i].classList.remove('product-item--hidden');
      }

      // 如果没有更多隐藏的产品，隐藏加载更多按钮
      if (hiddenProducts.length - showCount === 0) {
          loadMoreBtn.style.display = 'none';
      }
  }

</script>




