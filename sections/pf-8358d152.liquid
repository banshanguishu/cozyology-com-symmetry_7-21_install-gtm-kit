    </script><script src="https://cdn.pagefly.io/pagefly/4.12.9/core/helper.js" async></script><script>// 步骤条点击事件
document.addEventListener('DOMContentLoaded', function () {
  let buttonDis = document.querySelectorAll('.disable-btn');
  buttonDis.forEach((btn, i) => {
    btn.addEventListener('click', (event) => {
      event.preventDefault()
    })
  })

  let userDataObj = {} //保存用户填入的数据
  let curentIndex = 0 //记录当前展示的模块
  // 所有块
  let allContent = document.querySelectorAll('.stepOne');
  let contentList = [{
    curName: 'stepOne-one',
    nextName: 'stepOne-two',
    btnName: 'choose-btn-one',
    contentName: 'choose-content',
    type: 'choose',
    list: ['SOFT TOP', 'PLEATED', 'GROMMETS'],
  },
  {
    curName: 'stepOne-two',
    nextName: 'stepOne-three',
    btnName: 'rod-Installed',
    contentName: 'rod-Installed-content',
    type: 'choose',
    list: ['yes', 'no'],
  },
  {
    curName: 'stepOne-three',
    nextName: 'stepOne-four',
    btnName: 'window-width',
    type: 'input',
  },
  {
    curName: 'stepOne-four',
    nextName: 'stepOne-five',
    btnName: 'rod-extension'
  },
  {
    curName: 'stepOne-five',
    nextName: 'stepOne-six',
    btnName: 'window-top-to-floor'
  },
  {
    curName: 'stepOne-six',
    nextName: 'stepOne-seven',
    btnName: 'rod-extension-above'
  },
  {
    curName: 'stepOne-seven',
    nextName: 'stepOne-eight',
    btnName: 'rod-length'
  },
  {
    curName: 'stepOne-eight',
    nextName: 'stepOne-nine',
    btnName: 'drapery-height'
  },
  {
    curName: 'stepOne-nine',
    nextName: 'stepOne-ten',
    btnName: 'drapery-height-two'
  },
  {
    curName: 'stepOne-ten',
    nextName: 'stepOne-eleven',
    btnName: 'curtain',
    contentName: 'curtain-content',
    type: 'choose',
    list: ['1/2 ABOVE FLOOR', 'BREAK ON THE FLOOR', 'SLIGHT PUDDLE ON FLOOR'],
  },
  {
    curName: 'stepOne-eleven',
    nextName: 'stepOne-twelve',
    btnName: 'curtain-fullenss',
    contentName: 'curtain-fullenss-content',
    type: 'choose',
    list: ['2', '1.5', '1'],
  },
  {
    curName: 'stepOne-eleven-two',
    nextName: 'stepOne-twelve',
    contentName: 'curtain-fullenss-two-content',
    btnName: 'curtain-fullenss-two',
    type: 'choose',
    list: ['2', '1.5'],
  },
  {
    curName: 'stepOne-twelve',
    nextName: 'stepOne-thirteen',
    btnName: 'single-split',
    contentName: 'single-split-content',
    type: 'choose',
    list: ['Single Panel', 'Split Panels']
  },
    // {
    //   curName: 'stepOne-thirteen',
    //   nextName: 'stepOne-thirteen',
    //   btnName: 'stepOne-thirteen'
    // }
  ]
  // 传入展示和隐藏的内容
  function setContentShow(showCon, hiddenCon, index) {
    hiddenCon.forEach(function (s) {
      s.style.display = 'none'
    });
    showCon.forEach(function (s) {
      // if (index >= 1) {
      //   s.style.display = 'flex'
      // } else {
      s.style.display = 'flex'
      s.style.justifyContent = 'center'
      // }
    });
  }
  // 所有步骤条
  const steps = document.querySelectorAll('.time-line .step');
  let currentStep = 0;
  // 比如当前填写到第1步
  let infoStep = 0

  function updateCurrentStep(index) {
    currentStep = index
    steps.forEach((step, i) => {
      step.classList.remove('active');
      step.classList.remove('active-current');
      if (i === index) {
        step.classList.add('active-current');
      }
      if (i <= infoStep) {
        step.classList.add('active');
      }

    });
  }

  // 步骤条点击事件
  steps.forEach((step, i) => {
    step.addEventListener('click', (event) => {
      if (i <= infoStep && i <= steps.length) {
        updateCurrentStep(i);
        // 更新展示的内容
        curentIndex = i
        let showConObj = contentList[i]
        // let showCon = document.querySelectorAll('.' + showConObj.curName);
        if (i === 2) {
          // 判断第一步选择的PLEATED还是其他
          if (userDataObj['stepOne-one'] === "PLEATED") {
            curentIndex = 7
            showConObj = contentList[curentIndex]
          } else {
            curentIndex = 8
            showConObj = contentList[curentIndex]
          }
        } else if (i === 3) {
          curentIndex = 10
          if (userDataObj['stepOne-one'] === "PLEATED") {
            curentIndex = 12
          } else if (userDataObj['stepOne-one'] === 'GROMMETS') {
            curentIndex = 11
          }
          showConObj = contentList[curentIndex]
        }
        showCon = document.querySelectorAll('.' + showConObj.curName);
        setContentShow(showCon, allContent, curentIndex)
      }
    });
  });
  // 初始化步骤条
  updateCurrentStep(currentStep)



  // 参数第几部，第几个按钮
  function saveData(stepItem, stepIndex, btnIndex) {
    let val = ''
    if (stepItem.curName === 'stepOne-thirteen') return

    if (stepItem.type === 'choose') {
      val = stepItem.list[btnIndex]
    } else {
      if (stepItem.btnName === 'rod-extension') {
        let val1 = document.querySelector('.' + stepItem.btnName + '-input-a').value
        let val2 = document.querySelector('.' + stepItem.btnName + '-input-b').value
        val = val1 + ',' + val2
      } else {
        val = document.querySelector('.' + stepItem.btnName + '-input').value
      }
    }
    userDataObj[stepItem.curName] = val
  }

  // 内容切换 
  contentList.forEach((val, index) => {
    if (val.type === 'choose') {
      // 内容可点击
      var contentName = document.querySelectorAll('.' + val.contentName);
      contentName.forEach((btn, i) => {
        btn.addEventListener('click', function (event) {
          exchangeContent(val, index, i)
        })
      })
    }
    // continue按钮
    var continueBtn = document.querySelectorAll('.' + val.btnName);
    continueBtn.forEach((btn, i) => {
      btn.addEventListener('click', function (event) {
        exchangeContent(val, index, i)
      });
    })

  })
  function exchangeContent(val, index, i) {
    // 当前内容
    var currentContent = document.querySelectorAll('.' + val.curName);
    // 下一步内容
    var nextName = document.querySelectorAll('.' + val.nextName);
    // 保存数据
    saveData(val, index, i)
    console.log(userDataObj);
    curentIndex = index + 1
    // 切换步骤条
    if (curentIndex <= 6) {
      infoStep = 1
    } else if (index <= 9) {
      infoStep = 2
    } else if (index > 9) {
      infoStep = 3
    }
    updateCurrentStep(infoStep)
    // 切换步骤条End

    // 判断下一步展示什么内容
    if (index === 0) {
      if (userDataObj['stepOne-one'] === "PLEATED") {
        let title = document.querySelector('.rod-extension-title-one')
        title.style.display = 'flex'
        title.style.justifyContent = 'center'
      }
    } else if (index === 1) {
      let nextObj = {}
      if (i === 0) {
        nextObj = contentList[6]
      } else {
        nextObj = contentList[2]
      }
      nextName = document.querySelectorAll('.' + nextObj.curName);
    } else if (index === 5 || index === 6) {
      let nextObj = {}
      if (userDataObj['stepOne-one'] === "PLEATED") {
        nextObj = contentList[7]
      } else {
        nextObj = contentList[8]
      }
      nextName = document.querySelectorAll('.' + nextObj.curName);
    } else if (index === 7) {
      let nextObj = contentList[9]
      nextName = document.querySelectorAll('.' + nextObj.curName);
    } else if (index === 9) {
      let k = 0
      if (userDataObj['stepOne-one'] === "PLEATED") {
        k = 12
      } else if (userDataObj['stepOne-one'] === 'GROMMETS') {
        k = 11
      } else {
        k = 10
      }

      let nextObj = contentList[k]
      nextName = document.querySelectorAll('.' + nextObj.curName);
    } else if (index === 12) {
      calculationCesults()
    }

    setContentShow(nextName, currentContent, curentIndex)
  }

  // 计算结果W
  function calculationCesults() {
    // 判断第一步选择的类型['SOFT TOP', 'PLEATED', 'GROMMETS']    
    // rodInstalled ['yes', 'no'],
    let type = userDataObj['stepOne-one']
    // 是否安装杆
    let rodInstalled = userDataObj['stepOne-two']
    let width = '' //最后显示的W
    let length = '' //最后显示的L
    let height = ''
    if (rodInstalled === 'no') {
      height = userDataObj['stepOne-four'].split(',')
    }
    const multipliers = {
      'Single Panel': 1,
      'Split Panels': 0.5,
    };
    const curtainLength = {
      '1/2 ABOVE FLOOR': -1,
      'BREAK ON THE FLOOR': 0,
      'SLIGHT PUDDLE ON FLOOR': 1,
    };
    let twelve = multipliers[userDataObj['stepOne-twelve']]
    // 选项调整
    let disCount = Number(curtainLength[userDataObj['stepOne-ten']])

    // (窗户的宽度 + A和B的和)
    let a = Number(userDataObj['stepOne-three']) + Number(height[0]) + Number(height[1])
    if (type === 'SOFT TOP') {
      if (rodInstalled === 'yes') {
        // 计算公式：杆的长度 × (single/split) × (2x/1.5x/1)
        width = Number(userDataObj['stepOne-seven']) * twelve * Number(userDataObj['stepOne-eleven'])

        // 计算公式：杆顶到地板的距离 + 选项调整（1 inch above floor时-1, break on floor时+0, slight puddle on floor时+1）。
        length = Number(userDataObj['stepOne-nine']) + disCount
      } else {
        // (窗户的宽度 + A和B的和) × (single/split) × (2x/1.5x/1)
        // A和B的和stepOne-four
        width = a * twelve * Number(userDataObj['stepOne-eleven'])

        // 计算公式：窗户本身的高度 + 窗户到杆的距离 + 选项调整（1 inch above floor时-1, break on floor时+0, slight puddle on floor时+1）
        length = Number(userDataObj['stepOne-five']) + Number(userDataObj['stepOne-six']) + disCount

      }
    } else if (type === 'PLEATED') {
      if (rodInstalled === 'yes') {
        // 杆的长度 × (single/split)
        width = Number(userDataObj['stepOne-seven']) * twelve

        // 计算公式：杆环孔眼到地板的距离 + 选项调整（1 inch above floor时-1, break on floor时+0, slight puddle on floor时+1）
        length = Number(userDataObj['stepOne-eight']) + disCount
      } else {
        // (窗户的宽度 + A和B的和) × (single/split)
        width = a * twelve

        //  计算公式：窗户本身的高度 + 窗户到杆的距离 + 选项调整（1 inch above floor时-1, break on floor时+0, slight puddle on floor时+1）。
        length = Number(userDataObj['stepOne-five']) + Number(userDataObj['stepOne-six']) + disCount
      }
    } else {
      if (rodInstalled === 'yes') {
        // 杆的长度 × (single/split) × (2x/1.5x)
        width = Number(userDataObj['stepOne-seven']) * twelve * Number(userDataObj['stepOne-eleven-two'])

        //计算公式：杆顶部到地板的距离 + 选项调整（1 inch above floor时-1, break on floor时+0, slight puddle on floor时+1）
        length = Number(userDataObj['stepOne-nine']) + disCount

      } else {
        width = a * twelve * Number(userDataObj['stepOne-eleven-two'])

        // 计算公式：窗户本身的高度 + 窗户到杆的距离 + 选项调整（1 inch above floor时-1, break on floor时+0, slight puddle on floor时+1）
        length = Number(userDataObj['stepOne-five']) + Number(userDataObj['stepOne-six']) + disCount
      }
    }

    let w = document.getElementById('finishedResult')
    w.innerText = (width.toFixed(2).replace(/\.00$/, '')) + '”W * ' + (length.toFixed(2).replace(/\.00$/, '')) +
      '”L'

    let header = document.getElementById('Header')
    let Bottom = document.getElementById('Bottom')
    let Qty = document.getElementById('Qty')
    let Fullness = document.getElementById('Fullness')

    header.innerText = type
    Bottom.innerText = userDataObj['stepOne-ten']
    Qty.innerText = userDataObj['stepOne-twelve']

    let full = '-'
    if (type === 'SOFT TOP') {
      full = userDataObj['stepOne-eleven'] + 'X'
    } else if (type === 'GROMMETS') {
      full = userDataObj['stepOne-eleven-two'] + 'X'
    }
    Fullness.innerText = full
  }


