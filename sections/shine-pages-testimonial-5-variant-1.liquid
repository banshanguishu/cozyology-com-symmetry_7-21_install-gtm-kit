            </svg>
        {% endfor %}

        {%  for rating in (1..rating_end) %} 
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M7.46731 13.9992L2.78761 10.4516C2.36545 10.1316 2.58414 9.45859 3.11381 9.4478L9.01748 9.3275C9.25114 9.32274 9.45715 9.17308 9.53388 8.95234L11.4726 3.37528C11.6466 2.87491 12.3543 2.87491 12.5282 3.37528L14.467 8.95234C14.5437 9.17308 14.7497 9.32274 14.9834 9.3275L20.8871 9.4478C21.4167 9.45859 21.6354 10.1316 21.2132 10.4516L16.5078 14.0187C16.3216 14.1599 16.2429 14.4021 16.3105 14.6258L18.0205 20.2772C18.1739 20.7842 17.6013 21.2002 17.1665 20.8976L12.3196 17.5251C12.1278 17.3916 11.8731 17.3916 11.6813 17.5251L6.83439 20.8976C6.39953 21.2002 5.82699 20.7842 5.9804 20.2772L7.16263 16.3698L7.46731 13.9992ZM12.0005 16.3076C12.3354 16.3076 12.6702 16.4077 12.9579 16.6079L16.4853 19.0623L15.2409 14.9493C15.0379 14.2783 15.2739 13.5518 15.8326 13.1283L19.2571 10.5323L14.9606 10.4447C14.2596 10.4304 13.6416 9.98143 13.4114 9.31923L12.0005 5.26072V16.3076Z" fill=""/>
            </svg>
        {% endfor %}

        {%  for rating in (1..rest_floor) %} 
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12.0004 5.22833L10.5765 9.32478C10.3495 9.97772 9.7402 10.4204 9.04908 10.4345L4.7131 10.5229L8.16904 13.143C8.71989 13.5606 8.95264 14.2769 8.75247 14.9386L7.49662 19.0896L11.0564 16.6125C11.6238 16.2177 12.377 16.2177 12.9444 16.6125L16.5042 19.0896L15.2484 14.9386C15.0482 14.2769 15.281 13.5606 15.8318 13.143L19.2878 10.5229L14.9518 10.4345C14.2607 10.4204 13.6513 9.97772 13.4244 9.32478L12.0004 5.22833ZM12.5208 3.36954C12.3493 2.87617 11.6516 2.87617 11.4801 3.36954L9.53577 8.96302C9.46012 9.18067 9.257 9.32824 9.02663 9.33293L3.10609 9.45359C2.58387 9.46423 2.36826 10.1278 2.78449 10.4434L7.50338 14.021C7.687 14.1602 7.76458 14.399 7.69786 14.6195L5.98306 20.2876C5.83181 20.7875 6.39629 21.1976 6.82503 20.8993L11.6858 17.5169C11.8749 17.3853 12.126 17.3853 12.3151 17.5169L17.1758 20.8993C17.6046 21.1976 18.1691 20.7875 18.0178 20.2876L16.303 14.6195C16.2363 14.399 16.3139 14.1602 16.4975 14.021L21.2164 10.4434C21.6326 10.1278 21.417 9.46423 20.8948 9.45359L14.9742 9.33293C14.7439 9.32824 14.5407 9.18067 14.4651 8.96302L12.5208 3.36954Z" fill=""/>
            </svg>
        {% endfor %}
    </div>
    <div class="count-rating" style="font-size: 14px;">
        <p>({{ 'shinepages.product.rating_count' | t: count: rating_count }})</p>
    </div>
</div>
{% endif %}  
                                    </div>
                                {% endif %}
                            </div>
                            
                        </div>
                    {% endfor %}
                    <div class="sp-testimonial-wrapper">
                        <div class="sp-carousel-wrapper" data-plugin="sp-carousel"
                             data-pagination-style="{{ settings.pagination_style | default: "circle" }}"
                             data-pagination-position="{{ settings.pagination_position }}"
                             data-pagination-background="{{ settings.show_background_pagination }}"
                             data-show-pagination-desktop="{{ settings.show_pagination_desktop }}"
                             data-show-pagination-mobile="{{ settings.show_pagination_mobile }}"
                             data-show-navigation-desktop="{{ settings.show_navigation_desktop }}"
                             data-show-navigation-mobile="{{ settings.show_navigation_mobile }}"
                             data-navigation-box-shadow="{{ settings.navigation_box_shadow }}"
                             data-navigation-style="{{ settings.navigation_style | default: "fill" }}"
                             data-loading="{{ settings.auto_rotate_slide | default: "false" }}"
                             data-loading-time="{{ settings.change_slide_every | default: 3 }}"
                        >
                            <div class="sp-carousel sp-carousel-column"
                                data-column="5"
                                data-column-mobile="1"
                                data-column-tablet="3"
                                data-column-size="{{ settings.grid_spacing }}">
                                {% assign slideIndex = 0 %}
                                {% assign testimonial_block = section.blocks | where: 'type', 'testimonial_item' %}
                                {% for block in testimonial_block %}
                                    {% assign setting = block.settings %}
                                    <div id="sp-{{ block.id }}" 
                                        class="sp-column sp-carousel-item" data-type="{{ block.type }}"
                                        data-slider-index="{{ slideIndex }}" {{ block.shopify_attributes }}
                                        data-show-background="{{ settings.show_background }}"
                                        data-box-shadow="{{ settings.show_box_shadow }}"
                                    >
                                        <style>
                                            #sp-{{ block.id }} .sp-testimonial-item .sp-testimonial-avatar {
                                                --sp-testimonial-avatar-width: {{ setting.image_max_width_desktop }}px;
                                                --sp-testimonial-avatar-radius: {% if setting.avatar_radius == 60 %}50%{% else %}{{ setting.avatar_radius }}px{% endif %};
                                            }

                                            #sp-{{ block.id }} .sp-testimonial-item .sp-testimonial-quote {
                                                --sp-font-size: {{ settings.text_size_desktop }}px;
                                                --sp-text-letter-spacing: {{ settings.text_spacing }}px;
                                            }

                                            @media (max-width: 767px) {
                                                #sp-{{ block.id }} .sp-testimonial-item .sp-testimonial-avatar {
                                                    --sp-testimonial-avatar-width: {{ setting.image_max_width_mobile }}px;
                                                }

                                                #sp-{{ block.id }} .sp-testimonial-item .sp-testimonial-quote {
                                                    --sp-font-size-mobile: {{ settings.text_size_mobile }}px;
                                                }
                                            }
                                        </style>
                                        <div class="sp-testimonial-item">
                                            <div class="sp-testimonial-author">
                                                <div class="sp-infomation">
                                                    <div class="sp-infomation-author">
                                                        <div class="author-avatar">
                                                            {% if setting.avatar != null %}
                                                                <div
                                                                    class="sp-testimonial-avatar sp-content-text-{{ settings.content_alignment }}"
                                                                    style="background-image: url('{{ setting.avatar | image_url: width: 600}}');"
                                                                >
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                        <div class="author-description">
                                                            {% if setting.name != empty %}
                                                                <div
                                                                    class="sp-testimonial-name sp-content-text-left"
                                                                >
                                                                    {{ setting.name | escape }}
                                                                </div>
                                                            {% endif %}
                                                            {% if setting.information != empty %}
                                                                <div
                                                                    class="sp-testimonial-information sp-content-text-left"
                                                                >
                                                                    {{ setting.information | escape }}
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                    <div class="sp-icon-app">
                                                        {% if setting.icon_information != null %}
                                                            <div 
                                                                class="sp-icon-information" 
                                                                style="background-image: url('{{ setting.icon_information | image_url: width: 50 }}');"
                                                            >
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <div class="sp-rating">
                                                    {%  assign rating_score = setting.star_rating_score %}
