{% style %}
	#sp-{{section.id}} .sp-section{background:var(--sp-section-background-color);padding-top:var(--sp-section-top-padding);padding-bottom:var(--sp-section-bottom-padding)}#sp-{{section.id}} .sp-section .sp-section-inner{display:flex;align-items:center;justify-content:flex-start;flex-direction:column}#sp-{{section.id}} .sp-section .sp-section-inner .sp-content-collection{background:var(--sp-section-background-color);width:max-content;padding:20px}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items{display:flex;align-items:stretch;justify-content:flex-start;width:100%;gap:var(--sp-section-collection-items-gap);height:var(--sp-section-container-height);border-radius:var(--sp-section-container-radius);overflow:hidden}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item{width:30%;transition:width .2s ease-in-out;height:100%;position:relative;overflow:hidden}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item .sp-collection-list-image{position:absolute;width:100%;height:100%;left:0;right:0;bottom:0;top:0}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item .sp-collection-list-image .sp-image{display:block;width:100%;height:var(--sp-section-container-height);object-position:center;object-fit:cover}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item .sp-collection-list-content{position:absolute;left:0;bottom:0;width:100%;right:0;opacity:0;background:rgba(var(--sp-collection-item-background-color), 0.3);z-index:-1;visibility:hidden}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item .sp-collection-list-content .sp-content-wrapper{transform:translateX(100%);transition:.2s ease-in-out;background-color:rgba(0,0,0,0);padding:20px}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item .sp-collection-list-content .sp-content-wrapper .sp-heading-collection h2{font-size:var(--sp-collection-item-heading-size);line-height:var(--sp-collection-item-heading-size);color:var(--sp-collection-item-heading-color)}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item .sp-collection-list-content .sp-content-wrapper .sp-description-collection p{font-size:var(--sp-collection-item-description-size);margin:15px 0;line-height:var(--sp-collection-item-description-size);color:var(--sp-collection-item-text-color);opacity:.8}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item .sp-collection-list-content .sp-content-wrapper .sp-link-collection a{color:var(--sp-collection-item-link-color);font-size:calc(var(--sp-collection-item-description-size) - 2);opacity:.8}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item.active{width:70%;transition:width .2s ease-in-out}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item.active .sp-collection-list-content{opacity:1;z-index:1;visibility:visible}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item.active .sp-collection-list-content .sp-content-wrapper{transform:translateX(0);transition:width .2s ease-in-out}@media(max-width: 767px){#sp-{{section.id}} .sp-section-inner .sp-collection-list-items{flex-direction:column}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item{width:100%}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item .sp-content-wrapper{padding:10px}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item .sp-collection-list-image{position:absolute;width:100%;height:100%;left:0;right:0;bottom:0;top:0}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item .sp-collection-list-image .sp-image{display:block;width:100%;height:100%;object-fit:cover}#sp-{{section.id}} .sp-section-inner .sp-collection-list-items .sp-collection-list-item.active{width:100%}}
