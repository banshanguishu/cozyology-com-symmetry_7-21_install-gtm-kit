{% comment %} Variables  {% endcomment %}
{% assign settings = section.settings %}
<style>
    {% comment %}
    Render heading & body font family
{% endcomment %}
{%- if settings.override_font != blank -%}
    {%- capture font_settings_list -%}
        {{ settings.heading_font | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
        {{ settings.body_font | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
    {%- endcapture -%}
    {%- assign font_array = font_settings_list | split: ';;' -%}
{% endif %}
{%- if settings.override_font != blank -%}
    {%- for font in font_array -%}
        {%- unless font contains 'error' -%}
            {{ font }}{%- endunless -%}
    {%- endfor -%}
    #sp-{{ section.id }} {
    --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
    --sp-heading-font-weight: {{ settings.heading_font.weight }};
    --sp-heading-font-style: {{ settings.heading_font.style }};
    --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
    --sp-body-font-weight: {{ settings.body_font.weight }};
    --sp-body-font-style: {{ settings.body_font.style }};
    --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
    --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
    --sp-highlight-font-style: {{ settings.highlight_font.style }};
    }
    {% if custom_selector != blank %}
        {{ custom_selector }} {
        --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
        --sp-heading-font-weight: {{ settings.heading_font.weight }};
        --sp-heading-font-style: {{ settings.heading_font.style }};
        --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
        --sp-body-font-weight: {{ settings.body_font.weight }};
        --sp-body-font-style: {{ settings.body_font.style }};
        --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
        --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
        --sp-highlight-font-style: {{ settings.highlight_font.style }};
        }
    {% endif %}
{% endif %}
    {% comment %}
    Render padding section, heading content max width
{% endcomment %}

    #sp-{{ section.id }} .sp-section {
    {% if settings.section_top_padding_mobile and  settings.section_bottom_padding_mobile %}
        --sp-section-top-padding: {{ settings.section_top_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
    {% else %}
        --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
    {% endif %}
        }

    @media (min-width: 768px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
        }
    }

    @media (min-width: 1260px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | round: 0 }}rem;
        }
    }


    #sp-{{ section.id }} {
        --sp-section-background-color: {{ settings.section_background_color }};
        --sp-section-background-gradient-color: {{ settings.section_background_gradient_color | default: "null" }};
        --sp-section-text-color: {{ settings.section_text_color | default: "transparent" }};

        background-color: var(--sp-section-background-color);
        background-image: var(--sp-section-background-gradient-color);

        --sp-item-gap: {{ settings.item_gap_desktop }}px;
        --sp-pagination-color: {{ settings.pagination_color }};
        --sp-pagination-highlight-color: {{ settings.pagination_highlight_color }};
    }

    #sp-{{ section.id }} .sp-testimonial-carousel-outer {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: var(--sp-item-gap);
    }

    #sp-{{ section.id }} .sp-heading-wrapper {
        --sp-section-heading-width: 0rem;
        max-width: var(--sp-section-heading-width);
    }

    #sp-{{ section.id }} .sp-carousel-item {
        --sp-item-padding: 35px 30px;
        --sp-testimonial-rating-size: {{ settings.rating_score_size }}px;
        --sp-testimonial-avatar-size: {{ settings.avatar_size }}px;

        --sp-testimonial-background-color: {{ settings.item_background_color }};
        --sp-testimonial-shadow-color: {{ settings.item_shadow_color.red }}, {{ settings.item_shadow_color.green }},{{ settings.item_shadow_color.blue }};
        --sp-testimonial-rating-color: {{ settings.item_rating_color }};

        --sp-testimonial-text-size: {{ settings.item_text_size }}px;
        --sp-testimonial-text-color: {{ settings.item_text_color }};
        --sp-testimonial-author-size: {{ settings.item_author_size }}px;
        --sp-testimonial-author-color: {{ settings.item_author_color }};
        --sp-testimonial-description-size: {{ settings.item_description_size }}px;
        --sp-testimonial-description-color: {{ settings.item_description_color }};

        display: flex;
        flex-direction: column;
        align-items: center;
        padding: var(--sp-item-padding);
        background-color: var(--sp-testimonial-background-color);
        box-shadow: 0 6px 20px 0 rgba(var(--sp-testimonial-shadow-color), 0.3);
        text-align: center;
    }

    #sp-{{ section.id }} .sp-testimonial-carousel-wrapper {
        overflow-x: hidden;
    }

    #sp-{{ section.id }} .sp-testimonial-rating {
        display: flex;
        flex-wrap: nowrap;
        gap: 3px;
    }

    #sp-{{ section.id }} .sp-testimonial-rating svg {
        width: var(--sp-testimonial-rating-size);
        height: var(--sp-testimonial-rating-size);
        fill: var(--sp-testimonial-rating-color);
    }

    #sp-{{ section.id }} .sp-testimonial-avatar {
        position: relative;
        width: var(--sp-testimonial-avatar-size);
        height: var(--sp-testimonial-avatar-size);
        border-radius: 50%;
        overflow: hidden;
    }

    #sp-{{ section.id }} .sp-testimonial-avatar svg,
    #sp-{{ section.id }} .sp-testimonial-avatar img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    #sp-{{ section.id }} .sp-testimonial-rating + .sp-testimonial-text {
        margin-top: 25px;
    }

    #sp-{{ section.id }} .sp-testimonial-text {
        color: var(--sp-testimonial-text-color);
        font-size: var(--sp-testimonial-text-size);
        line-height: 1.5;
    }

    #sp-{{ section.id }} .sp-testimonial-avatar {
        margin-top: 20px;
    }

    #sp-{{ section.id }} .sp-testimonial-author {
        margin-top: 5px;
        color: var(--sp-testimonial-author-color);
        font-size: var(--sp-testimonial-author-size);
        line-height: 1;
    }

    #sp-{{ section.id }} .sp-testimonial-description {
        margin-top: 5px;
        color: var(--sp-testimonial-description-color);
        font-size: var(--sp-testimonial-description-size);
        line-height: 1;
    }

    #sp-{{ section.id }} .swiper-pagination {
        width: 80px;
        position: static;
        margin: 25px auto 0;
        transform: none;
    }

    #sp-{{ section.id }} .swiper-pagination-bullet {
        background-color: var(--sp-pagination-color);
    }

    #sp-{{ section.id }} .swiper-pagination-bullet.swiper-pagination-bullet-active {
        background-color: var(--sp-pagination-highlight-color);
    }

    @media (max-width: 767px) {
        #sp-{{ section.id }} {
            --sp-item-gap: {{ settings.item_gap_mobile }}px;
        }

        #sp-{{ section.id }} .sp-carousel-item {
            --sp-item-padding: 25px var(--sp-column-mobile-padding);
            --sp-testimonial-rating-size: {{ settings.rating_score_size_mobile }}px;
            --sp-testimonial-avatar-size: {{ settings.avatar_size_mobile }}px;
        }
    }

</style>

<link rel="stylesheet" href="{{ 'sp-swiper-bundle.min.css' | asset_url }}">
<script data-id="swiper-bundle" src="{{ 'sp-swiper-bundle.min.js' | asset_url }}"></script>

<div id="sp-{{ section.id }}" class="sp-{{ section.id }} sp-section-testimonial-carousel-1"
     data-section="testimonial-carousel-1"
     data-variant="variant-3" data-lazy="sp-{% if settings.lazy_load %}lazy-section{% endif %}">
    <div class="sp-section sp-relative sp-section-overflow"
         data-border="{{ settings.section_border }}">
        <div class="{% case settings.section_width %}{% when 'boxed' %}sp-container{% when 'full_width' %}sp-container-fluid{% else %}sp-container-fluid sp-container-no-gap{% endcase %}">
            <div class="sp-testimonial-carousel-outer">
                {% assign heading_block = section.blocks | where: 'type', 'heading_item' %}
                {% for block in heading_block %}
                    {% assign setting = block.settings %}
                    <div class="sp-heading-outer {{ setting.heading_position }}" {{ block.shopify_attributes }}>
                        <style>
                            {% assign heading_settings = block.settings %}
                            {% assign heading_selector = section.id | prepend:"#sp-" | append:" .sp-heading-wrapper" %}
                            
    {{ heading_selector }} {
        --sp-section-heading-size: {{ heading_settings.heading_size_mobile }}px;
        --sp-section-description-size: {{ heading_settings.description_size_mobile }}px;
        --sp-heading-letter-spacing: {{ heading_settings.text_heading_spacing | default: 0 }}px;
        --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 | times: 0.6 }};

    }
    @media (min-width: 768px) {
        {{ heading_selector }} {
            --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 | times: 0.8 }};
            --sp-section-heading-size: {{ heading_settings.heading_size_desktop | times: 0.8 }}px;
            --sp-section-description-size: max({{ heading_settings.description_size_desktop | times: 0.8 }}px, {{ heading_settings.description_size_mobile }}px);
        }
    }

    @media (min-width: 1200px) {
        {{ heading_selector }} {
            --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 }};
            --sp-section-heading-size: {{ heading_settings.heading_size_desktop }}px;
            --sp-section-description-size: {{ heading_settings.description_size_desktop }}px;
        }
    }

                        </style>
                        <div class="sp-heading-wrapper"
                             style="--sp-section-heading-width: {{ setting.heading_max_width | divided_by: 10.0 }}rem">
                            {% if setting.sub_heading != blank %}
                                <h5 class="sp-sub-heading {{ setting.sub_heading_size | default: "sp-sub-heading-size-medium" }}">{{ setting.sub_heading }}</h5>
                            {% endif %}
                            {% if setting.heading != blank %}
                                <h2 class="sp-heading">{{ setting.heading }}</h2>
                            {% endif %}
                            {% if setting.description != blank and setting.description != '<p></p>' %}
                                <div class="sp-description">{{ setting.description }}</div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
                <div class="sp-testimonial-carousel-wrapper" data-plugin="swiper"
                     data-auto-play="{{ settings.auto_play }}" data-items="{{ settings.number_item_showing }}">
                    <div class="swiper-wrapper">
                        {% assign carousel_items = section.blocks | where: 'type', 'testimonial_item' %}
                        {% assign count = carousel_items.size %}
                        {% if count > 0 %}
                            {% if count < 12 %}
                                {% assign page = 12 | divided_by: count | plus: 1 %}
                                {% for i in (1..page) %}
                                    {% for block in carousel_items %}
                                        {% assign setting = block.settings %}
                                        <div class="swiper-slide">
                                            <div id="{{ block.id }}"
                                                 class="sp-carousel-item" {{ block.shopify_attributes }}>
                                                <div class="sp-testimonial-rating">
                                                    {% for i in (1..setting.rating_score) %}
                                                        <svg class="sp-icon" width="24" height="24" viewBox="0 0 24 24"
                                                             fill="none"
                                                             xmlns="http://www.w3.org/2000/svg">
                                                            <path d="M11.4789 3.37002C11.6504 2.87666 12.3481 2.87666 12.5196 3.37002L14.4639 8.9634C14.5395 9.18104 14.7427 9.32861 14.973 9.3333L20.8934 9.45395C21.4157 9.4646 21.6313 10.1282 21.215 10.4437L16.4962 14.0213C16.3126 14.1605 16.235 14.3993 16.3018 14.6198L18.0165 20.2877C18.1678 20.7877 17.6033 21.1978 17.1746 20.8995L12.3139 17.5171C12.1248 17.3855 11.8737 17.3855 11.6846 17.5171L6.82398 20.8995C6.39525 21.1978 5.83077 20.7877 5.98202 20.2877L7.69679 14.6198C7.76351 14.3993 7.68593 14.1605 7.50231 14.0213L2.78351 10.4437C2.36729 10.1282 2.5829 9.4646 3.10511 9.45395L9.02553 9.3333C9.2559 9.32861 9.45901 9.18104 9.53466 8.9634L11.4789 3.37002Z"/>
                                                        </svg>
                                                    {% endfor %}
                                                </div>
                                                <h4 class="sp-testimonial-text body-font">{{ setting.text }}</h4>
                                                <div class="sp-testimonial-avatar">
                                                    {% if setting.avatar != null %}
                                                        {{ setting.avatar | image_url: width: 512 | image_tag }}
                                                    {% else %}
                                                        {{ 'image' | placeholder_svg_tag: 'sp-placeholder-image-gray' }}
                                                    {% endif %}
                                                </div>
                                                <div class="sp-testimonial-author heading-font">{{ setting.author }}</div>
                                                <div class="sp-testimonial-description body-font">{{ setting.description_text }}</div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% endfor %}
                            {% else %}
                                {% for block in carousel_items %}
                                    {% assign setting = block.settings %}
                                    <div class="swiper-slide">
                                        <div id="{{ block.id }}"
                                             class="sp-carousel-item" {{ block.shopify_attributes }}>
                                            <div class="sp-testimonial-rating">
                                                {% for i in (1..setting.rating_score) %}
                                                    <svg class="sp-icon" width="24" height="24" viewBox="0 0 24 24"
                                                         fill="none"
                                                         xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M11.4789 3.37002C11.6504 2.87666 12.3481 2.87666 12.5196 3.37002L14.4639 8.9634C14.5395 9.18104 14.7427 9.32861 14.973 9.3333L20.8934 9.45395C21.4157 9.4646 21.6313 10.1282 21.215 10.4437L16.4962 14.0213C16.3126 14.1605 16.235 14.3993 16.3018 14.6198L18.0165 20.2877C18.1678 20.7877 17.6033 21.1978 17.1746 20.8995L12.3139 17.5171C12.1248 17.3855 11.8737 17.3855 11.6846 17.5171L6.82398 20.8995C6.39525 21.1978 5.83077 20.7877 5.98202 20.2877L7.69679 14.6198C7.76351 14.3993 7.68593 14.1605 7.50231 14.0213L2.78351 10.4437C2.36729 10.1282 2.5829 9.4646 3.10511 9.45395L9.02553 9.3333C9.2559 9.32861 9.45901 9.18104 9.53466 8.9634L11.4789 3.37002Z"/>
                                                    </svg>
                                                {% endfor %}
                                            </div>
                                            <h4 class="sp-testimonial-text body-font">{{ setting.text }}</h4>
                                            <div class="sp-testimonial-avatar">
                                                {% if setting.avatar != null %}
                                                    {{ setting.avatar | image_url: width: 512 | image_tag }}
                                                {% else %}
                                                    {{ 'image' | placeholder_svg_tag: 'sp-placeholder-image-gray' }}
                                                {% endif %}
                                            </div>
                                            <div class="sp-testimonial-author heading-font">{{ setting.author }}</div>
                                            <div class="sp-testimonial-description body-font">{{ setting.description_text }}</div>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}

                        {% else %}
                            {% for i in (1..12) %}
                                <div class="swiper-slide">
                                    <div class="sp-carousel-item">
                                        <div class="sp-testimonial-rating">
                                            {% for i in (1..5) %}
                                                <svg class="sp-icon" width="24" height="24" viewBox="0 0 24 24"
                                                     fill="none"
                                                     xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M11.4789 3.37002C11.6504 2.87666 12.3481 2.87666 12.5196 3.37002L14.4639 8.9634C14.5395 9.18104 14.7427 9.32861 14.973 9.3333L20.8934 9.45395C21.4157 9.4646 21.6313 10.1282 21.215 10.4437L16.4962 14.0213C16.3126 14.1605 16.235 14.3993 16.3018 14.6198L18.0165 20.2877C18.1678 20.7877 17.6033 21.1978 17.1746 20.8995L12.3139 17.5171C12.1248 17.3855 11.8737 17.3855 11.6846 17.5171L6.82398 20.8995C6.39525 21.1978 5.83077 20.7877 5.98202 20.2877L7.69679 14.6198C7.76351 14.3993 7.68593 14.1605 7.50231 14.0213L2.78351 10.4437C2.36729 10.1282 2.5829 9.4646 3.10511 9.45395L9.02553 9.3333C9.2559 9.32861 9.45901 9.18104 9.53466 8.9634L11.4789 3.37002Z"/>
                                                </svg>
                                            {% endfor %}
                                        </div>
                                        <h4 class="sp-testimonial-text body-font">Lorem ipsum dolor sit amet,
                                            consectetur
                                            adipiscing elit</h4>
                                        <div class="sp-testimonial-avatar">
                                            {{ 'image' | placeholder_svg_tag: 'sp-placeholder-image-gray' }}
                                        </div>
                                        <div class="sp-testimonial-author heading-font">David Mores</div>
                                        <div class="sp-testimonial-description body-font">Freelance business</div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="swiper-pagination"></div>
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
{
	"name": "🧩 Testimonial carousel 3",
	"tag": "section",
	"class": "sp-testimonial-carousel-1",
	"settings": [
		{
			"type": "header",
			"content": "Section settings"
		},
		{
			"type": "range",
			"id": "item_gap_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Items gap (Desktop)",
			"default": 50
		},
		{
			"type": "range",
			"id": "item_gap_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Items gap (Mobile)",
			"default": 35
		},
		{
			"type": "header",
			"content": "Carousel settings"
		},
		{
			"type": "checkbox",
			"id": "auto_play",
			"label": "Auto play",
			"default": true
		},
		{
			"type": "range",
			"id": "number_item_showing",
			"min": 2,
			"max": 5,
			"step": 1,
			"unit": "px",
			"label": "Number of items displayed",
			"default": 4
		},
		{
			"type": "header",
			"content": "Testimonial settings"
		},
		{
			"type": "range",
			"id": "rating_score_size",
			"min": 10,
			"max": 50,
			"step": 1,
			"unit": "px",
			"label": "Rating score size (Desktop)",
			"default": 26
		},
		{
			"type": "range",
			"id": "rating_score_size_mobile",
			"min": 10,
			"max": 50,
			"step": 1,
			"unit": "px",
			"label": "Rating score size (Mobile)",
			"default": 22
		},
		{
			"type": "range",
			"id": "avatar_size",
			"min": 50,
			"max": 150,
			"step": 1,
			"unit": "px",
			"label": "Avatar size (Desktop)",
			"default": 60
		},
		{
			"type": "range",
			"id": "avatar_size_mobile",
			"min": 50,
			"max": 150,
			"step": 1,
			"unit": "px",
			"label": "Avatar size (Mobile)",
			"default": 80
		},
		{
			"type": "header",
			"content": "Testimonial text styling"
		},
		{
			"type": "range",
			"id": "item_text_size",
			"min": 8,
			"max": 64,
			"step": 1,
			"unit": "px",
			"label": "Text size (Desktop)",
			"default": 14
		},
		{
			"type": "range",
			"id": "item_text_size_mobile",
			"min": 8,
			"max": 64,
			"step": 1,
			"unit": "px",
			"label": "Text size (Mobile)",
			"default": 14
		},
		{
			"type": "range",
			"id": "item_author_size",
			"min": 8,
			"max": 64,
			"step": 1,
			"unit": "px",
			"label": "Author text size (Desktop)",
			"default": 16
		},
		{
			"type": "range",
			"id": "item_author_size_mobile",
			"min": 8,
			"max": 64,
			"step": 1,
			"unit": "px",
			"label": "Author text size (Mobile)",
			"default": 16
		},
		{
			"type": "range",
			"id": "item_description_size",
			"min": 8,
			"max": 64,
			"step": 1,
			"unit": "px",
			"label": "Description text size (Desktop)",
			"default": 14
		},
		{
			"type": "range",
			"id": "item_description_size_mobile",
