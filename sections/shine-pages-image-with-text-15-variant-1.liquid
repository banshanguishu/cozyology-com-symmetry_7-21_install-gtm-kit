{% comment %} Variables  {% endcomment %}
{% assign settings = section.settings %}
<style>
    {% comment %}
    Render heading & body font family
{% endcomment %}
{%- if settings.override_font != blank -%}
    {%- capture font_settings_list -%}
        {{ settings.heading_font | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
        {{ settings.body_font | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
    {%- endcapture -%}
    {%- assign font_array = font_settings_list | split: ';;' -%}
{% endif %}
{%- if settings.override_font != blank -%}
    {%- for font in font_array -%}
        {%- unless font contains 'error' -%}
            {{ font }}{%- endunless -%}
    {%- endfor -%}
    #sp-{{ section.id }} {
    --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
    --sp-heading-font-weight: {{ settings.heading_font.weight }};
    --sp-heading-font-style: {{ settings.heading_font.style }};
    --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
    --sp-body-font-weight: {{ settings.body_font.weight }};
    --sp-body-font-style: {{ settings.body_font.style }};
    --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
    --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
    --sp-highlight-font-style: {{ settings.highlight_font.style }};
    }
    {% if custom_selector != blank %}
        {{ custom_selector }} {
        --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
        --sp-heading-font-weight: {{ settings.heading_font.weight }};
        --sp-heading-font-style: {{ settings.heading_font.style }};
        --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
        --sp-body-font-weight: {{ settings.body_font.weight }};
        --sp-body-font-style: {{ settings.body_font.style }};
        --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
        --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
        --sp-highlight-font-style: {{ settings.highlight_font.style }};
        }
    {% endif %}
{% endif %}
    {% comment %}
    Render padding section, heading content max width
{% endcomment %}

    #sp-{{ section.id }} .sp-section {
    {% if settings.section_top_padding_mobile and  settings.section_bottom_padding_mobile %}
        --sp-section-top-padding: {{ settings.section_top_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
    {% else %}
        --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
    {% endif %}
        }

    @media (min-width: 768px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
        }
    }

    @media (min-width: 1260px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | round: 0 }}rem;
        }
    }


    #sp-{{ section.id }} {
        --sp-section-background-color: {{ settings.section_background_color | default: "transparent" }};
    {% if settings.section_background_gradient_color != blank %} --sp-section-background-color: "transparent";
    {% endif %} --sp-section-background-gradient-color: {{ settings.section_background_gradient_color | default: "null" }};
        --sp-section-text-color: {{ settings.section_text_color | default: "transparent" }};
        --padding-content: 10rem;
        --sp-container-padding: var(--sp-container-mobile-padding);
    }

    .sp-section-outer .sp-image-outer {
        --sp-image-aspect-ratio: {{ settings.image_ratio }};
    }

    #sp-{{ section.id }} .sp-section {
        background-color: var(--sp-section-background-color);
        background-image: var(--sp-section-background-gradient-color);
    }

    #sp-{{ section.id }} .sp-text-wrapper {
        --sp-content-max-width: {{ settings.content_max_width }}px;
        max-width: var(--sp-content-max-width);
        --sp-item-gap: {{ settings.item_gap }}px;
    }

    @media (max-width: 767px) {
        #sp-{{ section.id }} .sp-text-wrapper {
            --sp-item-gap: {{ settings.item_gap_mobile }}px;
        }
    }
    @media (min-width: 768px) {
        #sp-{{ section.id }}  {
            --sp-container-padding: var(--sp-container-tablet-padding)
        }
    }
    @media (min-width: 1200px) {
        #sp-{{ section.id }} {
            --sp-container-padding: var(--sp-container-desktop-padding)
        }
    }
    
    @media(max-width:1440px) {
        #sp-{{ section.id }} {
            --padding-content: 4rem;
        }
    }
    @media(max-width:767px) {
        #sp-{{ section.id }} {
            --padding-content: var(--sp-container-padding);
        }
    }

</style>
<div id="sp-{{ section.id }}" class="sp-{{ section.id }} sp-section-image-with-text-3" data-section="image-with-text-3"
     data-variant="variant-1" data-image-position="{{ settings.image_position }}">
    <div class="sp-image-ob" data-image-hover="{{ settings.image_hover }}" data-lazy="sp-{% if settings.lazy_load %}lazy-section{% endif %}">
        {%- if settings.section_image != blank -%}
            {{ settings.section_image | image_url: width: 1920 | image_tag: class: 'sp-image' }}
        {% else %}
            {{ 'image' | placeholder_svg_tag: 'sp-placeholder-image-gray-100' }}
        {% endif %}
    </div> 
    <div class="sp-section-outer">
        <div class="sp-section" data-border="{{ settings.section_border }}">
            <div class="sp-container-fluid sp-container-no-gap">
                <div class="sp-section-inner {{ settings.image_position }}" data-lazy="sp-{% if settings.lazy_load %}lazy-section{% endif %}"
                     data-cascade>
                     <div class="sp-image-outer" data-image-hover="{{ settings.image_hover }}">
                        {%- if settings.section_image != blank -%}
                            {{ settings.section_image | image_url: width: 1920 | image_tag: class: 'sp-image' }}
                        {% else %}
                            {{ 'image' | placeholder_svg_tag: 'sp-placeholder-image-gray-100' }}
                        {% endif %}
                    </div> 
                    <div class="sp-text-outer" data-content-position="{{ settings.content_position }}"
                         data-item-alignment="{{ settings.item_alignment }}"
                         data-item-alignment-mobile="{{ settings.item_alignment_mobile }}"
                    >
                        <div class="sp-text-wrapper">
                            {% for block in section.blocks %}
                                {% assign setting = block.settings %}
                                {% case block.type %}
                                    {% when 'heading_item' %}
                                        {% if setting.heading != empty or setting.description != empty %}
                                            <div id="sp-{{ block.id }}"
                                                 class="sp-heading-item" {{ block.shopify_attributes }}>
                                                <style>
                                                    #sp-{{ section.id }} .sp-text-wrapper .sp-heading-item {
                                                        --sp-text-gap: {{ setting.text_gap }}px;
                                                        --sp-heading-text-color: {{ setting.heading_text_color }};
                                                        --sp-description-text-color: {{ setting.description_text_color }};
                                                    }

                                                    #sp-{{ section.id }} .sp-text-wrapper .sp-heading-item .sp-heading {
                                                        --sp-text-size: {{ setting.heading_size_desktop }}px;
                                                        --sp-text-letter-spacing: {{ setting.text_heading_spacing }}px;
                                                        
                                                    }

                                                    #sp-{{ section.id }} .sp-text-wrapper .sp-heading-item .sp-description {
                                                        --sp-text-size: {{ setting.description_size_desktop }}px;
                                                        --sp-text-letter-spacing: {{ setting.text_description_spacing }}px;
                                                        
                                                    }

                                                    @media(max-width:1199px) {
                                                        #sp-{{ section.id }} .sp-text-wrapper .sp-heading-item .sp-heading { 
                                                            {% if setting.heading_size_desktop > 36 %}
                                                                --sp-text-size: {{ setting.heading_size_mobile }}px;
                                                             {%  endif %}
                                                        }
                                                    }

                                                    @media (max-width: 767px) {
                                                        #sp-{{ section.id }} .sp-text-wrapper .sp-heading-item {
                                                            --sp-text-gap: {{ setting.text_gap_mobile }}px;
                                                        }

                                                        #sp-{{ section.id }} .sp-text-wrapper .sp-heading-item .sp-heading {
                                                            --sp-text-size: {{ setting.heading_size_mobile }}px;
                                                        }

                                                        #sp-{{ section.id }} .sp-text-wrapper .sp-heading-item .sp-description {
                                                            --sp-text-size: {{ setting.description_size_mobile }}px;
                                                        }
                                                    }
                                                </style>
                                                {% if setting.heading != empty %}
                                                    <div class="sp-heading"
                                                         data-text-style="{{ setting.heading_text_style }}">{{ setting.heading }}</div>
                                                {% endif %}
                                                {% if setting.description != empty %}
                                                    <div class="sp-description"
                                                         data-text-style="{{ setting.description_text_style }}">{{ setting.description }}</div>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    {% when 'icon_item' %}
                                        <sp-swiper id="sp-{{ block.id }}" {{ block.shopify_attributes }}>
                                            <div  class="sp-icon-box sp-swiper-slides" 
                                                data-show-background="{{ setting.show_background }}"
                                                data-show-border="{{ setting.show_border }}"
                                                data-column="{{ setting.item_per_row_desktop }}"
                                                data-column-table="{{ setting.item_per_row_tablet }}"
                                                >
                                                    <style>
                                                        #sp-{{ block.id }} .sp-icon-box {
                                                            --content-padding: {{setting.content_padding }}px;
                                                            --sp-icon-box-gap: {{ setting.icon_box_gap }}px;
                                                            --icon-box-border-radius: {{ setting.icon_box_border_radius }}px;
                                                            --icon-box-border-width: {{ setting.icon_box_border_width }}px;
                                                            --sp-icon-box-background-color: {{ setting.icon_box_background_color }};
                                                            --icon-box-border-color: {{ setting.icon_box_border_color }};
        
                                                            --icon-size: {{ setting.icon_size_desktop }}px;
        
                                                        }
                                                        #sp-{{ block.id }} .sp-icon-box .sp-icon-box-item .sp-heading {
                                                            --sp-text-size: {{ setting.heading_size_desktop }}px;
                                                            --sp-text-letter-spacing: {{ setting.text_heading_spacing }}px;
                                                            --sp-heading-text-color: {{ setting.icon_box_heading_color }};
                                                        }
                                                        #sp-{{ block.id }} .sp-icon-box .sp-icon-box-item .sp-description {
                                                            --sp-text-size: {{ setting.description_size_desktop }}px;
                                                            --sp-text-letter-spacing: {{ setting.text_description_spacing }}px;
                                                            --sp-description-text-color: {{ setting.icon_box_description_color }};
                                                        }
            
                                                        @media (max-width: 767px) {
                                                            #sp-{{ block.id }} .sp-icon-box {
                                                                --sp-icon-box-gap: {{ setting.icon_box_gap_mobile }}px;
                                                                --icon-size: {{ setting.icon_size_mobile }}px;
                                                            }
                                                            #sp-{{ block.id }} .sp-icon-box .sp-icon-box-item .sp-heading {
                                                                --sp-text-size: {{ setting.heading_size_mobile }}px;
                                                            }
    
                                                            #sp-{{ block.id }} .sp-icon-box .sp-icon-box-item .sp-description {
                                                                --sp-text-size: {{ setting.description_size_mobile }}px;
                                                            }
                                                        }
                                                    </style>
                                                {% for i in (1..6) %}
                                                    {% assign key_icon = 'icon_' | append: i %}
                                                    {% assign key_heading = 'icon_heading_' | append: i %}
                                                    {% assign key_description = 'icon_description_' | append: i %}
                                                    {% if setting[key_icon] != null or  setting[key_heading] != empty or setting[key_description] != empty %}    
                                                        <div class="sp-icon-box-item sp-swiper-slide-item" data-item-hover="fly">
                                                            <div class="sp-icon-item" >
                                                                {% if setting[key_icon] != null %}
                                                                    <div class="sp-icon-item__icon">
                                                                        {{ setting[key_icon] | image_url: width: 512 | image_tag: class: 'sp-image' }}
                                                                    </div>
                                                                {% endif %}
                                                                {% if setting[key_heading] != empty %}
                                                                    <div class="sp-icon-box-item__title sp-heading" data-text-style="{{ setting.heading_text_style }}">{{ setting[key_heading] }}</div>
                                                                {% endif %}
                                                            </div>
                                                            {% if setting[key_description] != empty %}
                                                                <div class="sp-icon-box-item__description sp-description" data-text-style="{{ setting.description_text_style }}">{{ setting[key_description] }}</div>
                                                            {% endif %}    
                                                        </div>
                                                    {% endif %}
                                                {% endfor %}
                                            </div> 
                                        </sp-swiper>
                                        
                                    {% when 'button_item' %}
                                        {% if setting.button_text != blank %}
                                            <div id="sp-{{ block.id }}"
                                                 class="sp-button-wrapper" {{ block.shopify_attributes }}
                                                 data-alignment="{{ settings.item_alignment }}"
                                                 data-alignment-mobile="{{ settings.item_alignment_mobile }}">
                                                {% assign button_selector = block.id | append: ".sp-button-wrapper .sp-button" | prepend: "#sp-" %}
                                                {% assign button_settings = block.settings %}
                                                <style>
                                                    {% comment %}
    Render button style variables
    Pass button selector to apply
{% endcomment %}
{{ button_selector }}{
    --sp-button-border-width:{{ button_settings.button_border_width | append:"px" }};
    --sp-button-radius: {{ button_settings.button_radius | append:"px" }};
    --sp-button-text-spacing: {{ button_settings.button_text_spacing | append:"px" }};
    --sp-button-scale: {{ button_settings.button_scale_mobile | divided_by: 100.0 }};
    {% if button_settings.button_scale_mobile >= 100 %}
        --sp-button-font-scale: {{ button_settings.button_scale_mobile | minus: 100.0 | divided_by: 2 | plus: 100 | divided_by: 100.0 }};
    {% endif %}
    {% if button_settings.button_scale_mobile < 100 %}
        --sp-button-font-scale: {{ 100.0 | minus: button_settings.button_scale_mobile | divided_by: 2 | plus: button_settings.button_scale_mobile | divided_by: 100.0 }};
    {% endif %}
}
@media(min-width: 992px){
    {{ button_selector }}{
        --sp-button-scale: {{ button_settings.button_scale | divided_by: 100.0 }};
        {% if button_settings.button_scale >= 100 %}
            --sp-button-font-scale: {{ button_settings.button_scale | minus: 100.0 | divided_by: 2 | plus: 100 | divided_by: 100.0 }};
        {% endif %}
        {% if button_settings.button_scale < 100 %}
            --sp-button-font-scale: {{ 100.0 | minus: button_settings.button_scale | divided_by: 2 | plus: button_settings.button_scale | divided_by: 100.0 }};
        {% endif %}
    }
}

                                                    #sp-{{ block.id }}.sp-button-wrapper {
                                                        --sp-button-margin-top: 0;
                                                        --sp-button-background-color: {{ setting.button_background_color | default: "transparent" }};
                                                        --sp-button-background-gradient-color: {{ setting.button_background_gradient_color | default: "null" }};
                                                    {% if setting.button_background_gradient_color != blank %} --sp-button-background-color: "transparent";
                                                    {% endif %} --sp-button-text-color: {{ setting.button_text_color | default: "transparent" }};
                                                    }
                                                    @media (max-width: 767px) {
                                                        #sp-{{ block.id }}.sp-button-wrapper .sp-short-text {
                                                            --sp-text-size: {{ setting.text_size_mobile }}px;
                                                        }
                                                    }
                                                </style>
                                                <a {% if setting.button_link == blank %} aria-disabled="true" {% else %}
                                                    href="{{ setting.button_link }}" {% endif %}
                                                    class="sp-button {{ setting.button_style | default: "sp-button-link" }}"
                                                    data-button-hover="{{ settings.button_hover }}"
                                                    data-text-style="{{ setting.button_text_style }}"
                                                >
                                                    {{ setting.button_text }}
                                                </a>
                                            </div>
                                        {% endif %}
                                    {% when 'rating_item' %}
                                        <div id="sp-{{ block.id }}"
                                             class="sp-rating-items" {{ block.shopify_attributes }}>
                                            <style>
                                                #sp-{{ block.id }}.sp-rating-items .sp-product-card-rating .sp-rating-star {
                                                    --sp-font-size-scale: {{ setting.rating_size_scale | divided_by: 100.0 }};
                                                    --sp-product-card-rating-color: {{ setting.rating_icon_color }};
                                                    --sp-color-foreground: {{ setting.rating_icon_foreground_color.red }}, {{ setting.rating_icon_foreground_color.green }},{{ setting.rating_icon_foreground_color.blue }};
                                                }

                                                #sp-{{ block.id }}.sp-rating-items .sp-rating-item__title {
                                                    --sp-text-size: {{ setting.text_size_desktop }}px;
                                                    --sp-text-letter-spacing: {{ setting.text_spacing }}px;
                                                    --sp-text-color: {{ setting.rating_text_color }};
                                                }

                                                @media (max-width: 767px) {
                                                    #sp-{{ block.id }}.sp-rating-items .sp-rating-item__title {
                                                        --sp-text-size: {{ setting.text_size_mobile }}px;
                                                    }
                                                }
                                            </style>
                                            <div class="sp-rating-item__star sp-product-card-rating">
                                                {% liquid
                                                    assign rating_decimal = 0
                                                    assign decimal = setting.rating | modulo: 1
                                                    if decimal >= 0.3 and decimal <= 0.7
                                                        assign rating_decimal = 0.5
                                                    elsif decimal > 0.7
                                                        assign rating_decimal = 1
                                                    endif
                                                %}
                                                <div class="sp-rating" role="img">
                                                    <span aria-hidden="true" class="sp-rating-star"
                                                          style="--sp-rating: {{ setting.rating | floor }}; --sp-rating-max: 5; --sp-rating-decimal: {{ rating_decimal }};"></span>
                                                </div>
                                            </div>
                                            {% if setting.rating_text != empty %}
                                                <h5 class="sp-rating-item__title"
                                                    data-text-style="{{ setting.text_style }}">{{ setting.rating_text }}</h5>
                                            {% endif %}
                                        </div>
                                {% endcase %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
{
	"name": "🧩 Image With Text 15.1",
	"tag": "section",
	"class": "sp-image-with-text-3",
	"settings": [
		{
			"type": "header",
			"content": "Section settings"
		},
		{
			"type": "image_picker",
			"id": "section_image",
			"label": "Image"
		},
		{
			"type": "range",
			"id": "content_max_width",
			"min": 300,
			"max": 1200,
			"step": 10,
			"unit": "px",
			"label": "Content max-width",
			"default": 760
		},
		{
			"type": "select",
			"id": "content_position",
			"label": "Content position",
			"options": [
				{
					"label": "Left",
					"value": "left"
				},
				{
					"label": "Center",
					"value": "center"
				},
				{
					"label": "Right",
					"value": "right"
				}
			],
			"default": "right"
		},
		{
			"type": "select",
			"id": "item_alignment",
			"label": "Item alignment (Desktop)",
			"options": [
				{
					"label": "Left",
					"value": "left"
				},
				{
					"label": "Center",
					"value": "center"
				},
				{
					"label": "Right",
					"value": "right"
				}
			],
			"default": "left"
		},
		{
			"type": "select",
			"id": "item_alignment_mobile",
			"label": "Item alignment (Mobile)",
			"options": [
				{
					"label": "Left",
					"value": "left"
				},
				{
					"label": "Center",
					"value": "center"
				},
				{
					"label": "Right",
					"value": "right"
				}
			],
			"default": "left"
		},
		{
			"type": "range",
			"id": "item_gap",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Items gap (Desktop)",
			"default": 30
		},
		{
			"type": "range",
			"id": "item_gap_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Items gap (Mobile)",
			"default": 10
		},
		{
			"type": "header",
			"content": "Effects"
		},
		{
			"type": "checkbox",
			"id": "lazy_load",
			"label": "Lazy load",
			"default": true
		},
		{
			"type": "select",
			"id": "button_hover",
			"label": "Button hover",
			"options": [
				{
					"label": "None",
					"value": "none"
				},
				{
					"label": "Fly",
					"value": "fly"
				},
				{
					"label": "Opacity",
					"value": "opacity"
				}
			],
			"default": "fly"
		},
		{
			"type": "select",
			"id": "image_hover",
			"label": "Image hover",
			"options": [
				{
					"label": "None",
					"value": "sp-image-hover-none"
				},
				{
					"label": "Zoom in",
					"value": "sp-image-hover-zoom-in"
				}
			],
			"default": "sp-image-hover-zoom-in"
		},
		{
			"type": "header",
			"content": "Image settings"
		},
		{
			"type": "select",
			"id": "image_position",
			"label": "Image position",
			"options": [
				{
					"label": "Left",
					"value": "sp-image-position-left"
				},
				{
					"label": "Right",
					"value": "sp-image-position-right"
				}
			],
			"default": "sp-image-position-right"
		},
		{
			"type": "range",
			"id": "image_ratio",
			"min": 0.3,
			"max": 2,
			"step": 0.1,
			"default": 1.5,
			"unit": ":1",
			"label": "Image ratio"
