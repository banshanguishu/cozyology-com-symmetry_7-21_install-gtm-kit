{% style %}
	#sp-{{section.id}}{position:relative}#sp-{{section.id}} .sp-section{background-color:var(--sp-section-background-color);background-image:var(--sp-section-background-gradient-color);padding-top:0;padding-bottom:0}#sp-{{section.id}} [data-icon-box-alignment=center] .sp-icon-box-item{justify-content:center}#sp-{{section.id}} [data-icon-box-alignment=center] .sp-icon-box-item .sp-description *{text-align:center}#sp-{{section.id}} [data-icon-box-alignment=right] .sp-icon-box-item{justify-content:flex-end}#sp-{{section.id}} [data-icon-box-alignment=right] .sp-icon-box-item .sp-description *{text-align:right}#sp-{{section.id}} .sp-text-wrapper{row-gap:var(--sp-item-gap);padding-top:var(--sp-section-top-padding);padding-bottom:var(--sp-section-bottom-padding)}#sp-{{section.id}} .sp-text-wrapper .sp-heading-item{row-gap:var(--sp-text-gap)}#sp-{{section.id}} .sp-text-wrapper .sp-heading-item .sp-heading *{color:var(--sp-heading-text-color);font-size:var(--sp-text-size);letter-spacing:var(--sp-text-letter-spacing)}#sp-{{section.id}} .sp-text-wrapper .sp-heading-item .sp-description *{color:var(--sp-description-text-color);font-size:var(--sp-text-size);letter-spacing:var(--sp-text-letter-spacing);opacity:.8}#sp-{{section.id}} .sp-text-wrapper .sp-icon-box[data-show-background=true] .sp-icon-box-item{background:var(--sp-icon-box-background-color);border-radius:var(--icon-box-border-radius)}#sp-{{section.id}} .sp-text-wrapper .sp-icon-box[data-show-background=true][data-show-border=true] .sp-icon-box-item{border:var(--icon-box-border-width) solid var(--icon-box-border-color)}#sp-{{section.id}} .sp-text-wrapper .sp-icon-box .sp-icon-item__icon{width:var(--icon-size)}#sp-{{section.id}} .sp-text-wrapper .sp-icon-box .sp-icon-box-item .sp-heading *{color:var(--sp-heading-text-color);font-size:var(--sp-text-size);letter-spacing:var(--sp-text-letter-spacing)}#sp-{{section.id}} .sp-text-wrapper .sp-icon-box .sp-icon-box-item .sp-description *{color:var(--sp-description-text-color);font-size:var(--sp-text-size);letter-spacing:var(--sp-text-letter-spacing);opacity:.8}#sp-{{section.id}} .sp-text-wrapper .sp-button-wrapper .sp-short-text *{color:var(--sp-short-text-color);font-size:var(--sp-text-size);letter-spacing:var(--sp-text-letter-spacing);opacity:.8}#sp-{{section.id}} .sp-text-wrapper .sp-rating-items .sp-rating-item__title{color:var(--sp-text-color);font-size:var(--sp-text-size);letter-spacing:var(--sp-text-letter-spacing);opacity:.8}
