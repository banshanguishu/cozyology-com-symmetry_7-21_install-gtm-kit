<div id="section-id-{{ section.id }}" style="background-color: #F9F6F4">
  <div class="cp-four-container">
    {% for block in section.blocks %}
      <div id="block-id-{{ block.id }}" class="cp-four-block {% if block.settings.right_image_left_text %}cp-four-block-row-reverse{% endif %}">
        <div class="cp-four-img-section">
          {%- render 'image' with block.settings.image
            , size_cols_desktop: 2
            , custom_aspect_ratio: block.settings.aspect_ratio
          -%}
        </div>
        <div class="cp-four-cot-section">
          <div class="cp-four-subtitle">{{ block.settings.sub_title }}</div>
          <h1 class="cp-four-title">{{ block.settings.title }}</h1>
          <div class="cp-four-split"></div>
          <div class="cp-four-description">{{ block.settings.description }}</div>
          {% if block.settings.shop_now_url %}
            <a
              href="{{block.settings.shop_now_url}}"
              target="_blank"
              class="cp-four-shopnow">Shop Now</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>


<style>
  .cp-four-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 50px 0;
    display: flex;
    flex-direction: column;
  }

  .cp-four-block {
    display: flex;
    column-gap: 40px;
  }

  .cp-four-block-row-reverse {
    flex-direction: row-reverse;
  }

  .cp-four-img-section {
    width: 400px;
  }

  .cp-four-cot-section {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .cp-four-subtitle {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 20px;
    color: #BBB3AB;
  }

  .cp-four-title {
    font-family: American_bt
    , Arial
    , sans-serif;
    color: #171717;
  }

  .cp-four-split {
    width: 100%;
    height: 1px;
    background: #DDDDDD;
    margin-bottom: 1em;
  }

  .cp-four-description {
    color: #171717;
  }


  .cp-four-shopnow {
    color: #171717;
    text-decoration: underline;
  }


  @media (max-width: 768px) {
    .cp-four-container {
      padding: 25px 15px;
    }

    .cp-four-block {
      flex-direction: column-reverse;
      margin-bottom: 15px;
    }

    .cp-four-img-section {
      width: 100%;
    }

    .cp-four-subtitle {
      position: relative;
    }

    .cp-four-split {
      margin-bottom: 10px;
    }

    .cp-four-shopnow {
      margin-bottom: 1em;
    }

  }
</style>

{% schema %}
  {
    "name": "Collaborations-Four",
    "tag": "section",
    "class": "Collaborations-Four",
    "settings": [],
    "blocks": [
      {
        "type": "group",
        "name": "Group",
        "limit": 50,
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "Select the main image"
          },
          {
            "type": "select",
            "id": "aspect_ratio",
            "label": "Image Aspect Ratio",
            "default": "1.3",
            "options": [
              {
                "value": "1.3",
                "label": "1.3"
              }, {
                "value": "0.8",
                "label": "0.8"
              }
            ]
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Please enter title here"
          },
          {
            "type": "text",
            "id": "sub_title",
            "label": "Sub Title",
            "default": "Please enter subtitle here"
          }, {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Description right here </p>"
          }, {
            "type": "url",
            "id": "shop_now_url",
            "label": "Shop Now URL",
            "info": "Please input shop now url here"
          }, {
            "type": "checkbox",
            "id": "right_image_left_text",
            "label": "右图左字",
            "default": false
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Collaborations-Four",
        "category": "Collaborations-Project"
      }
    ]
  }
{% endschema %}