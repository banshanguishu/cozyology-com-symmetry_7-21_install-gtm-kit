ction-heading-size)}#sp-{{section.id}} .sp-section .sp-images-collection-items .sp-collection-block-content .sp-images-collection-heading .sp-image-collection-description{color:var(--sp-section-description);font-size:var(--sp-section-collection-description-size)}@media(max-width: 768px){#sp-{{section.id}} .sp-section .sp-images-collection-items{flex-direction:column}#sp-{{section.id}} .sp-section .sp-images-collection-items .sp-block-image-background{width:100%;order:2}#sp-{{section.id}} .sp-section .sp-images-collection-items .sp-collection-block-content{width:100%;order:1;padding:0}}
