			]
		},
		{
			"name": "Image",
			"type": "image",
			"limit": 1,
			"settings": [
				{
					"type": "image_picker",
					"id": "image_background",
					"label": "Image"
				}
			]
		}
	],
	"presets": [
		{
			"name": "🧩 FAQ 3.1",
			"settings": {
				"block_image_max_width": 100,
				"image_radius": 0,
				"image_ratio": 1,
				"heading_alignment": "sp-heading-alignment-left",
				"heading_size_desktop": 48,
				"heading_size_mobile": 32,
				"questions_radius": 0,
				"question_font_size_desktop": 18,
				"question_font_size_mobile": 15,
				"answer_font_size_desktop": 16,
				"answer_font_size_mobile": 14,
				"text_heading_spacing": 0,
				"show_box_shadow": false,
				"section_width": "full_width",
				"section_top_padding": 100,
				"section_bottom_padding": 100,
				"section_border": false,
				"lazy_load": false,
				"section_background_color": "#ffffff",
				"section_background_gradient_color": "",
				"heading_text_color": "#121212",
				"question_border": "#121212",
				"question_block_question_color": "#121212",
				"question_block_answer_color": "#1e1e1e",
				"override_font": true,
				"heading_font": "futura_n7",
				"body_font": "futura_n4"
			},
			"blocks": [
				{
					"type": "heading_item",
					"settings": {
						"heading": "Questions to Turn Your Dream Home into Reality!"
					}
				},
				{
					"type": "image",
					"settings": {
						"image_background": "shopify://shop_images/faq-3-variant-1-image-01.png"
					}
				},
				{
					"type": "question_item",
					"settings": {
						"question": "<strong>How can I choose the right furniture size for my space?</strong>",
						"answer": "<p>We provide detailed guides and online measurement tools to help you select the right furniture size. You can also contact us for free consultation.</p>"
					}
				},
				{
					"type": "question_item",
					"settings": {
						"question": "<strong>How long does it take to deliver the furniture?</strong>",
						"answer": "<p>Delivery times typically range from 3-7 business days, depending on your location and the type of product ordered. We will provide specific delivery details once your order is confirmed.</p>"
					}
				},
				{
					"type": "question_item",
					"settings": {
						"question": "<strong>Can I request custom furniture designs?</strong>",
						"answer": "<p>Yes, we offer custom furniture design and production services based on customer requests. Simply provide the details of your idea and desired dimensions, and our design team will bring it to life.</p>"
					}
				},
				{
					"type": "question_item",
					"settings": {
						"question": "<strong>What is your return policy?</strong>",
						"answer": "<p>We accept product returns within 7 days if there are any manufacturing defects or if the wrong item was delivered. The product must remain in its original condition without any damage.</p>"
					}
				},
				{
					"type": "question_item",
					"settings": {
						"question": "<strong>Can I place an order online and pay upon delivery?</strong>",
						"answer": "<p>Yes, you can order online and choose the option to pay upon delivery. We accept both cash and electronic payment methods.</p>"
					}
				},
				{
					"type": "question_item",
					"settings": {
						"question": "<strong>Do your furniture products come with a warranty?</strong>",
						"answer": "<p>All our furniture products come with a warranty ranging from 1 to 2 years, depending on the product type. You will receive detailed warranty information upon purchase.</p>"
					}
				}
			]
		}
	]
}
{% endschema %}

{% style %}
