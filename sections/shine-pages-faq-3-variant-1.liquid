  .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item .sp-faq-question-heading .sp-control-group .sp-icon-toggle-active-question svg path {
    fill: var(--sp-question-color)
  }#sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item .sp-faq-question-content {
    overflow: hidden;
    transition: all 0.3s ease-in-out
  }#sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item .sp-faq-question-content .sp-inner-content * {
    padding-top: 10px;
    font-size: var(--sp-answer-size-desktop);
    color: var(--sp-answers-color)
  }#sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item.active .sp-control-group .sp-icon-toggle-active-question svg {
    transform: rotate(-180deg);
    transition: all 0.3s ease-in-out
  }#sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item.active .sp-faq-question-content {
    transition: all 0.3s ease-in-out
  }
  @media(max-width: 769px) {
    #sp-{{ section.id }} .sp-faq-wrapper {
      flex-direction: column;
      gap: 10px;
    }#sp-{{ section.id }}
    .sp-faq-wrapper .sp-faq-image {
      width: 100%
    }#sp-{{ section.id }}
    .sp-faq-wrapper .sp-faq-questions {
      width: 100%;
      gap: 0 !important;
    }#sp-{{ section.id }}
    .sp-faq-wrapper .sp-faq-questions .sp-faq-heading .sp-heading-outer {
      padding: 20px 0;
    }#sp-{{ section.id }}
    .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item {
      padding: 20px 0;
    }
  }
{% endstyle %}
