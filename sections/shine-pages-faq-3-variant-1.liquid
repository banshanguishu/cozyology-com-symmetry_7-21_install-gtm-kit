    border-radius: var(--sp-questions-border-radius)
  }#sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item .sp-faq-question-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    cursor: pointer
  }#sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item .sp-faq-question-heading .sp-faq-question-heading-text {
    font-size: var(--sp-question-size-desktop);
    color: var(--sp-question-color)
  }#sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item .sp-faq-question-heading .sp-faq-question-heading-text strong {
    font-weight: 600
  }#sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item .sp-faq-question-heading .sp-control-group .sp-icon-toggle-active-question {
    width: 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center
  }#sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-questions .sp-faq-content .sp-faq-question-item .sp-faq-question-heading .sp-control-group .sp-icon-toggle-active-question svg {
