    border-bottom: 1px solid var(--sp-question-border-color)
  }#sp-{{ section.id }}
  .sp-faq-wrapper {
    margin: auto;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 35px;
  }#sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-image {
    order: 2;
  } #sp-{{ section.id }}
  .sp-faq-wrapper .sp-faq-questions {
    order: 1;
  }
  @media (max-width: 769px) {
    #sp-{{ section.id }} .sp-faq-wrapper .sp-faq-image {
      order: 1;
    } #sp-{{ section.id }}
