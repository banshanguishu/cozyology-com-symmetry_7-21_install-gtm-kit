{% style %}
	#sp-{{section.id}} .sp-section{background:var(--sp-section-background-color) var(--sp-section-background-gradient-color)}#sp-{{section.id}} .sp-section-inner{display:flex;flex-direction:column}#sp-{{section.id}} .sp-heading-wrapper{--sp-heading-margin-top: 1rem;--sp-sub-heading-margin-top: 1rem;--sp-description-margin-top: 2rem}#sp-{{section.id}} .sp-collection-list-items{position:relative}#sp-{{section.id}} .sp-card{height:100%;aspect-ratio:calc(var(--sp-image-aspect-ratio)/1)}#sp-{{section.id}} .sp-card-media{overflow:hidden;display:flex;width:100%;height:100%;aspect-ratio:0;border-radius:var(--sp-image-border-radius);border:var(--sp-card-border-width) solid var(--sp-card-border-color)}#sp-{{section.id}} .sp-content-wrapper{padding:5rem}#sp-{{section.id}} .sp-heading *{font-size:var(--sp-text-size);color:var(--sp-heading-text-color);font-weight:var(--sp-heading-font-weight);line-height:var(--sp-heading-line-height);font-family:var(--sp-heading-font-family);letter-spacing:var(--sp-text-letter-spacing)}#sp-{{section.id}} .sp-description *{margin-top:1rem;font-weight:var(--sp-body-font-weight);line-height:var(--sp-description-line-height);font-family:var(--sp-body-font-family);color:var(--sp-description-text-color);font-size:var(--sp-text-size);letter-spacing:var(--sp-text-letter-spacing)}#sp-{{section.id}} .sp-section .sp-heading-outer+sp-swiper{margin-top:calc(5rem*var(--sp-margin-scale))}@media(min-width: 768px){#sp-{{section.id}} .sp-collection-list-items{display:grid;grid-template-columns:repeat(2, 1fr);grid-gap:var(--sp-item-gap)}#sp-{{section.id}} .sp-collection-list-items[data-column="5"]{grid-template-columns:repeat(3, 1fr)}#sp-{{section.id}} .sp-card:first-child{grid-row:1/3;grid-column:1;aspect-ratio:0}#sp-{{section.id}} .sp-card{height:100%}}@media(max-width: 1199px){#sp-{{section.id}} .sp-content-wrapper{padding:3rem}}@media(max-width: 767px){#sp-{{section.id}} .sp-content-wrapper{padding:2rem}#sp-{{section.id}} .sp-collection-list-items.sp-swiper-slides{flex-wrap:nowrap;gap:var(--sp-item-gap)}#sp-{{section.id}} .sp-collection-list-items.sp-swiper-slides .sp-collection-list-item{flex:0 0 auto;width:70%}}
