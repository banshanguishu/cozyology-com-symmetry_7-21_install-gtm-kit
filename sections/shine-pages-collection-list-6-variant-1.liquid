{% comment %} Variables  {% endcomment %}
{% assign settings = section.settings %}
<style>
    {% comment %}
    Render heading & body font family
{% endcomment %}
{%- if settings.override_font != blank -%}
    {%- capture font_settings_list -%}
        {{ settings.heading_font | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.heading_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
        {{ settings.body_font | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.body_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }};;
        {{ settings.hightlight_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }};;
    {%- endcapture -%}
    {%- assign font_array = font_settings_list | split: ';;' -%}
{% endif %}
{%- if settings.override_font != blank -%}
    {%- for font in font_array -%}
        {%- unless font contains 'error' -%}
            {{ font }}{%- endunless -%}
    {%- endfor -%}
    #sp-{{ section.id }} {
    --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
    --sp-heading-font-weight: {{ settings.heading_font.weight }};
    --sp-heading-font-style: {{ settings.heading_font.style }};
    --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
    --sp-body-font-weight: {{ settings.body_font.weight }};
    --sp-body-font-style: {{ settings.body_font.style }};
    --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
    --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
    --sp-highlight-font-style: {{ settings.highlight_font.style }};
    }
    {% if custom_selector != blank %}
        {{ custom_selector }} {
        --sp-heading-font-family: {{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }};
        --sp-heading-font-weight: {{ settings.heading_font.weight }};
        --sp-heading-font-style: {{ settings.heading_font.style }};
        --sp-body-font-family: {{ settings.body_font.family }},{{ settings.body_font.fallback_families }};
        --sp-body-font-weight: {{ settings.body_font.weight }};
        --sp-body-font-style: {{ settings.body_font.style }};
        --sp-highlight-font-family: {{ settings.highlight_font.family }},{{ settings.highlight_font.fallback_families }};
        --sp-highlight-font-weight: {{ settings.highlight_font.weight }};
        --sp-highlight-font-style: {{ settings.highlight_font.style }};
        }
    {% endif %}
{% endif %}
    {% comment %}
    Render padding section, heading content max width
{% endcomment %}

    #sp-{{ section.id }} .sp-section {
    {% if settings.section_top_padding_mobile and  settings.section_bottom_padding_mobile %}
        --sp-section-top-padding: {{ settings.section_top_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding_mobile | divided_by: 10.0 | round: 0 }}rem;
    {% else %}
        --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
        --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.5 | round: 0 }}rem;
    {% endif %}
        }

    @media (min-width: 768px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | times: 0.7 | round: 0 }}rem;
        }
    }

    @media (min-width: 1260px) {
        #sp-{{ section.id }} .sp-section {
            --sp-section-top-padding: {{ settings.section_top_padding | divided_by: 10.0 | round: 0 }}rem;
            --sp-section-bottom-padding: {{ settings.section_bottom_padding | divided_by: 10.0 | round: 0 }}rem;
        }
    }

    #sp-{{ section.id }} {
        --sp-section-background-color: {{ settings.section_background_color | default: "transparent" }};
        --sp-section-background-gradient-color: {{ settings.section_background_gradient_color }};
    }
    #sp-{{ section.id }} .sp-collection-list-items {
        --sp-item-gap: {{ settings.item_gap }}px;
    }
    #sp-{{ section.id }} .sp-collection-list-items .sp-card {
        --sp-image-aspect-ratio: {{ settings.image_ratio }};
        --sp-image-border-radius: {{ settings.collection_image_border_radius }}px;
        --sp-card-border-width: {{ settings.collection_border_width }}px;
        --sp-card-border-color: {{settings.collection_border_color }}

    }
    #sp-{{ section.id }} .sp-heading-wrapper {
        --sp-section-heading-width: 65rem;
        max-width: var(--sp-section-heading-width);
    }
    @media(max-width:767px) {
        #sp-{{ section.id }} .sp-collection-list-items .sp-card {
            --sp-image-aspect-ratio: {{ settings.image_ratio_mobile }};
        }
        #sp-{{ section.id }} .sp-collection-list-items {
            --sp-item-gap: {{ settings.item_gap_mobile }}px;
        }
    }

</style>
<div id="sp-{{ section.id }}" class="sp-{{ section.id }} sp-section-collection-list-6" data-section="collection-list-6"
     data-variant="variant-1">
    <div class="sp-section" data-border="{{ settings.section_border }}">
        <div class="{% case settings.section_width %}{% when 'boxed' %}sp-container{% when 'full_width' %}sp-container-fluid{% else %}sp-container-fluid sp-container-no-gap{% endcase %}">
            <div class="sp-section-inner" data-lazy="sp-{% if settings.lazy_load %}lazy-section{% endif %}"
                 data-cascade>
                {% assign heading_block = section.blocks | where: 'type', 'heading_item' %}
                {% for block in heading_block %}
                    {% assign setting = block.settings %}
                    <style>
                        {% assign heading_settings = block.settings %}
                        {% assign heading_selector = section.id | prepend:"#sp-" | append:" .sp-heading-wrapper" %}
                        
    {{ heading_selector }} {
        --sp-section-heading-size: {{ heading_settings.heading_size_mobile }}px;
        --sp-section-description-size: {{ heading_settings.description_size_mobile }}px;
        --sp-heading-letter-spacing: {{ heading_settings.text_heading_spacing | default: 0 }}px;
        --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 | times: 0.6 }};

    }
    @media (min-width: 768px) {
        {{ heading_selector }} {
            --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 | times: 0.8 }};
            --sp-section-heading-size: {{ heading_settings.heading_size_desktop | times: 0.8 }}px;
            --sp-section-description-size: max({{ heading_settings.description_size_desktop | times: 0.8 }}px, {{ heading_settings.description_size_mobile }}px);
        }
    }

    @media (min-width: 1200px) {
        {{ heading_selector }} {
            --sp-heading-spacing-scale: {{ heading_settings.heading_spacing_scale | divided_by: 100.0 }};
            --sp-section-heading-size: {{ heading_settings.heading_size_desktop }}px;
            --sp-section-description-size: {{ heading_settings.description_size_desktop }}px;
        }
    }

                    </style>
                    <div class="sp-heading-outer {{ setting.heading_position }}" {{ block.shopify_attributes }}>
                        <div class="sp-heading-wrapper"
                             style="--sp-section-heading-width: {{ setting.heading_max_width | divided_by: 10.0 }}rem">
                            <style>
                                #sp-{{ section.id }} .sp-heading-wrapper  .sp-heading {
                                    --sp-text-size: {{ setting.heading_size_desktop }}px;
                                    --sp-text-letter-spacing: {{ setting.text_heading_spacing }}px;
                                    --sp-heading-text-color: {{ setting.heading_text_color }}
                                }
                                @media (max-width: 767px) {
                                    #sp-{{ section.id }} .sp-heading-wrapper .sp-heading {
                                        --sp-text-size: {{ setting.heading_size_mobile }}px;
                                    }
                                }
                            </style> 
                            {% if setting.heading != empty %}
                                <div class="sp-heading"
                                     data-text-style="{{ setting.heading_text_style }}">{{ setting.heading }}</div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
                {% assign collection_block = section.blocks | where: 'type', 'collection_item' %}
                {% if collection_block.size > 0 %}
                    <sp-swiper>
                        <div class="sp-collection-list-items sp-swiper-slides"
                        data-column="{% if collection_block.size > 3 %}5{% else %}3{% endif %}">
                           {% for block in collection_block %}
                            {% assign setting = block.settings %}
                            <div id="sp-{{ block.id }}" class="sp-collection-list-item sp-card sp-swiper-slide-item"
                                data-card-style="text-on-image"
                                data-image-hover="{{ settings.image_hover }}" {{ block.shopify_attributes }}>
                                <div class="sp-card-media">
                                    {% if setting.collection_image != null %}
                                        {% if settings.lazy_load %}
                                            <img class="sp-image lazy"
                                                 src=""
                                                 data-src="{{ setting.collection_image | image_url: width: 1920 }}"
                                                 alt="{{ setting.collection_image.alt | default: "" }}">
                                        {% else %}
                                            {{ setting.collection_image | image_url: width: 1920 | image_tag: class: 'sp-image' }}
                                        {% endif %}
                                    {% else %}
                                        {{ 'image' | placeholder_svg_tag: "sp-placeholder-image-gray-100" }}
                                    {% endif %}
                                    <div class="sp-background-overlay" style="
                                        --sp-card-background-overlay-color: {{ settings.collection_overlay_color }};
                                        "></div>
                                </div>
                                <div class="sp-card-detail {{ settings.content_position }}">
                                    <div class="sp-content-wrapper {{ settings.content_alignment }}">
                                        <style>
                                            #sp-{{ section.id }} .sp-content-wrapper {
                                                --sp-heading-text-color: {{ settings.collection_heading_color }};
                                                --sp-description-text-color: {{ settings.collection_description_color }};
                                            }

                                            #sp-{{ block.id }} .sp-content-wrapper .sp-heading {
                                                --sp-heading-margin-top: 0;
                                                --sp-text-size: {{ setting.heading_size_desktop }}px;
                                                --sp-text-letter-spacing: {{ setting.text_heading_spacing }}px;
                                                
                                            }

                                            #sp-{{ block.id }} .sp-content-wrapper .sp-description {
                                                --sp-text-size: {{ setting.description_size_desktop }}px;
                                                --sp-text-letter-spacing: {{ setting.text_description_spacing }}px;
                                                
                                            }

                                            @media (max-width: 767px) {

                                                #sp-{{ block.id }} .sp-content-wrapper .sp-heading {
                                                    --sp-text-size: {{ setting.heading_size_mobile }}px;
                                                }

                                                #sp-{{ block.id }} .sp-content-wrapper .sp-description {
                                                    --sp-text-size: {{ setting.description_size_mobile }}px;
                                                }
                                            }
                                        </style>
                                        {% if setting.heading != empty %}
                                            <div class="sp-heading"
                                                 data-text-style="{{ setting.heading_text_style }}">{{ setting.heading }}</div>
                                        {% endif %}
                                        {% if setting.description != empty %}
                                            <div class="sp-description"
                                                 data-text-style="{{ setting.description_text_style }}">{{ setting.description }}</div>
                                        {% endif %}
                                        {% if setting.button_text != blank %}
                                                <div class="sp-button-wrapper">
                                                    {% assign button_selector = section.id | append: " .sp-button-wrapper .sp-button" | prepend: "#sp-" %}
                                                    {% assign button_settings = block.settings %}
                                                    <style>
                                                        {% comment %}
    Render button style variables
    Pass button selector to apply
{% endcomment %}
{{ button_selector }}{
    --sp-button-border-width:{{ button_settings.button_border_width | append:"px" }};
    --sp-button-radius: {{ button_settings.button_radius | append:"px" }};
    --sp-button-text-spacing: {{ button_settings.button_text_spacing | append:"px" }};
    --sp-button-scale: {{ button_settings.button_scale_mobile | divided_by: 100.0 }};
    {% if button_settings.button_scale_mobile >= 100 %}
        --sp-button-font-scale: {{ button_settings.button_scale_mobile | minus: 100.0 | divided_by: 2 | plus: 100 | divided_by: 100.0 }};
    {% endif %}
    {% if button_settings.button_scale_mobile < 100 %}
        --sp-button-font-scale: {{ 100.0 | minus: button_settings.button_scale_mobile | divided_by: 2 | plus: button_settings.button_scale_mobile | divided_by: 100.0 }};
    {% endif %}
}
@media(min-width: 992px){
    {{ button_selector }}{
        --sp-button-scale: {{ button_settings.button_scale | divided_by: 100.0 }};
        {% if button_settings.button_scale >= 100 %}
            --sp-button-font-scale: {{ button_settings.button_scale | minus: 100.0 | divided_by: 2 | plus: 100 | divided_by: 100.0 }};
        {% endif %}
        {% if button_settings.button_scale < 100 %}
            --sp-button-font-scale: {{ 100.0 | minus: button_settings.button_scale | divided_by: 2 | plus: button_settings.button_scale | divided_by: 100.0 }};
        {% endif %}
    }
}

                                                        #sp-{{ section.id }} .sp-content-wrapper .sp-button-wrapper {
                                                            margin-top: 2rem;
                                                            --sp-button-background-color: {{ settings.button_collection_background_color | default: "transparent" }};
                                                            --sp-button-background-gradient-color: {{ settings.button_collection_background_gradient_color | default: "null" }};
                                                        {% if settings.button_collection_background_gradient_color != blank %} --sp-button-background-color: "transparent";
                                                        {% endif %} --sp-button-text-color: {{ settings.button_collection_text_color | default: "transparent" }};
                                                        }
                                                        @media(max-width:767px) {
                                                            #sp-{{ section.id }} .sp-content-wrapper .sp-button-wrapper {
                                                                margin-top: 1rem;
                                                            }
                                                        }

                                                    </style>
                                                    <a {% if setting.button_link == blank %} aria-disabled="true" {% else %}
                                                        href="{{ setting.button_link }}" {% endif %}
                                                            class="sp-button {{ setting.button_style | default: "sp-button-link" }}"
                                                            data-button-hover="{{ settings.button_hover }}"
                                                            data-text-style="{{ setting.button_text_style }}">{{ setting.button_text }}</a>   
                                                </div>
                                            {% endif %}
                                   </div>
                                </div>
                            </div>
                           {% endfor %}
                       </div>
                    </sp-swiper>
                    
                {% endif %}    
                

            </div>
        </div>
    </div>
</div>
{% schema %}
{
	"name": "🧩 Collection List 6.1",
	"tag": "section",
	"class": "sp-collection-list-6",
	"settings": [
		{
			"type": "header",
			"content": "Section padding"
		},
		{
			"type": "select",
			"id": "section_width",
			"label": "Content section width",
			"options": [
				{
					"label": "Boxed",
					"value": "boxed"
				},
				{
					"label": "Full width",
					"value": "full_width"
				},
				{
					"label": "Full width no gap",
					"value": "full_width_no_gap"
				}
			]
		},
		{
			"type": "range",
			"id": "section_top_padding",
			"min": 0,
			"max": 150,
			"step": 10,
			"unit": "px",
			"label": "Top padding (Desktop)",
			"default": 100
		},
		{
			"type": "range",
			"id": "section_bottom_padding",
			"min": 0,
			"max": 150,
			"step": 10,
			"unit": "px",
			"label": "Bottom padding (Desktop)",
			"default": 100
		},
		{
			"type": "range",
			"id": "section_top_padding_mobile",
			"min": 0,
			"max": 150,
			"step": 10,
			"unit": "px",
			"label": "Top padding (Mobile)",
			"default": 50
		},
		{
			"type": "range",
			"id": "section_bottom_padding_mobile",
			"min": 0,
			"max": 150,
			"step": 10,
			"unit": "px",
			"label": "Bottom padding (Mobile)",
			"default": 50
		},
		{
			"type": "checkbox",
			"id": "section_border",
			"label": "Separate section with border",
			"default": false
		},
		{
			"type": "header",
			"content": "Collection item settings"
		},
		{
			"type": "range",
			"id": "image_ratio",
			"min": 0.3,
			"max": 2,
			"step": 0.1,
			"default": 1.5,
			"unit": ":1",
			"label": "Image ratio (Desktop)"
		},
		{
			"type": "range",
			"id": "image_ratio_mobile",
			"min": 0.3,
			"max": 2,
			"step": 0.1,
			"default": 0.9,
			"unit": ":1",
			"label": "Image ratio (Mobile)"
		},
		{
			"type": "range",
			"id": "collection_image_border_radius",
			"min": 0,
			"max": 60,
			"step": 1,
			"default": 30,
			"unit": "px",
			"label": "Image border radius"
		},
		{
			"type": "range",
			"id": "collection_border_width",
			"min": 0,
			"max": 20,
			"step": 1,
			"unit": "px",
			"label": "Border size collection item",
			"default": 0
		},
		{
			"type": "range",
			"id": "item_gap",
			"min": 0,
			"max": 50,
			"step": 1,
			"unit": "px",
			"label": "Item gap (Desktop)",
			"default": 30
		},
		{
			"type": "range",
			"id": "item_gap_mobile",
			"min": 0,
			"max": 50,
			"step": 1,
			"unit": "px",
			"label": "Item gap (Mobile)",
			"default": 16
		},
		{
			"type": "select",
			"id": "content_position",
			"label": "Content position",
			"default": "sp-content-alignment-bottom-left",
			"options": [
				{
					"label": "Top Left",
					"value": "sp-content-alignment-top-left"
				},
				{
					"label": "Top Center",
					"value": "sp-content-alignment-top-center"
				},
				{
					"label": "Top Right",
					"value": "sp-content-alignment-top-right"
				},
				{
					"label": "Middle Left",
					"value": "sp-content-alignment-middle-left"
				},
				{
					"label": "Middle Center",
					"value": "sp-content-alignment-middle-center"
				},
				{
					"label": "Middle Right",
					"value": "sp-content-alignment-middle-right"
				},
				{
					"label": "Bottom Left",
					"value": "sp-content-alignment-bottom-left"
				},
				{
					"label": "Bottom Center",
					"value": "sp-content-alignment-bottom-center"
				},
				{
					"label": "Bottom Right",
					"value": "sp-content-alignment-bottom-right"
				}
			]
		},
		{
			"type": "select",
			"id": "content_alignment",
			"label": "Content alignment",
			"default": "sp-content-text-left",
			"options": [
				{
					"label": "Left",
					"value": "sp-content-text-left"
				},
				{
					"label": "Center",
					"value": "sp-content-text-center"
				},
				{
					"label": "Right",
					"value": "sp-content-text-right"
				}
			]
		},
		{
			"type": "header",
			"content": "Effects"
		},
		{
			"type": "checkbox",
			"id": "lazy_load",
			"label": "Lazy load",
			"default": true
		},
		{
			"type": "select",
			"id": "image_hover",
			"label": "Image hover",
			"options": [
				{
					"label": "None",
					"value": "sp-image-hover-none"
				},
				{
					"label": "Zoom in",
					"value": "sp-image-hover-zoom-in"
				}
			],
			"default": "sp-image-hover-none"
		},
		{
			"type": "select",
			"id": "button_hover",
			"label": "Button hover",
			"options": [
				{
					"label": "None",
					"value": "none"
				},
				{
					"label": "Fly",
					"value": "fly"
				},
				{
					"label": "Opacity",
					"value": "opacity"
				}
			],
			"default": "fly"
		},
		{
			"type": "header",
			"content": "Section color"
		},
		{
			"type": "color",
			"id": "section_background_color",
			"label": "Background",
			"default": "#FFF"
		},
		{
			"type": "color_background",
			"id": "section_background_gradient_color",
			"label": "Background gradient"
		},
		{
			"type": "header",
			"content": "Collection item color"
		},
		{
			"type": "color",
			"id": "collection_heading_color",
			"label": "Heading text",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "collection_description_color",
			"label": "Description text",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "button_collection_background_color",
			"label": "Button background",
			"default": "#FFFFFF"
		},
		{
			"type": "color_background",
			"id": "button_collection_background_gradient_color",
			"label": "Button background gradient"
		},
		{
			"type": "color",
			"id": "button_collection_text_color",
			"label": "Button text",
			"default": "#222222"
		},
		{
			"type": "color_background",
			"id": "collection_overlay_color",
			"label": "Overlay image",
			"default": "linear-gradient(0deg, rgba(0, 0, 0, 0.20) 0%, rgba(0, 0, 0, 0.20) 100%)"
		},
		{
			"type": "color",
			"id": "collection_border_color",
			"label": "Border",
			"default": "#BC7A7A"
		},
		{
			"type": "header",
			"content": "Typography"
		},
		{
			"type": "checkbox",
			"id": "override_font",
			"label": "Override fonts of the theme",
			"default": true,
			"info": "If you check this option, the fonts of the section will work"
		},
		{
			"type": "font_picker",
			"id": "heading_font",
			"label": "Heading font",
			"default": "poppins_n7"
		},
		{
			"type": "font_picker",
			"id": "body_font",
			"label": "Body font",
			"default": "poppins_n5"
		}
	],
	"blocks": [
		{
			"name": "Heading",
			"type": "heading_item",
			"limit": 1,
