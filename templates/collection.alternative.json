        "full_width": true,
        "show_space": false,
        "code": "{% if collection.handle == 'free-swatches' %}\n<section class=\"czm-swatches-help\" aria-labelledby=\"czm-swatches-help-title\">\n  <div class=\"czm-swatches-help__head\">\n    <p>After the swatches arrive</p>\n    <h2 id=\"czm-swatches-help-title\">Turn your favorites into a plan.</h2>\n  </div>\n  <div class=\"czm-swatches-help__list\">\n    <a href=\"/collections/swatch-boxes\" class=\"czm-swatches-help__row\">\n      <span class=\"czm-swatches-help__number\">01</span>\n      <span class=\"czm-swatches-help__copy\"><strong>Browse curated sample boxes</strong><small>Explore grouped colors and materials.</small></span>\n      <span class=\"czm-swatches-help__arrow\" aria-hidden=\"true\">→</span>\n    </a>\n    <a href=\"/collections/all\" class=\"czm-swatches-help__row\">\n      <span class=\"czm-swatches-help__number\">02</span>\n      <span class=\"czm-swatches-help__copy\"><strong>Return to the full catalog</strong><small>Compare drapery, shades, hardware and motorization.</small></span>\n      <span class=\"czm-swatches-help__arrow\" aria-hidden=\"true\">→</span>\n    </a>\n    <a href=\"/products/complimentary-1-on-1-zoom-consultation\" class=\"czm-swatches-help__row\">\n      <span class=\"czm-swatches-help__number\">03</span>\n      <span class=\"czm-swatches-help__copy\"><strong>Ask a material expert</strong><small>Get complimentary help narrowing fabrics and shades.</small></span>\n      <span class=\"czm-swatches-help__arrow\" aria-hidden=\"true\">→</span>\n    </a>\n  </div>\n  <div class=\"czm-swatches-help__support\">\n    <span><strong>Need a second opinion?</strong> Send photos and swatch names and we’ll help narrow the choices.</span>\n    <a href=\"mailto:info@cozyology.com\">Email us</a>\n  </div>\n</section>\n<style>\n  .czm-swatches-help { display: none; }\n  @media (max-width: 767px) {\n    .czm-swatches-help {\n      display: block;\n      padding: 38px 18px 34px;\n      color: rgb(var(--body-text-color));\n      background: #fff;\n    }\n    .czm-swatches-help__head > p {\n      margin: 0 0 7px;\n      color: #7a6254;\n      font: 700 11px/1.2 var(--base-font-family);\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n    .czm-swatches-help h2 {\n      margin: 0 0 22px;\n      color: rgb(var(--body-heading-color));\n      font: var(--heading-font-weight) 29px/1.12 var(--heading-font-family);\n      letter-spacing: -.015em;\n      text-transform: none;\n    }\n    .czm-swatches-help__list { border-top: 1px solid rgba(23,23,23,.15); }\n    .czm-swatches-help__row {\n      display: grid;\n      grid-template-columns: 30px minmax(0,1fr) 24px;\n      gap: 10px;\n      align-items: center;\n      min-height: 88px;\n      border-bottom: 1px solid rgba(23,23,23,.15);\n      color: inherit !important;\n      background: transparent !important;\n      background-image: none !important;\n      text-decoration: none !important;\n    }\n    .czm-swatches-help__row::before,\n    .czm-swatches-help__row::after,\n    .czm-swatches-help__support a::before,\n    .czm-swatches-help__support a::after { display: none !important; }\n    .czm-swatches-help__number {\n      align-self: start;\n      padding-top: 23px;\n      color: #9b8d83;\n      font-size: 11px;\n      font-weight: 700;\n    }\n    .czm-swatches-help__copy {\n      display: flex;\n      flex-direction: column;\n      padding: 17px 0;\n    }\n    .czm-swatches-help__copy strong {\n      color: rgb(var(--body-heading-color));\n      font-size: 15px;\n      line-height: 1.25;\n    }\n    .czm-swatches-help__copy small {\n      margin-top: 5px;\n      color: #66615d;\n      font-size: 12px;\n      line-height: 1.35;\n    }\n    .czm-swatches-help__arrow { font-size: 21px; line-height: 1; text-align: right; }\n    .czm-swatches-help__support {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 23px;\n      padding: 15px;\n      border: 1px solid rgba(23,23,23,.14);\n      border-radius: 8px