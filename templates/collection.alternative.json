        "full_width": true,
        "show_space": false,
        "code": "{% if collection.handle == 'free-swatches' %}\n<div class=\"czm-swatches\">\n  <section class=\"czm-swatches__hero\" aria-labelledby=\"czm-swatches-title\">\n    <img class=\"czm-swatches__hero-image\" src=\"{{ images['free_swatches_crush.webp'] | image_url: width: 1000 }}\" alt=\"A curated range of Cozyology fabric swatches\" width=\"1000\" height=\"1000\" loading=\"eager\">\n    <div class=\"czm-swatches__hero-shade\"></div>\n    <div class=\"czm-swatches__hero-content\">\n      <p class=\"czm-swatches__eyebrow\">Free fabric swatches</p>\n      <h1 id=\"czm-swatches-title\">Choose Up to 20 Free Swatches</h1>\n    </div>\n  </section>\n\n  <section class=\"czm-swatches__body\">\n    <div class=\"czm-swatches__proof\">\n      <span><strong>Up to 20</strong><small>free swatches</small></span>\n      <span><strong>$9.99 shipping</strong><small>charged at checkout</small></span>\n      <span><strong>$10</strong><small>coupon included</small></span>\n    </div>\n    <div class=\"czm-swatches__perk\" role=\"note\">\n      <span class=\"czm-swatches__perk-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" role=\"presentation\"><rect x=\"5.5\" y=\"10\" width=\"13\" height=\"10\" rx=\"2\"></rect><path d=\"M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10\"></path></svg>\n      </span>\n      <span class=\"czm-swatches__perk-copy\">\n        <strong>Swatch customer perk</strong>\n        <small>Unlock up to 29% off custom drapes & shades.</small>\n      </span>\n    </div>\n  </section>\n</div>\n<style>\n  .czm-swatches { display: none; }\n\n  @media (max-width: 767px) {\n    [id$=\"__rich_text_9r8pca\"] { display: none !important; }\n\n    .czm-swatches {\n      display: block;\n      overflow: hidden;\n      color: rgb(var(--body-text-color));\n      background: #fff;\n    }\n\n    .czm-swatches__hero {\n      position: relative;\n      min-height: 450px;\n      display: flex;\n      align-items: flex-end;\n      isolation: isolate;\n      background: #4b4540;\n    }\n\n    .czm-swatches__hero-image,\n    .czm-swatches__hero-shade {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n    }\n\n    .czm-swatches__hero-image {\n      z-index: -2;\n      object-fit: cover;\n    }\n\n    .czm-swatches__hero-shade {\n      z-index: -1;\n      background: linear-gradient(180deg, rgba(20,18,16,.08) 18%, rgba(20,18,16,.78) 100%);\n    }\n\n    .czm-swatches__hero-content {\n      width: 100%;\n      padding: 42px 18px 26px;\n      color: #fff;\n    }\n\n    .czm-swatches__eyebrow {\n      margin: 0 0 8px;\n      color: inherit;\n      font: 700 11px/1.2 var(--base-font-family);\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .czm-swatches__eyebrow--dark { color: #7a6254; }\n\n    .czm-swatches h1,\n    .czm-swatches h2 {\n      color: inherit;\n      font-family: var(--heading-font-family);\n      font-weight: var(--heading-font-weight);\n      text-transform: none;\n    }\n\n    .czm-swatches__hero h1 {\n      margin: 0;\n      font-size: clamp(32px, 9.5vw, 40px);\n      line-height: 1.02;\n      letter-spacing: -.02em;\n    }\n\n    .czm-swatches__lede {\n      max-width: 340px;\n      margin: 13px 0 18px;\n      color: inherit;\n      font-size: 15px;\n      line-height: 1.45;\n    }\n\n    .czm-swatches__actions {\n      display: grid;\n      grid-template-columns: 1.12fr .88fr;\n      gap: 9px;\n    }\n\n    .czm-swatches__button {\n      min-height: 48px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      padding: 12px 10px;\n      border: 1px solid #fff;\n      border-radius: 3px;\n      color: #171717 !important;\n      background: #fff !important;\n      background-image: none !important;\n      font: 700 11px/1.2 var(--base-font-family);\n      letter-spacing: .04em;\n      text-align: center;\n      text-decoration: none !important;\n      text-transform: uppercase;\n    }\n\n    .czm-swatches__button--glass {\n      color: #fff !important;\n      background: rgba(255,255,255,.10) !important;\n      backdrop-filter: blur(6px);\n    }\n\n    .czm-swatches__button::before,\n    .czm-swatches__button::after,\n    .czm-swatches__card::before,\n    .czm-swatches__card::after,\n    .czm-swatches__note a::before,\n    .czm-swatches__note a::after {\n      display: none !important;\n    }\n\n    .czm-swatches__body {\n      padding: 16px 0 16px !important;\n      border-bottom: 1px solid rgba(23,23,23,.10);\n      background: #f7f4ef;\n    }\n\n    .czm-swatches__section-head,\n    .czm-swatches__browse {\n      padding: 0 18px;\n    }\n\n    .czm-swatches__section-head h2,\n    .czm-swatches__browse h2 {\n      max-width: 345px;\n      margin: 0;\n      color: rgb(var(--body-heading-color));\n      font-size: 29px;\n      line-height: 1.12;\n      letter-spacing: -.015em;\n    }\n\n    .czm-swatches__section-head > p:last-child,\n    .czm-swatches__browse > p:last-child {\n      max-width: 345px;\n      margin: 10px 0 19px;\n      color: #5f5b57;\n      font-size: 14px;\n      line-height: 1.45;\n    }\n\n    .czm-swatches__cards {\n      display: flex;\n      gap: 11px;\n      overflow-x: auto;\n      padding: 0 18px 7px;\n      scroll-snap-type: x mandatory;\n      scrollbar-width: none;\n      -webkit-overflow-scrolling: touch;\n    }\n\n    .czm-swatches__cards::-webkit-scrollbar { display: none; }\n\n    .czm-swatches__card {\n      position: relative;\n      flex: 0 0 68vw;\n      max-width: 270px;\n      aspect-ratio: 4 / 5;\n      overflow: hidden;\n      border-radius: 14px;\n      color: #fff !important;\n      background: #d7d0c9 !important;\n      background-image: none !important;\n      scroll-snap-align: start;\n      text-decoration: none !important;\n    }\n\n    .czm-swatches__card img,\n    .czm-swatches__card-shade {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n    }\n\n    .czm-swatches__card img { object-fit: cover; }\n\n    .czm-swatches__card-shade {\n      background: linear-gradient(180deg, transparent 42%, rgba(20,18,16,.77) 100%);\n    }\n\n    .czm-swatches__card-copy {\n      position: absolute;\n      inset: auto 15px 15px;\n      display: flex;\n      flex-direction: column;\n      color: inherit;\n    }\n\n    .czm-swatches__card-copy small {\n      margin-bottom: 3px;\n      font-size: 12px;\n      line-height: 1.25;\n    }\n\n    .czm-swatches__card-copy strong {\n      font: 400 24px/1.08 var(--heading-font-family);\n    }\n\n    .czm-swatches__card-copy em {\n      margin-top: 6px;\n      font: normal 12px/1.35 var(--base-font-family);\n      opacity: .92;\n    }\n\n    .czm-swatches__features {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0,1fr));\n      gap: 10px;\n      padding: 0 18px;\n    }\n\n    .czm-swatches__feature {\n      min-height: 126px;\n      padding: 17px 15px;\n      border: 1px solid rgba(23,23,23,.13);\n      border-radius: 10px;\n      background: #fff;\n    }\n\n    .czm-swatches__feature span {\n      display: block;\n      margin-bottom: 18px;\n      color: #9b8d83;\n      font-size: 11px;\n      font-weight: 700;\n    }\n\n    .czm-swatches__feature strong {\n      display: block;\n      color: rgb(var(--body-heading-color));\n      font-size: 15px;\n      line-height: 1.25;\n    }\n\n    .czm-swatches__feature small {\n      display: block;\n      margin-top: 5px;\n      color: #68625d;\n      font-size: 12px;\n      line-height: 1.35;\n    }\n\n    .czm-swatches__proof {\n      display: grid;\n      grid-template-columns: repeat(3, minmax(0,1fr));\n      margin: 0 18px;\n      padding: 12px 0 13px;\n      border-bottom: 1px solid rgba(23,23,23,.14);\n    }\n\n    .czm-swatches__proof span {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      min-width: 0;\n      padding: 0 7px;\n      text-align: center;\n    }\n\n    .czm-swatches__proof span + span { border-left: 1px solid rgba(23,23,23,.12); }\n\n    .czm-swatches__proof strong {\n      color: rgb(var(--body-heading-color));\n      font-size: 14px;\n      line-height: 1.2;\n    }\n\n    .czm-swatches__proof small {\n      margin-top: 4px;\n      color: #6a645f;\n      font-size: 10px;\n      line-height: 1.25;\n    }\n\n    .czm-swatches__perk {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin: 0 18px;\n      padding: 12px 0 0;\n      border: 0;\n      border-radius: 0;\n      background: transparent;\n    }\n\n    .czm-swatches__perk-icon {\n      display: grid;\n      flex: 0 0 26px;\n      width: 26px;\n      height: 26px;\n      place-items: center;\n      color: #6f5948;\n      background: transparent;\n    }\n\n    .czm-swatches__perk-icon svg {\n      width: 16px;\n      height: 16px;\n      fill: none;\n      stroke: currentColor;\n      stroke-width: 1.5;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n    }\n\n    .czm-swatches__perk-copy {\n      display: flex;\n      flex: 1 1 auto;\n      min-width: 0;\n      flex-direction: column;\n    }\n\n    .czm-swatches__perk-copy strong {\n      color: #5e493a;\n      font-size: 12px;\n      line-height: 1.2;\n      letter-spacing: .09em;\n      text-transform: uppercase;\n    }\n\n    .czm-swatches__perk-copy small {\n      margin-top: 3px;\n      color: #4f4944;\n      font-size: 12px;\n      line-height: 1.35;\n    }\n\n    .czm-swatches__note {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin: 20px 18px 0;\n      padding: 15px;\n      border: 1px solid rgba(23,23,23,.14);\n      border-radius: 9px;\n      background: #fff;\n      font-size: 12px;\n      line-height: 1.4;\n    }\n\n    .czm-swatches__note span { flex: 1; }\n    .czm-swatches__note strong {\n      display: block;\n      color: rgb(var(--body-heading-color));\n      font-size: 13px;\n    }\n\n    .czm-swatches__note a {\n      flex: 0 0 auto;\n      color: rgb(var(--body-heading-color)) !important;\n      background: transparent !important;\n      background-image: none !important;\n      font-size: 11px;\n      font-weight: 700;\n      text-decoration: underline !important;\n      text-underline-offset: 3px;\n      text-transform: uppercase;\n    }\n\n    .czm-swatches__browse {\n      margin-top: 32px;\n      padding-top: 26px;\n      border-top: 1px solid rgba(23,23,23,.14);\n      scroll-margin-top: 74px;\n    }\n\n    \n    .czm-swatches__hero { min-height: 430px; }\n    .czm-swatches__hero-image { object-position: center; }\n    [id$=\"__test_GAE7ze\"] { scroll-margin-top: 72px; }\n\n  }\n</style>\n{% endif %}"
