pe":"image","settings":{"width":"half","top_title":"Fullness Style","image":"shopify:\/\/shop_images\/12_2x_ad291b46-5afd-4626-a1c7-5d82a76d6bd5.webp","height":"adapt","height_desktop":600,"height_mobile":500,"subheading":"","title":"","text":"","enlarge_text":false,"button_label":"","button_style":"primary","image_link":"","text_alignment":"center center","mobile_overlay_under":false,"overlay_style":"shadow"}},"text_NaDdPT":{"type":"text","settings":{"width":"half","subheading":"","title":"Fullness Style","text":"<p>Fullness refers to how much fabric is used compared to your curtain’s finished width — it affects how rich and gathered your drapes look.<\/p><ul><li><strong>Pleated<\/strong> — We default to a fullness of 2.2×-2.5x for a balanced, tailored look depending on the curtain width.<\/li><li><strong>Grommet & Soft Top<\/strong> — These styles also use a fullness of 2.2× for a uniform, elegant drape.<\/li><li><strong>Custom Requests<\/strong> — If you’d like a different fullness, email us at <a href=\"mailto:care@cozyology.com\" target=\"_blank\" title=\"mailto:care@cozyology.com\">care@cozyology.com<\/a> — we’ll be happy to assist.<\/li><\/ul><p>Learn more about <a href=\"\/pages\/fullness-guide\" target=\"_blank\" title=\"Fullness Guide\">fullness<\/a>.<\/p>","button_label":"","button_link":"","show_calendly":false,"button_style":"primary","text_alignment":"left"}}},"block_order":["image_yPfJct","text_NaDdPT"],"name":"Custom content","settings":{"alignment":"middle"}}},"order":["main","custom_products_Cyw7La","rich_text_jA9XJw","custom_content_GAKdRT","custom_liquid_XCmJhX","rich_text_HWb9Ra","custom_liquid_Tkwq9g","image_with_text_overlay_dMnpBh","custom_liquid_EJV88P","custom_content_QpaxLG","custom_content_jDxHUQ","custom_liquid_DwEpLA","rich_text_bPw6hP","custom_liquid_TEQpnK","custom_content_AAzfc6","custom_content_PkV83E","custom_liquid_9UcC4f","custom_content_jFA9wp","custom_liquid_XxKMGA","multi_column_twXq6i","rich_text_tRYN8K","custom_liquid_4gzeCE