xxY":{"type":"question","settings":{"title":"Can I use a gift card with a discount code?","answer":"<p>Yes! Gift cards can be used alongside discount codes and are applied during the next checkout step.<\/p>"}},"question_WDcJNJ":{"type":"question","settings":{"title":"What if I need to make changes to my order?","answer":"<p>If you need to make changes, please reach out to us within 24 hours of placing your order. After that, production will have begun and changes may not be possible.<\/p>"}},"question_Yc9yWD":{"type":"question","settings":{"title":"Do you offer returns or exchanges?","answer":"<p>If there’s a size discrepancy of more than 1 inch or the wrong color was sent, we’ll gladly accept a return. Please refer to our Returns page for full details.<\/p>"}}},"block_order":["question_aHfLTi","question_XDdTHT","question_K3K8wC","question_w3WfXC","question_qXMxxY","question_WDcJNJ","question_Yc9yWD"],"settings":{"title":"Quick Answers Before You Order"}},"17236059033bc7c833":{"type":"apps","settings":{"full_width":false,"show_space":true}}},"order":["custom_content_yzcrrz","cart_discount_code_tbHM4X","image_with_text_overlay_Y44mV3","main","1758874360c2790715","custom_content_aMg7Tk","collapsible_tabs_mzaVTf","17236059033bc7c833"]}