    font-weight: 600;
  }

  .struct .when {
    color: var(--muted);
    font-size: .84rem;
    margin: 0 0 12px;
    font-style: italic;
    font-family: var(--serif);
  }

  .flow {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .flow span {
    background: #fff;
    border: 1px solid var(--line);
    padding: 5px 11px;
    font-size: .78rem;
    color: var(--ink);
  }

  .flow .arw {
    border: none;
    background: none;
    color: var(--accent);
    font-weight: 600;
    padding: 0 1px;
  }

  .mine {
    background: var(--soft);
    border: 1px solid var(--line);
    padding: 18px 22px;
    font-size: .92rem;
    font-weight: 300;
  }

  .mine b {
    font-weight: 500;
  }

  .mine ul {
    margin: 10px 0 0;
    padding-left: 18px;
  }

  .mine li {
    margin-bottom: 7px;
  }

  .tips {
    background: var(--soft);
    border: 1px solid var(--line);
    padding: 18px 22px;
    font-size: .92rem;
    font-weight: 300;
  }

  .tips b {
    font-weight: 500;
  }

  .tips ul {
    margin: 10px 0 0;
    padding-left: 18px;
  }

  .tips li {
    margin-bottom: 7px;
  }

  /* sample posts */
  .sample {
    background: #fff;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    padding: 26px 32px;
  }

  .sample .stag {
    display: inline-block;
    font-size: .64rem;
    color: var(--btn-ink);
    background: var(--btn);
    padding: 4px 12px;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .sample .meta {
    font-size: .78rem;
    color: var(--muted);
    margin-bottom: 4px;
    letter-spacing: .04em;
  }

  .sample h3 {
    margin: 0 0 6px;
    font-size: 1.7rem;
    font-weight: 600;
  }

  .sample h4 {
    margin: 20px 0 6px;
    font-size: 1.22rem;
    color: var(--ink);
    font-weight: 600;
  }

  .sample p {
    margin: 0 0 13px;
    font-weight: 300;
  }

  .sample ul {
    margin: 0 0 13px;
    padding-left: 20px;
    font-weight: 300;
  }

  .sample li {
    margin-bottom: 6px;
  }

  .sample .note {
    font-size: .78rem;
    color: var(--accent-deep);
    background: var(--soft);
    border: 1px dashed var(--accent);
    padding: 7px 13px;
    display: inline-block;
    margin-top: 8px;
    letter-spacing: .02em;
  }

  .outlines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(262px, 1fr));
    gap: 18px;
  }

  .outline {
    background: #fff;
    border: 1px solid var(--line);
    padding: 20px 22px;
  }

  .outline .badge {
    font-size: .64rem;
    color: var(--accent);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .16em;
  }

  .outline h4 {
    margin: 8px 0 12px;
    font-size: 1.22rem;
    font-weight: 600;
  }

  .outline ol {
    margin: 0;
    padding-left: 18px;
    color: var(--muted);
    font-size: .88rem;
    font-weight: 300;
  }

  .outline ol li {
    margin-bottom: 6px;
  }

  /* accordions — click a bar to reveal that section */
  .acc {
    border: 1px solid var(--line);
    background: var(--card);
    margin-top: 14px;
  }

  .acc-head {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    padding: 17px 22px;
    font: inherit;
    color: var(--ink);
    transition: background .18s;
  }

  .acc-head:hover {
    background: var(--soft);
  }

  .acc-head .ah-ico {
    font-size: 1.05rem;
  }

  .acc-head .ah-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.34rem;
    flex: 1;
    line-height: 1.25;
  }

  .acc-head .ah-sub {
    color: var(--muted);
    font-size: .68rem;
    font-weight: 400;
    letter-spacing: .16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .acc-head .chev {
    color: var(--accent);
    font-weight: 400;
    font-size: .85rem;
    transition: transform .2s;
    flex-shrink: 0;
  }

  .acc.open .acc-head {
    border-bottom: 1px solid var(--line);
    background: var(--soft);
  }

  .acc.open .chev {
    transform: rotate(90deg);
  }

  .acc-body {
    display: none;
    padding: 22px;
  }

  .acc.open>.acc-body {
    display: block;
    animation: fade .2s ease;
  }

  .acc-body>.sample:last-child {
    margin-bottom: 0;
  }

  .acc-hint {
    font-size: .7rem;
    color: var(--muted);
    margin: 26px 0 2px;
    text-align: center;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  footer {
    border-top: 1px solid var(--line);
    padding: 34px 0;
    text-align: center;
    color: var(--muted);
    font-size: .82rem;
    font-weight: 300;
    letter-spacing: .04em;
  }

  .tagrow {
    margin-top: 12px;
  }

  .tagrow span {
    padding: 3px 14px;
    font-size: .66rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--accent-deep);
    position: relative;
  }

  .tagrow span+span::before {
    content: "·";
    position: absolute;
    left: -2px;
    color: var(--line);
  }

  @media(max-width:640px) {
    header.hero h1 {
      font-size: 2.2rem;
    }

    .panel-head h2 {
      font-size: 1.8rem;
    }

    .guide-grid {
      grid-template-columns: 1fr;
    }

    .panel-card {
      padding: 26px 20px;
    }

    .sample {
      padding: 22px 18px;
    }

    .acc-head .ah-sub {
      display: none;
    }

    .acc-head .ah-title {
      font-size: 1.15rem;
    }
  }
</style>

<div class="annc">Cozyology · Curtains &amp; Drapery — Internal Writing Resource</div>

<header class="hero">
  <div class="wrap">
    <div class="logo">cozyology<span class="dot">.</span><small>curtains</small></div>
    <h1>Blog Library for Our Writers</h1>
    <p>Pick a category to see writing guidance and real samples you can follow. No blogging experience needed — and
      nothing here is a fill-in-the-blank template. Each category gives you a few different ways to write, so no two
      posts have to look alike.</p>
    <div class="trust">
      <span>Beginner-friendly</span>
      <span>Multiple structures</span>
      <span>Two full samples each</span>
      <span>Your own voice</span>
    </div>
  </div>
</header>

<main class="wrap">
  <section class="intro">
    <h2>How this works</h2>
    <p>Choose a category, then click open only the parts you need — who reads that kind of post, structures you can
      pick from, prompts to make it your own, two complete samples, and more angle ideas. Treat the samples as
      inspiration, not a mold to copy.</p>
  </section>

  <section class="cats" id="cats">
    <div class="cat" data-cat="know" onclick="pick('know')">
      <span class="count">Practical</span>
      <div class="ico">📐</div>
      <h3>Curtain Know-How</h3>
      <p>Helpful how-to and buying guides that answer real customer questions.</p>
    </div>
    <div class="cat" data-cat="design" onclick="pick('design')">
      <span class="count">Style</span>
      <div class="ico">🎨</div>
      <h3>Design Inspiration</h3>
      <p>Posts about looks, fabrics, and trends that spark ideas.</p>
    </div>
    <div class="cat" data-cat="decor" onclick="pick('decor')">
      <span class="count">Rooms</span>
      <div class="ico">🏡</div>
      <h3>Home Decor Ideas</h3>
      <p>Room-by-room and seasonal ideas for styling curtains at home.</p>
    </div>
    <div class="cat" data-cat="experts" onclick="pick('experts')">
      <span class="count">Authority</span>
      <div class="ico">🧠</div>
