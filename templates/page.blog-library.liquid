{% comment %}
  内部写作资源页 —— Cozyology Blog Library
  · 使用极简独立布局 layout/standalone.liquid，不套店铺页头/页脚
  · 正文整体用 raw 标签包裹，避免 Liquid 解析其中的 JS 模板语法
  · 属于「隐蔽页」：靠不可猜的 handle + noindex + 不挂菜单，不做强访问控制
{% endcomment %}
{% layout 'standalone' %}
{% raw %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Jost:wght@300;400;500;600&display=swap"
  rel="stylesheet">
<style>
  :root {
    --bg: #ffffff;
    --soft: #f7f3ed;
    --card: #ffffff;
    --ink: #232120;
    --muted: #726b64;
    --line: #e7e0d6;
    --accent: #b08a7b;
    --accent-deep: #8f6858;
    --greige: #bcb1a6;
    --btn: #1c1a19;
    --btn-ink: #ffffff;
    --serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    --sans: "Jost", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    --shadow: 0 10px 40px rgba(60, 45, 35, .06);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: var(--sans);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.7;
    font-weight: 300;
    font-size: 16px;
  }

  a {
    color: var(--accent-deep);
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: .2px;
    line-height: 1.2;
  }

  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* announcement bar */
  .annc {
    background: var(--greige);
    color: #3a332d;
    text-align: center;
    font-size: .72rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    padding: 9px 12px;
    font-weight: 400;
  }

  /* hero */
  header.hero {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: 44px 0 48px;
    text-align: center;
  }

  .logo {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1.9rem;
    letter-spacing: -.5px;
    color: var(--ink);
    line-height: 1;
  }

  .logo .dot {
    color: var(--accent);
  }

  .logo small {
    display: block;
    font-size: .6rem;
    letter-spacing: .42em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
    margin-top: 4px;
    padding-left: .42em;
  }

  header.hero h1 {
    font-size: 3rem;
    margin: 26px 0 16px;
    font-weight: 600;
  }

  header.hero p {
    max-width: 640px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 1.02rem;
    font-weight: 300;
  }

  .trust {
    display: flex;
    gap: 0;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 26px;
  }

  .trust span {
    font-size: .72rem;
    color: var(--accent-deep);
    letter-spacing: .14em;
    text-transform: uppercase;
    padding: 0 18px;
    position: relative;
  }

  .trust span+span::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 12px;
    background: var(--line);
  }

  .intro {
    padding: 46px 0 6px;
    text-align: center;
  }

  .intro h2 {
    font-size: 1.9rem;
    margin: 0 0 10px;
    font-weight: 600;
  }

  .intro p {
    color: var(--muted);
    max-width: 720px;
    margin: 0 auto;
    font-weight: 300;
  }

  /* category cards */
  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(232px, 1fr));
    gap: 20px;
    padding: 30px 0 8px;
  }

  .cat {
    background: var(--card);
    border: 1px solid var(--line);
    padding: 28px 24px 26px;
    cursor: pointer;
    transition: .2s;
    text-align: left;
    position: relative;
  }

  .cat:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .cat.active {
    border-color: var(--ink);
  }

  .cat .ico {
    font-size: 1.6rem;
  }

  .cat h3 {
    margin: 14px 0 8px;
    font-size: 1.42rem;
    font-weight: 600;
  }

  .cat p {
    margin: 0;
    color: var(--muted);
    font-size: .9rem;
    font-weight: 300;
  }

  .cat .count {
