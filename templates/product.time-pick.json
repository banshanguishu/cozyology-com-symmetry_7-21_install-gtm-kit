c":false,"sticky_atc_position":"end","sticky_atc_mobile":true,"sticky_atc_behavior":"add_to_cart","sticky_atc_button_style":"secondary","gallery_size":"small","gallery_layout":"carousel-under","enable_zoom":true,"show_alt_text":false,"alt_text_icon":"","enable_video_autoplay":false,"enable_video_looping":false,"enable_media_grouping":false,"media_grouping_option":"Color,Colour,Couleur,Farbe"}},"custom_content_38P63q":{"type":"custom-content","blocks":{"image_cHfN9f":{"type":"image","settings":{"width":"half","top_title":"Why Book a Zoom Consultation?","image":"shopify:\/\/shop_images\/cozyology_meeting.webp","height":"adapt","height_desktop":600,"height_mobile":500,"subheading":"","title":"","text":"","enlarge_text":false,"button_label":"","button_style":"primary","image_link":"","text_alignment":"center center","mobile_overlay_under":false,"overlay_style":"shadow"}},"text_EXdx3k":{"type":"text","settings":{"width":"half","subheading":"","title":"Why Book a Zoom Consultation?","text":"<ul><li><strong>Personalized Guidance<\/strong><br\/>Real-time help from our design expert — from measurement to fabric and style.<\/li><li><strong>No Guesswork<\/strong><br\/>We’ll guide you step by step for a perfect fit and <strong>make sure your order is 100% correct<\/strong> before it’s placed.<\/li><li><strong>Completely Free<\/strong><br\/>No cost, no pressure — just expert support.<\/li><li><strong>Quick & Easy<\/strong><br\/>Book a time that works for you and measure with confidence.<\/li><\/ul>","button_label":"","button_link":"","show_calendly":false,"button_style":"primary","text_alignment":"left"}}},"block_order":["image_cHfN9f","text_EXdx3k"],"name":"Custom content","settings":{"alignment":"middle"}},"related-products":{"type":"related-products","disabled":true,"settings":{"title":"You may also like","show_vendor":false,"grid":4}},"collapsible_tabs_GkGnFr":{"type":"collapsible-tabs","blocks":{"question_NT7UmY":{"type":"question","settings":{"title":"How do I book my consultation?","answer":"<p>You can reserve your preferred time through our booking form. <br\/>Once you’ve selected a slot, it will be automatically blocked for you — so no one else can book the same time.<\/p>"}},"question_98AdTi":{"type":"question","settings":{"title":"How far in advance can I book?","answer":"<p>You can schedule up to two months in advance. We recommend booking early to secure your preferred date and time.<\/p>"}},"question_Eek7nW":{"type":"question","settings":{"title":"Do I need to turn on my camera?","answer":"<p>Not necessarily. You’re welcome to join with or without video, or even by phone if that’s more comfortable for you.<\/p>"}},"question_FpxN84":{"type":"question","settings":{"title":"What should I prepare before the session?","answer":"<p>It’s helpful to have a photo of your room ready, so we can better understand your space and provide personalized recommendations.<\/p>"}},"question_RrGzhC":{"type":"question","settings":{"title":"Is the consultation really free?","answer":"<p>Yes — our 1-on-1 Zoom consultation is completely complimentary. 🤍<\/p>"}},"question_zgecjd":{"type":"question","settings":{"title":"Can I reschedule or cancel?","answer":"<p>Absolutely. You can easily reschedule or cancel through your confirmation email if something changes.<\/p>"}}},"block_order":["question_NT7UmY","question_98AdTi","question_Eek7nW","question_FpxN84","question_RrGzhC","question_zgecjd"],"name":"Collapsible tabs","settings":{"title":"FAQS"}},"collapsible_tabs_LKLy4Y":{"type":"collapsible-tabs","blocks":{"question_nzHWCN":{"type":"question","settings":{"title":"What is “Single Panel Order Width”?","answer":"<p>You can find a detailed explanation <a href=\"\/pages\/pleated-panel-size-guide\" target=\"_blank\" title=\"Pleated Panel Size Guide\">on this page<\/a>.<\/p>"}},"question_VDi8Kd":{"type":"question","settings":{"title":"Where can I find the Measurement Tool?","answer":"<p><a href=\"\/pages\/measurement-tool\" target=\"_blank\" title=\"Measurement Tool\">The Measurement Tool <\/a>covers both <a href=\"\/pages\/drapery-measurement\" target=\"_blank\" title=\"Drapery Measurement\">drapery <\/a>and <a href=\"\/pages\/shades-measurement\" target=\"_blank\" title=\"Shades Measurement\">shades<\/a>, with easy step-by-step guidance for accurate measuring.<\/p>"}},"question_DNNKRm":{"type":"question","settings":{"title":"What if my drapery will be installed on a track instead of a rod?","answer":"<p>No problem — our <a href=\"\/pages\/drapery-measurement\" target=\"_blank\" title=\"Drapery Measurement\">Drapery Measurement Tool<\/a> also includes detailed instructions for track installations.<\/p>"}},"question_7CwQJR":{"type":"question","settings":{"title":"How can I find out my drapery weight?","answer":"<p>You can use our <a href=\"\/pages\/curtain-weight-calculator\" target=\"_blank\" title=\"Curtain Weight Calculator\">Weight Calculator<\/a> to estimate your drapery’s total weight — it also helps you determine whether your rod or track can support it properly.<\/p>"}},"question_xp8BXU":{"type":"question","settings":{"title":"How can I find out my stacked width?","answer":"<p>Our <a href=\"\/pages\/pleats-quantity-stacked-width\" target=\"_blank\" title=\"Pleats Quantity & Stacked Width\">Stacked Width Calculator<\/a> lets you see how much space your drapery will take when fully opened — or calculate your Single Panel Order Width based on the desired stacked width.<\/p>"}}},"block_order":["question_nzHWCN","question_VDi8Kd","question_DNNKRm","question_7CwQJR","question_xp8BXU"],"name":"Collapsible tabs","settings":{"title":"Measurement & Product Guide"}}},"order":["main","custom_content_38P63q","related-products","collapsible_tabs_GkGnFr","collapsible_tabs_LKLy4Y"]}