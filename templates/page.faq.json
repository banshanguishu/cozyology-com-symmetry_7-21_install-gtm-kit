          "settings": {
            "title": "What’s the difference between smart curtains and smart shades?",
            "answer": "<p>All Cozyology motorized products offer remote operation.</p><p><strong>Motorized curtains, Roman shades, and woven shades</strong> can also be controlled via app or voice assistant when paired with a compatible smart hub or Matter-enabled device.</p><p>Compatibility and any required hub may vary by motor option and device ecosystem. Please check the selected product page or email <a href=\"mailto:design@cozyology.com\">design@cozyology.com</a> before ordering.</p>",
            "pin_in_floating_faq": true
          }
        },
        "power-options": {
          "type": "question",
          "settings": {
            "title": "How are they powered?",
            "answer": "<p>Cozyology motorized window treatments are available with <strong>rechargeable battery motors</strong> and <strong>plug-in motors</strong>, depending on the selected product and configuration.</p><ul><li><strong>Rechargeable models</strong> can operate for months between charges, depending on product size and usage.</li><li><strong>Plug-in models</strong> require continuous access to a nearby power outlet.</li></ul><p>Please check the power option shown on the selected product page before ordering.</p>",
            "pin_in_floating_faq": true
          }
        },
