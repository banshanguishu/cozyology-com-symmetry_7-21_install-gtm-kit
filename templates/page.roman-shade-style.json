{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"show_page_title":false,"full_width":false}},"rich_text_jPpzRL":{"type":"rich-text","blocks":{"heading_h93BML":{"type":"heading","settings":{"title":"Roman Shade Style Guide","use_h1":false}},"text_bEKhzj":{"type":"text","settings":{"text":"<p>Roman shades pair timeless elegance with everyday ease. <br\/>At Cozyology, we offer five distinct styles—each with its own folds, function, and charm—so you can find the perfect fit for your home.<\/p>","enlarge_text":true}}},"block_order":["heading_h93BML","text_bEKhzj"],"name":"Rich text","settings":{"height":"medium","text_alignment":"center","full_width":true,"color_scheme":"default"}},"custom_content_dNzbd3":{"type":"custom-content","blocks":{"image_96r33G":{"type":"image","settings":{"width":"half","top_title":"Plain Style","image":"shopify:\/\/shop_images\/romanshadelena3.webp","height":"fixed","height_desktop":460,"height_mobile":280,"subheading":"","title":"","text":"","enlarge_text":false,"button_label":"","button_style":"primary","image_link":"","text_alignment":"center center","mobile_overlay_under":false,"overlay_style":"shadow"}},"text_QEBpMe":{"type":"text","settings":{"width":"half","subheading":"","title":"Plain Style","text":"<p>Slats sewn inside for a smooth, clean finish.<\/p><ul><li><strong>Design<\/strong>: Slats are sewn inside the fabric for a flat, streamlined look.<\/li><li><strong>Liner options<\/strong>: Available unlined or with an added liner.<\/li><li><strong>Visibility<\/strong>: With a liner, slats are barely visible; without a liner, slats are more noticeable but still subtle.<\/li><li><strong>System<\/strong>: Works with Cordless, Code Lift, No-Drill, and Motorized systems.<br\/><\/li><\/ul>","button_label":"","button_link":"","button_style":"primary","text_alignment":"left"}},"image_WVgbty":{"type":"image","settings":{"width":"full","top_title":"","image":"shopify:\/\/shop_images\/Plain_22facfbf-9112-4bd2-9713-c4c996c7fa87.