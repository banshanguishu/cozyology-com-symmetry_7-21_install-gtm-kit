{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"show_page_title":false,"full_width":false}},"rich_text_K4TrNe":{"type":"rich-text","blocks":{"heading_p9dQtU":{"type":"heading","settings":{"title":"Covering the Track with Pleated Drapery","use_h1":true}}},"block_order":["heading_p9dQtU"],"custom_css":["@media (min-width: 1024px) {.fully-spaced-row--medium {margin-bottom: -50px; }}","@media (max-width: 767px) {.fully-spaced-row--medium {margin-bottom: -50px; }}"],"name":"Rich text","settings":{"height":"medium","text_alignment":"center","full_width":false,"color_scheme":"default"}},"custom_content_GLUy8V":{"type":"custom-content","blocks":{"image_77VgAU":{"type":"image","settings":{"width":"half","top_title":"Why Cover the track？","image":"shopify:\/\/shop_images\/trackcover.webp","height":"adapt","height_desktop":600,"height_mobile":500,"subheading":"","title":"","text":"","enlarge_text":false,"button_label":"","button_style":"primary","image_link":"","text_alignment":"center center","mobile_overlay_under":false,"overlay_style":"shadow"}},"text_PqwUD7":{"type":"text","settings":{"width":"half","subheading":"","title":"Why Cover the track？","text":"<p><strong>Benefits: <\/strong><br\/>Creates a clean, seamless look by hiding the track from view.<br\/>Achieves complete blackout, preventing light from leaking through the top of the curtain.<br\/><br\/><strong>Considerations: <\/strong><br\/>The pleated header may tilt slightly forward, so the top won’t appear as crisp as when the track is exposed — <strong>as shown in the circled area in the photo<\/strong>, this is the small section of the header that naturally projects <strong>forward<\/strong> when the track is fully covered.<\/p>","button_label":"","button_link":"","show_calendly":false,"button_style":"primary","text_alignment":"left"}}},"block_order":["image_77VgAU","text_PqwUD7"],"name":"Custom content","settings":{"alignment":"middle"}},"custom_content_CbCdzn":{"type":"custom-content","blocks