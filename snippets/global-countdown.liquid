{% liquid
  assign enabled = settings.enable_global_countdown
  assign use_small = settings.enable_global_countdown_small
  assign end_time = settings.global_countdown_end_time
  assign message = settings.global_countdown_message
  assign btn_label = settings.global_countdown_button_label
  assign btn_link = settings.global_countdown_button_link
  assign bg_color = settings.global_countdown_bg_color
  assign btn_bg_color = settings.global_countdown_button_bg_color
%}
{% if enabled and end_time != blank %}
  <div
    id="GlobalCountdown"
    class="global-countdown-container{% if use_small %} global-countdown-container--small{% endif %}"
    data-end-time="{{ end_time }}"
    style="{% if bg_color != blank %}background-color: {{ bg_color }};{% endif %}"
  >
    {% if message != blank %}
      <div class="global-countdown__message">{{ message }}</div>
    {% endif %}
    <div class="global-countdown__content">
      <div class="countdown-item countdown__day">
        <div class="countdown-item__value">00</div>
        <div class="countdown-item__text">
          <span class="countdown-item__text-full">DAYS</span>
          <span class="countdown-item__text-short">D</span>
        </div>
      </div>
      <div class="countdown-item countdown__hour">
        <div class="countdown-item__value">00</div>
        <div class="countdown-item__text">
          <span class="countdown-item__text-full">HRS</span>
          <span class="countdown-item__text-short">H</span>
        </div>
      </div>
      <div class="countdown-item countdown__minute">
        <div class="countdown-item__value">00</div>
        <div class="countdown-item__text">
          <span class="countdown-item__text-full">MIN</span>
          <span class="countdown-item__text-short">M</span>
        </div>
      </div>
      <div class="countdown-item countdown__second">
        <div class="countdown-item__value">00</div>
        <div class="countdown-item__text">
          <span class="countdown-item__text-full">SEC</span>
          <span class="countdown-item__text-short">S</span>
        </div>
      </div>
    </div>
    {% if btn_label != blank and btn_link != blank %}
      <a
        class="global-countdown__button"
        target="_blank"
        href="{{ btn_link }}"
        {%- unless use_small %} style="{% if btn_bg_color != blank %}background-color: {{ btn_bg_color }};{% endif %}"{% endunless -%}
      >
        {{ btn_label }}
        <img
          class="global-countdown__arrow"
          src="{{ 'arrow-right.svg' | asset_url }}"
          alt="arrow-right"
          width="10px"
          height="10px"
        />
      </a>
    {% endif %}
  </div>

  <style>
    .global-countdown-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 9999;
      box-sizing: border-box;
      padding: 5px 0;
      display: flex;
      column-gap: 24px;
      justify-content: center;
      align-items: center;
      color: #fff;
    }

    .global-countdown__message {
      font-weight: bold;
      font-size: 18px;
    }

    .global-countdown__content {
      display: flex;
      align-items: center;
      justify-content: center;
      column-gap: 10px;
    }

    .countdown-item {
      display: flex;
      flex-direction: column;
    }

    .countdown__hour,
    .countdown__minute,
    .countdown__second {
      opacity: 0.5;
    }

    .countdown-item__value {
      width: 42px;
      height: 26px;
      line-height: 28px;
      text-align: center;
      font-weight: bold;
      font-size: 20px;
    }

    .countdown-item__text {
      width: 42px;
      height: 16px;
      line-height: 14px;
      text-align: center;
      font-size: 10px;
    }

    .countdown-item__text-short {
      display: none;
    }

    .global-countdown__button {
      height: 28px;
      line-height: 28px;
      padding: 0 12px;
      font-size: 16px;
      color: #fff;
    }

    .global-countdown__arrow {
      display: none;
    }

    /* ===== Small variant (desktop) ===== */
    .global-countdown-container--small {
      padding: 6px 0;
      column-gap: 32px;
    }

    .global-countdown-container--small .global-countdown__message {
      font-size: 14px;
      font-weight: normal;
    }

    .global-countdown-container--small .global-countdown__content {
      column-gap: 16px;
    }

    .global-countdown-container--small .countdown-item {
      flex-direction: row;
      align-items: baseline;
      column-gap: 3px;
    }

    .global-countdown-container--small .countdown-item__value {
      width: auto;
      height: auto;
      line-height: 1;
      font-size: 16px;
    }

    .global-countdown-container--small .countdown-item__text {
      width: auto;
      height: auto;
      line-height: 1;
      font-size: 10px;
      font-weight: normal;
    }

    .global-countdown-container--small .countdown-item__text-full {
      display: none;
    }

    .global-countdown-container--small .countdown-item__text-short {
      display: inline;
    }

    .global-countdown-container--small .global-countdown__button {
      height: auto;
      line-height: 1.2;
      padding: 0;
      font-size: 14px;
      text-decoration: underline;
      font-weight: 700;
    }

    .global-countdown-container--small .global-countdown__arrow {
      display: inline-block;
      margin-left: 4px;
      vertical-align: middle;
    }

    @media (max-width: 768px) {
      .global-countdown-container {
        height: 45px;
        padding: 0 12px;
        column-gap: unset;
        justify-content: space-between;
        {% comment %} background-color: #F0F0F0 !important; {% endcomment %}
      }

      .global-countdown__message {
        display: none;
      }

      .global-countdown__content {
        justify-content: unset;
        column-gap: 5px;
      }

      .countdown-item__value {
        width: auto;
        padding: 0 5px;
        font-size: 14px;
        border-bottom: none;
      }

      .countdown-item__text {
        display: none;
      }

      .global-countdown__button {
        padding: 0 8px;
        font-size: 16px;
        background-color: unset;
        text-decoration: underline;
        font-weight: 700;
      }

      .global-countdown__arrow {
        display: none;
      }

      /* ===== Small variant (mobile) ===== */
      .global-countdown-container--small {
        height: auto;
        padding: 6px 12px;
      }

      .global-countdown-container--small .countdown-item {
        display: flex;
        flex-direction: row;
        align-items: baseline;
        column-gap: 2px;
      }

      .global-countdown-container--small .countdown-item__value {
        padding: 0;
        font-size: 14px;
      }

      .global-countdown-container--small .countdown-item__text {
        display: inline;
        width: auto;
        height: auto;
        font-size: 10px;
      }

      .global-countdown-container--small .global-countdown__button {
        padding: 0;
        font-size: 14px;
      }
    }
  </style>

  <script src="{{ 'global-countdown.js' | asset_url }}" defer></script>
{% endif %}
