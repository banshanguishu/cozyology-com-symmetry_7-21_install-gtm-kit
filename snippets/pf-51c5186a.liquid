  // 结果小数部分处理方法
  function adjustDecimal(x) {
    console.log("结果小数部分处理方法", x)
    // 获取整数部分和小数部分
    const integerPart = Math.floor(x);
    const decimalPart = x - integerPart;

    // 根据小数部分调整值
    let adjustedDecimal;
    if (decimalPart < 0.3) {
      adjustedDecimal = 0.0;
    } else if (decimalPart < 0.7) {
      adjustedDecimal = 0.5;
    } else {
      adjustedDecimal = 1.0;
    }

    // 返回调整后的值
    return integerPart + adjustedDecimal;
  }


