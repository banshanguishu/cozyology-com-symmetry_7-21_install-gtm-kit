{%- comment -%}
  Cozyology phone-only navigation.
  This snippet is rendered only inside the existing mobile drawer template.
  Desktop and iPad mega-menu markup remains in main-nav-links.liquid.
{%- endcomment -%}

{%- liquid
  assign cz_swatches_image = images['cozyologyfreeswatchesupto20.webp']
  assign cz_mobile_feature_swatches_image = images['Free_Swatches_1dd6ecf5-4a7e-4338-b91d-e5d2a6a9691a.webp']
  assign cz_mobile_campaign_image = images['LABORDAYEVENT_2x_d0420d99-1a23-4fc9-947b-6939b38c902d.webp']
  assign cz_best_sellers = collections['best-sellers']
  assign cz_best_sellers_image = cz_best_sellers.image | default: cz_best_sellers.products.first.featured_image
  assign cz_designer = collections['designer-series-drapery']
  assign cz_designer_image = cz_designer.image | default: cz_designer.products.first.featured_image
  assign cz_roman = collections['roman-shades']
  assign cz_roman_image = cz_roman.image | default: cz_roman.products.first.featured_image
  assign cz_handwoven = collections['handwoven-shades']
  assign cz_handwoven_image = cz_handwoven.image | default: cz_handwoven.products.first.featured_image
  assign cz_motor_roman = all_products['motorized-window-roman-shades']
  assign cz_motor_track = all_products['tatum-modular-splicing-motorized-curtain-track']
  assign cz_color_box = all_products['neutral-patterned-designer-color-box-34-colors']
  assign cz_zoom = all_products['complimentary-1-on-1-zoom-consultation']
  assign cz_gallery_image = images['gallery-roman-shades-living-room.jpg']
-%}

