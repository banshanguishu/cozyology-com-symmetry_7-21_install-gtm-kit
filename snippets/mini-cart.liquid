{%- comment -%}
  Mini Cart — 仅在 test.liquid (Collection pages custom) 内使用。
  通过 sections/mini-cart.liquid 走 Section Rendering API 拿到刷新后的 HTML。

  Inputs:
    section_product_ids: array of product ids belonging to current section.
                         cart.items 中 product_id 在此集合内的 line 才会显示。
{%- endcomment -%}

{%- assign max_items = 20 -%}

{%- assign visible_items_count = 0 -%}
{%- for item in cart.items -%}
  {%- if section_product_ids contains item.product_id -%}
    {%- assign visible_items_count = visible_items_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<aside
  class="mini-cart{% if visible_items_count == 0 %} mini-cart--hidden{% endif %}"
  data-mini-cart
  aria-label="Sample cart">
  <div class="mini-cart__panel" data-mini-cart-panel>
    {%- comment -%} 展开态 {%- endcomment -%}
    <div class="mini-cart__expanded" data-mini-cart-expanded>
      <header class="mini-cart__header">
        <h3 class="mini-cart__title">
          Order Swatches (<span data-mini-cart-count>{{ visible_items_count }}</span>/{{ max_items }})
        </h3>
        <button type="button" class="mini-cart__btn mini-cart__collapse-btn" data-mini-cart-collapse aria-label="Collapse">
          ×
        </button>
      </header>

      <div class="mini-cart__list-wrap">
        <button type="button" class="mini-cart__btn mini-cart__nav mini-cart__nav--prev" data-mini-cart-prev aria-label="Previous">
          &lt;
        </button>

        <ul class="mini-cart__list" data-mini-cart-list role="list">
          {%- for item in cart.items -%}
            {%- if section_product_ids contains item.product_id -%}
              <li class="mini-cart__item"
                  data-mini-cart-item
                  data-variant-id="{{ item.variant_id }}"
                  data-line-key="{{ item.key }}">
                <div class="mini-cart__item-image" aria-hidden="true">
                  {%- comment -%} 图片占位 {%- endcomment -%}
                </div>
                <button type="button"
                        class="mini-cart__btn mini-cart__item-remove"
                        data-mini-cart-remove
                        aria-label="Remove {{ item.product.title | escape }}">
                  ⊖
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <button type="button" class="mini-cart__btn mini-cart__nav mini-cart__nav--next" data-mini-cart-next aria-label="Next">
          &gt;
        </button>
      </div>
    </div>

    {%- comment -%} 收起态 {%- endcomment -%}
    <div class="mini-cart__collapsed" data-mini-cart-collapsed hidden>
      <button type="button" class="mini-cart__btn mini-cart__expand-btn" data-mini-cart-expand aria-label="Expand">
        &lt;
      </button>
      <span class="mini-cart__count-mini">
        (<span data-mini-cart-count>{{ visible_items_count }}</span>/{{ max_items }})
      </span>
    </div>
  </div>

  <div class="mini-cart__cart-action" data-mini-cart-cart-action>
    <span class="mini-cart__cart-icon" aria-hidden="true">
      {%- comment -%} 购物车 icon 占位 {%- endcomment -%}
    </span>
    <button type="button" class="mini-cart__btn mini-cart__cart-btn" data-mini-cart-open-drawer>
      Cart
    </button>
  </div>
</aside>
