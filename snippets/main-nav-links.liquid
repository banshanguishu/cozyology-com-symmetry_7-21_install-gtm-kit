                          <script>
                            (() => {
                              const video = document.currentScript.previousElementSibling;
                              if (!video || video.dataset.czMenuStartTrimmed) return;

                              video.dataset.czMenuStartTrimmed = 'true';
                              const startAt = 3;
                              const seekPastIntro = () => {
                                if (Number.isFinite(video.duration) && video.duration > startAt && video.currentTime < startAt) {
                                  video.currentTime = startAt;
                                }
                              };

                              if (video.readyState >= 1) seekPastIntro();
                              else video.addEventListener('loadedmetadata', seekPastIntro, { once: true });

                              video.addEventListener('play', seekPastIntro);
                              video.addEventListener('timeupdate', () => {
                                if (video.currentTime < 0.5) seekPastIntro();
                              });
                            })();
