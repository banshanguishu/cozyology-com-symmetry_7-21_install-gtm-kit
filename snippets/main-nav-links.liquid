<ul class="navigation__tier-1">
  {% for link in linklists[link_list].links %}
    {%- liquid
      assign has_dropdown = false
      assign use_columns = false
      assign small_promo_count = 0
      assign link_title_sanitised = link.title | downcase | strip
      assign cz_navigation_url = link.url
      assign cz_motorization_menu = false

      if link_title_sanitised == 'collaborations'
        assign cz_navigation_url = '/pages/cozyology-collectives'
      endif

      if link.links != blank
        assign has_dropdown = true
      endif

      if link.levels >= 2
        assign use_columns = true
      else
        for block in section.blocks
          assign dropdown_link_title_sanitised = block.settings.dropdown_link_title | downcase | strip
          if dropdown_link_title_sanitised == link_title_sanitised
            if mobile == false or link.links != blank
              assign use_columns = true
              assign has_dropdown = true
            endif
          endif
        endfor
      endif

      for block in section.blocks
        assign dropdown_link_title_sanitised = block.settings.dropdown_link_title | downcase | strip
        if dropdown_link_title_sanitised == link_title_sanitised and block.type == 'menu-promotion-small'
          assign small_promo_count = small_promo_count | plus: 1
        endif
      endfor

      if mobile == false and link_title_sanitised == 'motorization'
        assign cz_motorization_menu = true
        assign has_dropdown = true
        assign use_columns = true
      endif

      if cz_motorization_menu
        assign column_count = 2
      elsif use_columns and link.levels == 1
        assign column_count = 1 | plus: small_promo_count
      else
        assign column_count = link.links.size | plus: small_promo_count
      endif
    -%}
    <li class="navigation__item{% if has_dropdown %} navigation__item--with-children {% if use_columns %}navigation__item--with-mega-menu{% else %}navigation__item--with-small-menu{% endif %}{% endif %}{% if featured_links contains link.title %} featured-link{% endif %}{% if link.active %} navigation__item--active{% endif %}{% if crown_links contains link.title %} crown-link{% endif %}">
      <a href="{{ cz_navigation_url }}" class="navigation__link" {% if has_dropdown %}aria-haspopup="true" aria-expanded="false" aria-controls="NavigationTier2-{{ forloop.index }}{% if mobile %}-mob{% endif %}"{% endif %}>
        {% if crown_links contains link.title and mobile == false %}
          <img src="{{ 'crown.png' | asset_url }}" width="16" height="16" alt="" aria-hidden="true" class="navigation__badge" />
        {% endif %}
        {%- if featured_links contains link.title -%}
          <img width="92px" height="24px" src="{{ 'sale-toggle.gif' |  asset_url }}" alt="sale toggle gif" class="sale-toggle-featured-gif" />
        {% else %}
          {{- link.title | escape -}}
        {%- endif -%}
      </a>

      {% if has_dropdown %}
        <a class="navigation__children-toggle" href="#" aria-label="{{ 'general.navigation.show_links' | t }}">{% render 'icon-toggle-menu', stroke_width: 1.3 %}</a>

        <div id="NavigationTier2-{{ forloop.index }}{% if mobile %}-mob{% endif %}" class="navigation__tier-2-container navigation__child-tier{% unless mobile %} cz-mega cz-mega--{{ link.title | handleize }}{% endunless %}">
          {%- for block in section.blocks -%}
            {%- assign dropdown_link_title_sanitised = block.settings.dropdown_link_title | downcase | strip -%}
            {%- if dropdown_link_title_sanitised == link_title_sanitised and block.type == 'menu-promotion-large' -%}
              <div class="navigation__wide-promotion{% if block.settings.enable_fade %} navigation__wide-promotion--with-fade{% endif %}" {{ block.shopify_attributes }}>
                <div class="container">
                  <div class="flexible-layout valign-middle">
                    {%- if block.settings.desktop_image != blank and mobile == false -%}
                      <div class="column column--half {% if block.settings.image_position == 'right' %}column--order-push-desktop{% endif %}">
                        <div class="container__breakout">
                          {%- render 'image' with block.settings.desktop_image, size_cols_desktop: 2, loading: 'manual' -%}
                        </div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.mobile_image != blank and mobile == true -%}
                      <div class="column column--full">
                        <div class="container__breakout">
                          {%- render 'image' with block.settings.mobile_image, size_cols_desktop: 2, loading: 'manual' -%}
                        </div>
                      </div>
                    {%- endif -%}

                    <div class="column column--{% if block.settings.desktop_image == blank %}full{% else %}half{% endif %} align-ltr-{{ block.settings.text_alignment }}">
                      <div class="feature-text-paired">
                        {%- if block.settings.show_countdown -%}
                          {%- capture countdown_html -%}
                            <style>
                              .countdown-container-id-{{ block.id }} .countdown {
                                --countdown-desktop-size: {{ block.settings.number_size }}px;
                              }
                            </style>

                            <div class="countdown-container-id-{{ block.id }} lightly-spaced-row countdown-font-{{ block.settings.number_font }} countdown-divider-{{ block.settings.divider_type }}">
                              {% render 'countdown-timer',
                                end_date: block.settings.end_date,
                                end_time: block.settings.end_time,
                                end_text: block.settings.end_text,
                                end_midnight: true,
                                hide_on_end: block.settings.hide_on_end,
                                show_labels: block.settings.show_timer_labels
                              %}
                            </div>
                          {%- endcapture -%}
                          {%- if block.settings.countdown_position == 'top' -%}{{ countdown_html }}{%- endif -%}
                        {%- endif -%}

                        {%- if block.settings.subheading != blank -%}
                          <div class="subheading subheading--over">{{ block.settings.subheading | escape }}</div>
                        {%- endif -%}

                        {% if block.settings.title != blank %}
                          <div class="majortitle in-content h1">{{ block.settings.title | escape }}</div>
                        {% endif %}

                        {%- if block.settings.show_countdown and block.settings.countdown_position == 'under-heading' -%}{{ countdown_html }}{%- endif -%}

                        {%- if block.settings.text != blank -%}
                          <div class="rte lightly-spaced-row">{{ block.settings.text }}</div>
                        {%- endif -%}

                        {%- if block.settings.show_countdown and block.settings.countdown_position == 'under-text' -%}{{ countdown_html }}{%- endif -%}

                        {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
                          <div class="button-row">
                            {% if block.settings.button_1_label != blank %}
                              <a class="button-row__btn {% if block.settings.button_1_style != 'link' %}btn btn--{{ block.settings.button_1_style }}{% else %}small-feature-link{% endif %}" href="{{ block.settings.button_1_link }}">{{ block.settings.button_1_label | escape }}</a>
                            {% endif %}
                            {% if block.settings.button_2_label != blank %}
                              <a class="button-row__btn {% if block.settings.button_2_style != 'link' %}btn btn--{{ block.settings.button_2_style }}{% else %}small-feature-link{% endif %}" href="{{ block.settings.button_2_link }}">{{ block.settings.button_2_label | escape }}</a>
                            {% endif %}
                          </div>
                        {%- endif -%}

                        {%- if block.settings.show_countdown and block.settings.countdown_position == 'bottom' -%}{{ countdown_html | replace: 'lightly-spaced-row', 'lightly-spaced-row-above' }}{%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- if link.links != blank or small_promo_count > 0 or cz_motorization_menu -%}
            <div class="container{% unless mobile %} cz-mega__container{% endunless %}">
              {%- unless mobile -%}
                <div class="cz-mega__inner">
                  <aside class="cz-mega__intro">
                    {%- if link_title_sanitised == 'sale' -%}
                      <span class="cz-mega__eyebrow">Sale by category</span>
                      <div class="cz-mega__title h2">Current Offers</div>
                      <ul class="cz-sale__categories" role="list">
                        <li><a href="{{ link.url }}">All Sale</a></li>
                        {%- for child_link in link.links -%}
                          <li><a href="{{ child_link.url }}">{{ child_link.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                      <div class="cz-sale__benefits">
                        <a class="cz-sale__benefit" href="/collections/drapery">
                          <span class="cz-sale__benefit-title">Free Shipping</span>
                          <span>On Drapes &amp; Shades orders</span>
                        </a>
                        <div class="cz-sale__benefit">
                          <span class="cz-sale__benefit-title">Current Codes</span>
                          <span>BTS19 Sitewide · WAVE22 Ripple Fold</span>
                        </div>
                      </div>
                    {%- elsif link_title_sanitised == 'collaborations' -%}
                      <span class="cz-mega__eyebrow">Collaborations</span>
                      <div class="cz-mega__title h2">Meet the Creators</div>
                      <p class="cz-mega__summary cz-collab__intro-copy">Explore three thoughtfully designed homes.</p>
                      <a class="cz-mega__shop-all" href="/pages/cozyology-collectives">
                        <span>View all Collaborations</span>
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                          <path d="M2 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    {%- elsif link_title_sanitised == 'measurement tool' -%}
                      <span class="cz-mega__eyebrow">Online tools</span>
                      <div class="cz-mega__title h2">Measurement Tool</div>
                      <p class="cz-mega__summary">Choose your product type and complete your measurements online in just a few minutes.</p>

                    {%- else -%}
                      <span class="cz-mega__eyebrow">Explore</span>
                      <div class="cz-mega__title h2">{{ link.title | escape }}</div>
                      <p class="cz-mega__summary">Browse {{ link.title | escape }} by category and find the right option for your space.</p>
                      {%- unless link_title_sanitised == 'new & all' -%}
                        <a class="cz-mega__shop-all" href="{{ link.url }}">
                          <span>View all {{ link.title | escape }}</span>
                          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                            <path d="M2 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>
                      {%- endunless -%}
                    {%- endif -%}
                  </aside>
                  <div class="cz-mega__content">
              {%- endunless -%}
              <ul class="navigation__tier-2{% if use_columns %} navigation__columns navigation__columns--count-{{ column_count }}{% if column_count == 5 %} navigation__columns--5-cols{% elsif column_count > 5 %} navigation__columns--over-5-cols{% endif %}{% if small_promo_count > 0 %} navigation__columns--with-promos{% endif %}{% endif %}{% unless mobile %} cz-mega__grid{% endunless %}">
                {% if use_columns and link.levels == 1 %}
                  <li class="navigation__item navigation__column">
                    {%- if mobile == false and link_title_sanitised == 'new & all' -%}
                      <span class="navigation__column-title cz-new-all__shop-heading">Shop</span>
                    {%- endif -%}
                    {% for child_link in link.links %}
                      <a href="{{ child_link.url }}" class="navigation__link{% if featured_links contains child_link.title %} featured-link{% endif %}">
                        {{- child_link.title | escape -}}
                        {% comment %} {%- if child_child_link.object and child_child_link.object.metafields.nitro_lookbook.lookbook_page -%}
                          <div class="menu-tag" style="margin-left: 4px; padding: 2px 8px; background: #908377; border-radius: 15px; font-size: 10px; color: #fff">{{ child_child_link.object.metafields.nitro_lookbook.lookbook_page }}</div>
                        {%- endif -%} {% endcomment %}
                      </a>
                    {% endfor %}
                  </li>
                {% else %}
                  {% for child_link in link.links %}
                    {%- assign cz_child_link_title_sanitised = child_link.title | downcase | strip -%}
                    <li class="navigation__item{% if child_link.links != blank %} navigation__item--with-children{% endif %}{% if use_columns %} navigation__column{% endif %}{% if featured_links contains child_link.title %} featured-link{% endif %}{% if mobile == false and link_title_sanitised == 'shades' and cz_child_link_title_sanitised == 'shades' %} cz-shades__roller-source{% endif %}{% if mobile == false and link_title_sanitised == 'support' and cz_child_link_title_sanitised == 'zoom consultation' %} cz-support__zoom-column-source{% endif %}">
                      <a href="{{ child_link.url }}" class="navigation__link{% if child_link.links != blank %} navigation__column-title{% endif %}" {% if child_link.links != blank %}aria-haspopup="true" aria-expanded="false"{% endif %}>
                        {{- child_link.title | escape -}}
                        {% comment %} {%- if child_child_link.object and child_child_link.object.metafields.nitro_lookbook.lookbook_page -%}
                          <div class="menu-tag" style="margin-left: 4px; padding: 2px 8px; background: #908377; border-radius: 15px; font-size: 10px; color: #fff">{{ child_child_link.object.metafields.nitro_lookbook.lookbook_page }}</div>
                        {%- endif -%} {% endcomment %}
                      </a>
                      {% if child_link.links != blank %}
                        <a class="navigation__children-toggle" href="#" aria-label="{{ 'general.navigation.show_links' | t }}">{% render 'icon-toggle-menu', stroke_width: 1.3 %}</a>
                      {% endif %}

                      {% if child_link.links != blank %}
                        <div class="navigation__tier-3-container navigation__child-tier">
                          <ul class="navigation__tier-3">
                            {% for child_child_link in child_link.links %}
                            {%- assign cz_child_child_title_sanitised = child_child_link.title | downcase | strip -%}
                            <li class="navigation__item{% if featured_links contains child_child_link.title %} featured-link{% endif %}{% if mobile == false and link_title_sanitised == 'support' %}{% if child_child_link.url == '/products/complimentary-1-on-1-zoom-consultation' or cz_child_child_title_sanitised == 'zoom consultation' %} cz-support__online-source{% endif %}{% if cz_child_link_title_sanitised == 'measurement tool' and forloop.first %} cz-support__measurement-first-source{% endif %}{% endif %}{% if mobile == false and link_title_sanitised == 'support' and cz_child_child_title_sanitised == 'measurement tool' %} cz-support__measurement-feature{% endif %}{% if mobile == false and link_title_sanitised == 'free swatches' and cz_child_child_title_sanitised == 'border trims' %} cz-swatches__border-trims{% endif %}" style="display: flex; align-items: center">
                              <a class="navigation__link" href="{{ child_child_link.url }}">
                                {{ child_child_link.title | escape }}
                              </a>
                              {%- if mobile == false and link_title_sanitised == 'support' and cz_child_child_title_sanitised == 'measurement tool' -%}
                                <span class="menu-tag cz-support__measurement-tag">Measure in 3 Min</span>
                              {%- endif -%}
                              {% comment %} {%- if child_child_link.object and child_child_link.object.metafields.nitro_lookbook.lookbook_page -%}
                                <div class="menu-tag" style="margin-left: 4px; padding: 2px 8px; background: #908377; border-radius: 15px; font-size: 10px; color: #fff">{{ child_child_link.object.metafields.nitro_lookbook.lookbook_page }}</div>
                              {%- endif -%} {% endcomment %}
                              {%- if child_child_link.object -%}
                                {% if child_child_link.object.metafields.nitro_lookbook.lookbook_page %}
                                  <div class="menu-tag">{{ child_child_link.object.metafields.nitro_lookbook.lookbook_page }}</div>
                                {% elsif child_child_link.object.metafields.nitro_lookbook.lookbook_collection %}
                                  <div class="menu-tag">{{ child_child_link.object.metafields.nitro_lookbook.lookbook_collection }}</div>
                                {% elsif child_child_link.object.metafields.nitro_lookbook.lookbook_product %}
                                  <div class="menu-tag">{{ child_child_link.object.metafields.nitro_lookbook.lookbook_product }}</div>
                                {% endif %}
                              {%- endif -%}
                            </li>
                            {% endfor %}
                          </ul>
                        </div>
                        {%- if mobile == false and link_title_sanitised == 'shades' and cz_child_link_title_sanitised contains 'handwoven' -%}
                          <div class="cz-shades__roller-independent">
                            <span class="navigation__column-title">Shades</span>
                            {%- for cz_shade_group in link.links -%}
                              {%- assign cz_shade_group_title_sanitised = cz_shade_group.title | downcase | strip -%}
                              {%- if cz_shade_group_title_sanitised == 'shades' -%}
                                {%- for cz_roller_link in cz_shade_group.links -%}
                                  {%- assign cz_roller_title_sanitised = cz_roller_link.title | downcase | strip -%}
                                  {%- if cz_roller_title_sanitised contains 'roller shade' -%}
                                    <a class="navigation__link" href="{{ cz_roller_link.url }}">
                                      {{- cz_roller_link.title | escape -}}
                                    </a>
                                  {%- endif -%}
                                {%- endfor -%}
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        {%- endif -%}
                      {% endif %}
                    </li>
                  {% endfor %}
                {% endif %}

                {% # theme-check-disable LiquidTag %}
                {%- if small_promo_count > 0 -%}
                  {% # theme-check-enable LiquidTag %}
                  {%- if mobile == false -%}
                    {%- for block in section.blocks -%}
                      {%- assign dropdown_link_title_sanitised = block.settings.dropdown_link_title | downcase | strip -%}
                      {%- if dropdown_link_title_sanitised == link_title_sanitised and block.type == 'menu-promotion-small' -%}
                        <li class="desktop-only navigation__column navigation__column--promotion" {{ block.shopify_attributes }}>
                          {%- assign cz_promo_link = block.settings.link_url | default: link.url -%}
                          {%- if link_title_sanitised == 'gallery' -%}
                            {%- assign cz_gallery_image_url = 'https://cdn.shopify.com/s/files/1/0862/2506/0158/files/gallery-roman-shades-living-room.jpg?v=1786506661' -%}
                          {%- else -%}
                            {%- assign cz_promo_image = block.settings.image -%}
                          {%- endif -%}
                          <div class="menu-promotion">
                            <a class="menu-promotion__link cz-mega__promotion" href="{{ cz_promo_link }}">
                              <span class="cz-mega__promotion-eyebrow cz-mega__promotion-column-heading">
                                {%- if link_title_sanitised == 'support' -%}
                                  <span class="cz-support__zoom-word">Zoom</span> Consultation
                                {%- elsif link_title_sanitised == 'gallery' -%}
                                  Image Gallery
                                {%- else -%}
                                  Featured
                                {%- endif -%}
                              </span>
                              <div class="menu-promotion__image">
                                {%- if link_title_sanitised == 'gallery' -%}
                                  <img
                                    src="{{ cz_gallery_image_url }}"
                                    alt="Cozy living room with coordinated Roman shades across multiple windows"
                                    width="3840"
                                    height="2160"
                                    loading="eager"
                                  >
                                {%- else -%}
                                  {%- render 'image' with cz_promo_image, size_cols_desktop: 4, loading: 'manual' -%}
                                {%- endif -%}
                              </div>
                              <div class="cz-mega__promotion-meta">
                                <span class="cz-mega__promotion-title">
                                  {%- if link_title_sanitised == 'support' -%}
                                    <span class="cz-support__zoom-label"><span class="cz-support__zoom-word">Zoom</span> Consultation</span>
                                    <span class="cz-support__complimentary-tag">Complimentary</span>
                                  {%- elsif block.settings.title != blank -%}
                                    {{ block.settings.title | escape }}
                                  {%- else -%}
                                    {{ link.title | escape }}
                                  {%- endif -%}
                                </span>
                                <span class="cz-mega__promotion-cta">
                                  {%- if link_title_sanitised == 'support' -%}Book a consultation&nbsp; →{%- else -%}Explore collection&nbsp; →{%- endif -%}
                                </span>
                              </div>
                            </a>
                          </div>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- else -%}
                    <li class="navigation__column navigation__column--promotion{% if section.settings.enable_mobile_promo_carousel and link.links.size > 0 %} navigation__column--promotion-carousel{% endif %}">
                      {%- for block in section.blocks -%}
                        {%- assign dropdown_link_title_sanitised = block.settings.dropdown_link_title | downcase | strip -%}
                        {%- if dropdown_link_title_sanitised == link_title_sanitised and block.type == 'menu-promotion-small' -%}
                          <div class="menu-promotion">
                            {%- if block.settings.link_url != blank -%}
                              <a class="menu-promotion__link" href="{{ block.settings.link_url }}">
                            {%- endif -%}
                            <div class="menu-promotion__image">
                              {%- render 'image' with block.settings.image, size_cols_desktop: 4, loading: 'manual' -%}
                            </div>
                            {%- if block.settings.title != blank -%}
                              <div class="menu-promotion__text">{{ block.settings.title | escape }}</div>
                            {%- endif -%}
                            {%- if block.settings.link_url != blank -%}
                              </a>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </li>
                  {%- endif -%}
                {%- endif -%}
                {%- if mobile == false and link_title_sanitised == 'gallery' -%}
                  {%- assign cz_gallery_video_title = 'Home Decor Inspiration' -%}
                  {%- assign cz_gallery_video_url = link.url -%}
                  {%- for child_link in link.links -%}
                    {%- assign cz_gallery_child_title = child_link.title | downcase | strip -%}
                    {%- if cz_gallery_child_title contains 'video' or cz_gallery_child_title contains 'home decor inspiration' -%}
                      {%- assign cz_gallery_video_title = child_link.title -%}
                      {%- assign cz_gallery_video_url = child_link.url -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <li class="desktop-only navigation__column cz-gallery__video-card">
                    <a class="cz-gallery__card-link" href="{{ cz_gallery_video_url }}">
                      <span class="cz-mega__promotion-eyebrow cz-mega__promotion-column-heading">Video</span>
                      <span class="cz-gallery__media">
                        <video autoplay loop muted playsinline preload="metadata" poster="https://cdn.shopify.com/s/files/1/0862/2506/0158/files/preview_images/849e3c39101f4f97874dd78dc7ca9921.thumbnail.0000000000.jpg?v=1746491636" aria-label="Cozyology home decor inspiration video">
                          <source src="https://cdn.shopify.com/videos/c/vp/849e3c39101f4f97874dd78dc7ca9921/849e3c39101f4f97874dd78dc7ca9921.SD-480p-1.5Mbps-47062086.mp4" type="video/mp4">
                        </video>
                        <span class="cz-gallery__play" aria-hidden="true">▶</span>
                      </span>
                      <span class="cz-gallery__meta">
                        <span class="cz-gallery__title">{{ cz_gallery_video_title | escape }}</span>
                        <span class="cz-gallery__cta">Watch videos&nbsp; →</span>
                      </span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if mobile == false and link_title_sanitised == 'new & all' -%}
                  {%- assign cz_best_sellers_collection = collections['best-sellers'] -%}
                  {%- assign cz_best_sellers_image = cz_best_sellers_collection.image | default: cz_best_sellers_collection.products.first.featured_image -%}
                  {%- if cz_best_sellers_collection != blank and cz_best_sellers_image != blank -%}
                    <li class="desktop-only navigation__column cz-mega__collection-card">
                      <span class="cz-mega__collection-heading">Best Sellers</span>
                      <a class="cz-mega__collection-link" href="{{ cz_best_sellers_collection.url }}" aria-label="{{ cz_best_sellers_collection.title | escape }}">
                        <div class="cz-mega__collection-image">
                          {%- render 'image' with cz_best_sellers_image, size_cols_desktop: 4, loading: 'manual' -%}
                        </div>
                        <span class="cz-mega__collection-title">
                          <span>{{ cz_best_sellers_collection.title | escape }}</span>
                          <span class="cz-mega__collection-arrow" aria-hidden="true">›</span>
                        </span>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- assign cz_designer_collection = collections['designer-series-drapery'] -%}
                  {%- assign cz_designer_image = cz_designer_collection.image | default: cz_designer_collection.products.first.featured_image -%}
                  {%- if cz_designer_collection != blank and cz_designer_image != blank -%}
                    <li class="desktop-only navigation__column cz-mega__collection-card">
                      <span class="cz-mega__collection-heading">Designer Series</span>
                      <a class="cz-mega__collection-link" href="{{ cz_designer_collection.url }}" aria-label="{{ cz_designer_collection.title | escape }}">
