{%- capture all_variants_label_html -%}
  {%- if product.metafields.theme.label != blank -%}
    <span class="product-label product-label--meta">
      <span>{{ product.metafields.theme.label | escape }}</span>
    </span>
  {%- endif -%}

  {%- liquid
    if settings.prod_new_show
      if settings.prod_new_method == 'date'
        assign now_s = 'now' | date: '%s' | plus: 0
        assign pub_s = product.created_at | date: '%s' | plus: 0
        assign diff_days = now_s | minus: pub_s | divided_by: 86400

        if diff_days < settings.prod_new_limit_int
          assign new_label_text = 'products.product.new' | t
        endif
      elsif settings.prod_new_method == 'tag'
          if product.tags contains 'blackout'
            assign new_label_text = 'products.product.blackout' | t
          elsif product.tags contains 'Complimentary Consultation'
            assign new_label_text = 'products.product.Complimentary_Consultation' | t
          elsif product.tags contains 'Triple-Layer'
            assign new_label_text = 'products.product.Triple-Layer' | t
          elsif product.tags contains 'Length Adjustable'
            assign new_label_text = 'products.product.Length_Adjustable' | t
          elsif product.tags contains 'Custom Size'
            assign new_label_text = 'products.product.Custom_Size' | t
          elsif product.tags contains 'No-Drill'
            assign new_label_text = 'products.product.No-Drill' | t
          elsif product.tags contains 'Extra-Long-Heavy-Duty'
            assign new_label_text = 'products.product.Extra-Long-Heavy-Duty' | t
          elsif product.tags contains 'Angle'
            assign new_label_text = 'products.product.Angle' | t
          elsif product.tags contains 'Traverse'
            assign new_label_text = 'products.product.Traverse' | t
          elsif product.tags contains 'Overlap carriers for blackout'
            assign new_label_text = 'products.product.Overlap_carriers_for_blackout' | t
          elsif product.tags contains 'New' or product.tags contains 'new'
            assign new_label_text = 'products.product.new' | t
          elsif product.tags contains 'Best sellers' or product.tags contains 'best sellers'
            assign new_label_text = 'products.product.best_sellers' | t
          elsif product.tags contains '25off'
            assign new_label_text = 'products.product.25off' | t
          elsif product.tags contains '23off'
            assign new_label_text = 'products.product.23off' | t
          elsif product.tags contains '22off'
            assign new_label_text = 'products.product.22off' | t
          elsif product.tags contains 'Ripple-only'
            assign new_label_text = 'products.product.Ripple-only' | t
          endif
      else
        for collection in product.collections
          assign split_collection_handle = collection.handle | split: '-'
          if split_collection_handle contains 'new'
            assign new_label_text = 'products.product.new' | t
            break
          endif
        endfor
      endif

      if settings.prod_new_method == 'tag'
        assign tag2_last = ''
        for tag in product.tags
          assign tag_lower = tag | downcase
          assign first5 = tag_lower | slice: 0, 5
          if first5 == 'tag2 '
            assign tag2_last = tag
          endif
        endfor
        if tag2_last != ''
          assign new_label_text_2 = tag2_last | remove_first: 'tag2 ' | strip
        endif
      endif
    endif
  -%}
  {%- if new_label_text -%}
    <span class="product-label product-label--new-in">
      <span>{{ new_label_text }}</span>
    </span>
  {%- endif -%}
  {%- if new_label_text_2 -%}
    <span class="product-label product-label--new-in">
      <span class="product-label_span_2">{{ new_label_text_2 }}</span>
    </span>
  {%- endif -%}
{%- endcapture -%}

<variant-content class="product-label-list">
  {%- for variant in product.variants -%}
    <script type="text/template" data-variant="{{ variant.id }}">
      {%- capture label_html -%}
        {{- all_variants_label_html -}}

        {%- liquid
          assign sale_label_text = false
          if settings.prod_reduction_show and variant.compare_at_price > variant.price
            if settings.prod_reduction_type == 'percent'
              assign amount = 1.0 | times: variant.price | divided_by: variant.compare_at_price
              assign amount = 1.0 | minus: amount
              assign amount = amount | times: 100.0 | round
              assign sale_label_text = 'products.product.percent_reduction' | t: amount: amount
            else
              assign amount = variant.compare_at_price | minus: variant.price | money
              assign sale_label_text = 'products.product.value_reduction_html' | t: amount: amount
            endif
          endif
        -%}
        {%- if sale_label_text -%}
          <span class="product-label product-label--sale">
            <span>{{ sale_label_text }}</span>
          </span>
        {%- endif -%}
      {%- endcapture -%}

      {%- if label_html != blank -%}
        <div class="product-label-container">
          {{- label_html -}}
        </div>
      {%- endif -%}
    </script>

    {%- if current_variant == false -%}
      {%- if all_variants_label_html != blank -%}
        <script type="text/template" data-variant="">
          <div class="product-label-container">
            {{- all_variants_label_html -}}
          </div>
        </script>
        <div class="product-label-container">
          {{- all_variants_label_html -}}
        </div>
      {%- endif -%}
    {%- elsif variant.id == current_variant.id and label_html -%}
      <div class="product-label-container no-js-hidden">
        {{- label_html -}}
      </div>
      <div class="product-label-container js-hidden">
        {{- all_variants_label_html -}}
      </div>
    {%- endif -%}
  {%- endfor -%}
</variant-content>
